/**
 * Custom Native-TND AscendC + CATLASS Chunk KDA (Kimi Delta Attention) Forward & Backward
 * for Ascend 910C (dav-2201 / AtlasA2).
 *
 * Eliminates the ~70% pipeline bubble in upstream `fla_npu` (`ChunkFwdH`, `ChunkKdaBwdFinalize`,
 * `ChunkKdaFwdPrepare`), fuses exact FP32 Q/K L2Norm (no collinear-key NaN bug), eliminates all
 * `TND <-> NTD` transposes, keeps recurrent state `h` & `dh` 100% UB-resident, pins reused
 * Cube operands in L1, and uses non-positive anchored exponents (`<= 0`) throughout.
 *
 * Supported geometry: `head_dim = 128`, `chunk_size = 64`, `sub_chunk = 16`, arbitrary `heads`,
 * arbitrary packed varlen `cu_seqlens`, native `[T, H, 128]` TND BF16 layout.
 */
#include "catlass/arch/arch.hpp"
#include "catlass/arch/cross_core_sync.hpp"
#include "catlass/arch/resource.hpp"
#include "catlass/catlass.hpp"
#include "catlass/detail/kernel_adapter.hpp"
#include "catlass/epilogue/tile/tile_copy.hpp"
#include "catlass/gemm/gemm_type.hpp"
#include "catlass/gemm/tile/tile_copy.hpp"
#include "catlass/gemm/tile/tile_mmad.hpp"
#include "catlass/layout/layout.hpp"
#include "ascend_kda_ops.h"

using namespace Catlass;

namespace {

constexpr uint32_t KDA_AIC_CORES = 24;
constexpr uint32_t KDA_AIV_CORES = 48;
constexpr uint32_t KDA_BT = 64;
constexpr uint32_t KDA_BC = 16;
constexpr uint32_t KDA_D = 128;

CATLASS_DEVICE uint32_t kda_align_up(uint32_t x, uint32_t a) {
    return (x + a - 1u) & ~(a - 1u);
}

// ===========================================================================
// Reusable L1-Pinned Cube Runner for [<=128, <=128] KDA chunk GEMMs
// ===========================================================================
struct KdaCubeRunner {
    using ArchTag = Arch::AtlasA2;
    static constexpr uint32_t STAGES = 2;
    static constexpr uint32_t L1_TILE_BYTES = 128 * 128 * sizeof(bfloat16_t);  // 32 KiB
    static constexpr uint32_t L0_HALF_BYTES = ArchTag::L0A_SIZE / STAGES;      // 32 KiB

    Arch::Resource<ArchTag>& res;
    AscendC::LocalTensor<bfloat16_t> l1A[STAGES];
    AscendC::LocalTensor<bfloat16_t> l1B[STAGES];
    AscendC::LocalTensor<bfloat16_t> l1Pin[4];  // 4x32 KiB L1 pin slots
    AscendC::LocalTensor<bfloat16_t> l0A[STAGES];
    AscendC::LocalTensor<bfloat16_t> l0B[STAGES];
    AscendC::LocalTensor<float> l0C[STAGES];
    AscendC::GlobalTensor<bfloat16_t> zero_gm;
    AscendC::GlobalTensor<float> zero_gm_f;
    AscendC::GlobalTensor<half> zero_gm_h;
    uint32_t l1Id{0};
    uint32_t l0AId{0};
    uint32_t l0BId{0};
    uint32_t l0CId{0};

    CATLASS_DEVICE KdaCubeRunner(Arch::Resource<ArchTag>& resource, uint64_t zero_ptr) : res(resource) {
        zero_gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(zero_ptr));
        zero_gm_f.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(zero_ptr));
        zero_gm_h.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(zero_ptr));
        for (uint32_t i = 0; i < STAGES; ++i) {
            l1A[i] = res.l1Buf.template GetBufferByByte<bfloat16_t>(i * L1_TILE_BYTES);
            l1B[i] = res.l1Buf.template GetBufferByByte<bfloat16_t>((STAGES + i) * L1_TILE_BYTES);
            l0A[i] = res.l0ABuf.template GetBufferByByte<bfloat16_t>(i * L0_HALF_BYTES);
            l0B[i] = res.l0BBuf.template GetBufferByByte<bfloat16_t>(i * L0_HALF_BYTES);
            AscendC::DataCopy(l1A[i], zero_gm, 128 * 128);
            AscendC::DataCopy(l1B[i], zero_gm, 128 * 128);
        }
        for (uint32_t p = 0; p < 4u; ++p) {
            l1Pin[p] = res.l1Buf.template GetBufferByByte<bfloat16_t>((2u * STAGES + p) * L1_TILE_BYTES);
            AscendC::DataCopy(l1Pin[p], zero_gm, 128 * 128);
        }
        AscendC::PipeBarrier<PIPE_MTE2>();
        for (uint32_t i = 0; i < STAGES; ++i) {
            AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(i);
            AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(i + STAGES);
            AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(i);
            AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(i + STAGES);
            l0C[i] = res.l0CBuf.template GetBufferByByte<float>(i * 65536u);
            AscendC::SetFlag<AscendC::HardEvent::FIX_M>(i);
        }
    }

    CATLASS_DEVICE ~KdaCubeRunner() {
        for (uint32_t i = 0; i < STAGES; ++i) {
            AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(i);
            AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(i + STAGES);
            AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(i);
            AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(i + STAGES);
            AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(i);
        }
    }

    template<bool TransA>
    CATLASS_DEVICE void pin_a(
        uint32_t slot, AscendC::GlobalTensor<bfloat16_t> const& gmA, uint32_t ldA,
        uint32_t m, uint32_t k) {
        using LayoutA = std::conditional_t<TransA, layout::ColumnMajor, layout::RowMajor>;
        using AType = Gemm::GemmType<bfloat16_t, LayoutA>;
        using BType = Gemm::GemmType<bfloat16_t, layout::RowMajor>;
        using CType = Gemm::GemmType<float, layout::RowMajor>;
        using TileCopy = Gemm::Tile::TileCopy<ArchTag, AType, BType, CType>;
        using LayoutAInL1 = typename TileCopy::CopyL1ToL0A::LayoutSrc;
        typename TileCopy::CopyGmToL1A copyGmToL1A;

        LayoutA layoutA(m, k, ldA);
        auto layoutAInL1 = LayoutAInL1::template MakeLayout<bfloat16_t>(128, 128);
        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID5);
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID5);
        if ((m & 15u) != 0u || (k & 15u) != 0u) {
            AscendC::DataCopy(l1Pin[slot], zero_gm, 128 * 128);
            AscendC::PipeBarrier<PIPE_MTE2>();
        }
        if (m > 0u && k > 0u) {
            copyGmToL1A(l1Pin[slot], gmA, layoutAInL1, layoutA.GetTileLayout(MakeCoord(m, k)));
        }
        AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID5);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID5);
    }

    template<bool TransB>
    CATLASS_DEVICE void pin_b(
        uint32_t slot, AscendC::GlobalTensor<bfloat16_t> const& gmB, uint32_t ldB,
        uint32_t k, uint32_t n) {
        using LayoutB = std::conditional_t<TransB, layout::ColumnMajor, layout::RowMajor>;
        using AType = Gemm::GemmType<bfloat16_t, layout::RowMajor>;
        using BType = Gemm::GemmType<bfloat16_t, LayoutB>;
        using CType = Gemm::GemmType<float, layout::RowMajor>;
        using TileCopy = Gemm::Tile::TileCopy<ArchTag, AType, BType, CType>;
        using LayoutBInL1 = typename TileCopy::CopyL1ToL0B::LayoutSrc;
        typename TileCopy::CopyGmToL1B copyGmToL1B;

        LayoutB layoutB(k, n, ldB);
        auto layoutBInL1 = LayoutBInL1::template MakeLayout<bfloat16_t>(128, 128);
        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID5);
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID5);
        if ((k & 15u) != 0u || (n & 15u) != 0u) {
            AscendC::DataCopy(l1Pin[slot], zero_gm, 128 * 128);
            AscendC::PipeBarrier<PIPE_MTE2>();
        }
        if (k > 0u && n > 0u) {
            copyGmToL1B(l1Pin[slot], gmB, layoutBInL1, layoutB.GetTileLayout(MakeCoord(k, n)));
        }
        AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID5);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID5);
    }

    // Core single-K-tile (k <= 128, m <= 128, n <= 128) GEMM supporting optional L1-pinned A/B and float/bf16 output.
    template<bool TransA, bool TransB, typename OutT = float, bool PinA = false, bool PinB = false>
    CATLASS_DEVICE void gemm_small(
        AscendC::GlobalTensor<bfloat16_t> const& gmA, uint32_t ldA, uint32_t pinSlotA,
        AscendC::GlobalTensor<bfloat16_t> const& gmB, uint32_t ldB, uint32_t pinSlotB,
        AscendC::GlobalTensor<OutT> const& gmC, uint32_t ldC,
        uint32_t m, uint32_t n, uint32_t k, uint32_t c_cols, bool accum_c = false) {
        if (m == 0u || n == 0u || k == 0u || c_cols == 0u) return;
        using LayoutA = std::conditional_t<TransA, layout::ColumnMajor, layout::RowMajor>;
        using LayoutB = std::conditional_t<TransB, layout::ColumnMajor, layout::RowMajor>;
        using AType = Gemm::GemmType<bfloat16_t, LayoutA>;
        using BType = Gemm::GemmType<bfloat16_t, LayoutB>;
        using CType = Gemm::GemmType<OutT, layout::RowMajor>;
        using TileCopy = Gemm::Tile::TileCopy<ArchTag, AType, BType, CType>;
        using TileMmad = Gemm::Tile::TileMmad<ArchTag, AType, BType, void>;
        using LayoutAInL1 = typename TileCopy::CopyL1ToL0A::LayoutSrc;
        using LayoutBInL1 = typename TileCopy::CopyL1ToL0B::LayoutSrc;
        using LayoutAInL0 = typename TileCopy::CopyL1ToL0A::LayoutDst;
        using LayoutBInL0 = typename TileCopy::CopyL1ToL0B::LayoutDst;

        typename TileCopy::CopyGmToL1A copyGmToL1A;
        typename TileCopy::CopyGmToL1B copyGmToL1B;
        typename TileCopy::CopyL1ToL0A copyL1ToL0A;
        typename TileCopy::CopyL1ToL0B copyL1ToL0B;
        typename TileCopy::CopyL0CToGm copyL0CToGm;
        TileMmad tileMmad;

        uint32_t mRound = kda_align_up(m, 16u);
        uint32_t nRound = kda_align_up(c_cols, 16u);
        auto layoutAInL1 = LayoutAInL1::template MakeLayout<bfloat16_t>(128, 128);
        auto layoutBInL1 = LayoutBInL1::template MakeLayout<bfloat16_t>(128, 128);
        auto layoutInL0C = layout::zN::MakeLayoutInL0C(MakeCoord(mRound, nRound));

        if constexpr (!PinA) {
            LayoutA layoutA(m, k, ldA);
            AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1Id);
            if (m < mRound || (k & 15u) != 0u) {
                AscendC::DataCopy(l1A[l1Id], zero_gm, 128 * 128);
                AscendC::PipeBarrier<PIPE_MTE2>();
            }
            copyGmToL1A(l1A[l1Id], gmA, layoutAInL1, layoutA.GetTileLayout(MakeCoord(m, k)));
            AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1Id);
        }
        if constexpr (!PinB) {
            LayoutB layoutB(k, n, ldB);
            AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1Id + STAGES);
            if (n < nRound || (k & 15u) != 0u) {
                AscendC::DataCopy(l1B[l1Id], zero_gm, 128 * 128);
                AscendC::PipeBarrier<PIPE_MTE2>();
            }
            copyGmToL1B(l1B[l1Id], gmB, layoutBInL1, layoutB.GetTileLayout(MakeCoord(k, n)));
            AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1Id + STAGES);
        }

        uint32_t cid = l0CId;
        auto& l0CTile = l0C[cid];
        AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cid);

        uint32_t kPartLoop = (k + 63u) / 64u;
        for (uint32_t kp = 0u; kp < kPartLoop; ++kp) {
            uint32_t kPartActual = (kp + 1u < kPartLoop) ? 64u : (k - kp * 64u);
            uint32_t kPartRound = kda_align_up(kPartActual, 16u);

            auto l0ATile = l0A[l0AId];
            auto layoutAInL0 = LayoutAInL0::template MakeLayout<bfloat16_t>(mRound, kPartRound);
            MatrixCoord l1AOff{0u, kp * 64u};
            AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0AId);
            if constexpr (PinA) {
                copyL1ToL0A(l0ATile, l1Pin[pinSlotA][layoutAInL1.GetOffset(l1AOff)], layoutAInL0, layoutAInL1);
            } else {
                if (kp == 0u) AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(l1Id);
                copyL1ToL0A(l0ATile, l1A[l1Id][layoutAInL1.GetOffset(l1AOff)], layoutAInL0, layoutAInL1);
                if (kp + 1u == kPartLoop) AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(l1Id);
            }

            auto l0BTile = l0B[l0BId];
            auto layoutBInL0 = LayoutBInL0::template MakeLayout<bfloat16_t>(kPartRound, nRound);
            MatrixCoord l1BOff{kp * 64u, 0u};
            AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0BId + STAGES);
            if constexpr (PinB) {
                copyL1ToL0B(l0BTile, l1Pin[pinSlotB][layoutBInL1.GetOffset(l1BOff)], layoutBInL0, layoutBInL1);
            } else {
                if (kp == 0u) AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(l1Id + STAGES);
                copyL1ToL0B(l0BTile, l1B[l1Id][layoutBInL1.GetOffset(l1BOff)], layoutBInL0, layoutBInL1);
                if (kp + 1u == kPartLoop) AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(l1Id + STAGES);
            }

            AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);

            tileMmad(l0CTile, l0ATile, l0BTile, mRound, nRound, kPartRound, kp == 0u, 0b00);

            AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0BId + STAGES);
            l0BId = (l0BId + 1u < STAGES) ? (l0BId + 1u) : 0u;
            AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0AId);
            l0AId = (l0AId + 1u < STAGES) ? (l0AId + 1u) : 0u;
        }
        if constexpr (!PinA || !PinB) {
            l1Id = (l1Id + 1u < STAGES) ? (l1Id + 1u) : 0u;
        }

        layout::RowMajor layoutC(m, c_cols, ldC);
        AscendC::SetFlag<AscendC::HardEvent::M_FIX>(cid);
        AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(cid);
        if constexpr (std::is_same_v<OutT, float>) {
            if (accum_c) {
                AscendC::SetAtomicAdd<float>();
                copyL0CToGm(gmC, l0CTile, layoutC, layoutInL0C);
                AscendC::SetAtomicNone();
            } else {
                copyL0CToGm(gmC, l0CTile, layoutC, layoutInL0C);
            }
        } else {
            copyL0CToGm(gmC, l0CTile, layoutC, layoutInL0C);
        }
        AscendC::SetFlag<AscendC::HardEvent::FIX_M>(cid);
        l0CId ^= 1u;
    }

    // Fused 2-term sum-of-GEMMs: gmC = gmA1 @ gmB1 + gmA2 @ gmB2 (k <= 64, m <= 128, n <= 128)
    // Accumulates both terms directly in L0C with double-buffered L1/L0 and ONE FixPipe drain (zero atomic add!).
    template<bool TransA, bool TransB, typename OutT = float>
    CATLASS_DEVICE void gemm_sum2(
        AscendC::GlobalTensor<bfloat16_t> const& gmA1, uint32_t ldA1,
        AscendC::GlobalTensor<bfloat16_t> const& gmB1, uint32_t ldB1,
        AscendC::GlobalTensor<bfloat16_t> const& gmA2, uint32_t ldA2,
        AscendC::GlobalTensor<bfloat16_t> const& gmB2, uint32_t ldB2,
        AscendC::GlobalTensor<OutT> const& gmC, uint32_t ldC,
        uint32_t m, uint32_t n, uint32_t k) {
        if (m == 0u || n == 0u || k == 0u) return;
        using LayoutA = std::conditional_t<TransA, layout::ColumnMajor, layout::RowMajor>;
        using LayoutB = std::conditional_t<TransB, layout::ColumnMajor, layout::RowMajor>;
        using AType = Gemm::GemmType<bfloat16_t, LayoutA>;
        using BType = Gemm::GemmType<bfloat16_t, LayoutB>;
        using CType = Gemm::GemmType<OutT, layout::RowMajor>;
        using TileCopy = Gemm::Tile::TileCopy<ArchTag, AType, BType, CType>;
        using TileMmad = Gemm::Tile::TileMmad<ArchTag, AType, BType, void>;
        using LayoutAInL1 = typename TileCopy::CopyL1ToL0A::LayoutSrc;
        using LayoutBInL1 = typename TileCopy::CopyL1ToL0B::LayoutSrc;
        using LayoutAInL0 = typename TileCopy::CopyL1ToL0A::LayoutDst;
        using LayoutBInL0 = typename TileCopy::CopyL1ToL0B::LayoutDst;

        typename TileCopy::CopyGmToL1A copyGmToL1A;
        typename TileCopy::CopyGmToL1B copyGmToL1B;
        typename TileCopy::CopyL1ToL0A copyL1ToL0A;
        typename TileCopy::CopyL1ToL0B copyL1ToL0B;
        typename TileCopy::CopyL0CToGm copyL0CToGm;
        TileMmad tileMmad;

        uint32_t mRound = kda_align_up(m, 16u);
        uint32_t nRound = kda_align_up(n, 16u);
        uint32_t kRound = kda_align_up(k, 16u);
        auto layoutAInL1 = LayoutAInL1::template MakeLayout<bfloat16_t>(128, 128);
        auto layoutBInL1 = LayoutBInL1::template MakeLayout<bfloat16_t>(128, 128);
        auto layoutAInL0 = LayoutAInL0::template MakeLayout<bfloat16_t>(mRound, kRound);
        auto layoutBInL0 = LayoutBInL0::template MakeLayout<bfloat16_t>(kRound, nRound);
        auto layoutInL0C = layout::zN::MakeLayoutInL0C(MakeCoord(mRound, nRound));

        uint32_t s0 = l1Id;
        uint32_t s1 = s0 ^ 1u;
        LayoutA layoutA1(m, k, ldA1), layoutA2(m, k, ldA2);
        LayoutB layoutB1(k, n, ldB1), layoutB2(k, n, ldB2);

        // Load Term 1 into L1[s0]
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(s0);
        if (m < mRound || (k & 15u) != 0u) {
            AscendC::DataCopy(l1A[s0], zero_gm, 128 * 128);
            AscendC::PipeBarrier<PIPE_MTE2>();
        }
        copyGmToL1A(l1A[s0], gmA1, layoutAInL1, layoutA1.GetTileLayout(MakeCoord(m, k)));
        AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(s0);

        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(s0 + STAGES);
        if (n < nRound || (k & 15u) != 0u) {
            AscendC::DataCopy(l1B[s0], zero_gm, 128 * 128);
            AscendC::PipeBarrier<PIPE_MTE2>();
        }
        copyGmToL1B(l1B[s0], gmB1, layoutBInL1, layoutB1.GetTileLayout(MakeCoord(k, n)));
        AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(s0 + STAGES);

        // Prefetch Term 2 into L1[s1] (overlaps with Term 1 MTE1/Cube!)
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(s1);
        if (m < mRound || (k & 15u) != 0u) {
            AscendC::DataCopy(l1A[s1], zero_gm, 128 * 128);
            AscendC::PipeBarrier<PIPE_MTE2>();
        }
        copyGmToL1A(l1A[s1], gmA2, layoutAInL1, layoutA2.GetTileLayout(MakeCoord(m, k)));
        AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(s1);

        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(s1 + STAGES);
        if (n < nRound || (k & 15u) != 0u) {
            AscendC::DataCopy(l1B[s1], zero_gm, 128 * 128);
            AscendC::PipeBarrier<PIPE_MTE2>();
        }
        copyGmToL1B(l1B[s1], gmB2, layoutBInL1, layoutB2.GetTileLayout(MakeCoord(k, n)));
        AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(s1 + STAGES);

        uint32_t cid = l0CId;
        auto& l0CTile = l0C[cid];
        AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cid);

        // Term 1 Cube MMAD (initC = true)
        {
            auto l0ATile = l0A[l0AId];
            auto l0BTile = l0B[l0BId];
            AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0AId);
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(s0);
            copyL1ToL0A(l0ATile, l1A[s0], layoutAInL0, layoutAInL1);
            AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(s0);

            AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0BId + STAGES);
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(s0 + STAGES);
            copyL1ToL0B(l0BTile, l1B[s0], layoutBInL0, layoutBInL1);
            AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(s0 + STAGES);

            AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
            tileMmad(l0CTile, l0ATile, l0BTile, mRound, nRound, kRound, true, 0b00);

            AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0BId + STAGES);
            l0BId ^= 1u;
            AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0AId);
            l0AId ^= 1u;
        }

        // Term 2 Cube MMAD (initC = false, accumulates into L0C!)
        {
            auto l0ATile = l0A[l0AId];
            auto l0BTile = l0B[l0BId];
            AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0AId);
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(s1);
            copyL1ToL0A(l0ATile, l1A[s1], layoutAInL0, layoutAInL1);
            AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(s1);

            AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0BId + STAGES);
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(s1 + STAGES);
            copyL1ToL0B(l0BTile, l1B[s1], layoutBInL0, layoutBInL1);
            AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(s1 + STAGES);

            AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
            tileMmad(l0CTile, l0ATile, l0BTile, mRound, nRound, kRound, false, 0b00);

            AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0BId + STAGES);
            l0BId ^= 1u;
            AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0AId);
            l0AId ^= 1u;
        }

        layout::RowMajor layoutC(m, n, ldC);
        AscendC::SetFlag<AscendC::HardEvent::M_FIX>(cid);
        AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(cid);
        copyL0CToGm(gmC, l0CTile, layoutC, layoutInL0C);
        AscendC::SetFlag<AscendC::HardEvent::FIX_M>(cid);
        l0CId ^= 1u;
    }

    // Native AtlasA2 FP32->HF32 Cube pin & GEMM helpers (mRound*kRound <= 8192, kRound*nRound <= 8192)
    // Uses 10-bit mantissa + 8-bit exponent (zero FP16 overflow, 8x sharper than BF16, zero AIV cast!).
    template<bool TransB>
    CATLASS_DEVICE void pin_b_f32(
        uint32_t slot, AscendC::GlobalTensor<float> const& gmB, uint32_t ldB,
        uint32_t k, uint32_t n) {
        using LayoutB = std::conditional_t<TransB, layout::ColumnMajor, layout::RowMajor>;
        using AType = Gemm::GemmType<float, layout::RowMajor>;
        using BType = Gemm::GemmType<float, LayoutB>;
        using CType = Gemm::GemmType<float, layout::RowMajor>;
        using TileCopy = Gemm::Tile::TileCopy<ArchTag, AType, BType, CType>;
        using LayoutBInL1 = typename TileCopy::CopyL1ToL0B::LayoutSrc;
        typename TileCopy::CopyGmToL1B copyGmToL1B;

        uint32_t kRound = kda_align_up(k, 16u);
        uint32_t nRound = kda_align_up(n, 16u);
        LayoutB layoutB(k, n, ldB);
        auto layoutBInL1 = LayoutBInL1::template MakeLayout<float>(kRound, nRound);
        auto dst_f = l1Pin[slot].ReinterpretCast<float>();
        auto& zero_f = zero_gm_f;
        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID5);
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID5);
        if (k < kRound || n < nRound) {
            AscendC::DataCopy(dst_f, zero_f, kRound * nRound);
            AscendC::PipeBarrier<PIPE_MTE2>();
        }
        if (k > 0u && n > 0u) {
            copyGmToL1B(dst_f, gmB, layoutBInL1, layoutB.GetTileLayout(MakeCoord(k, n)));
        }
        AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID5);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID5);
    }

    template<bool TransA, bool TransB, typename OutT = float, bool PinB = false>
    CATLASS_DEVICE void gemm_f32(
        AscendC::GlobalTensor<float> const& gmA, uint32_t ldA,
        AscendC::GlobalTensor<float> const& gmB, uint32_t ldB, uint32_t pinSlotB,
        AscendC::GlobalTensor<OutT> const& gmC, uint32_t ldC,
        uint32_t m, uint32_t n, uint32_t k) {
        if (m == 0u || n == 0u || k == 0u) return;
        using LayoutA = std::conditional_t<TransA, layout::ColumnMajor, layout::RowMajor>;
        using LayoutB = std::conditional_t<TransB, layout::ColumnMajor, layout::RowMajor>;
        using AType = Gemm::GemmType<float, LayoutA>;
        using BType = Gemm::GemmType<float, LayoutB>;
        using CType = Gemm::GemmType<OutT, layout::RowMajor>;
        using TileCopy = Gemm::Tile::TileCopy<ArchTag, AType, BType, CType>;
        using TileMmad = Gemm::Tile::TileMmad<ArchTag, AType, BType, void>;
        using LayoutAInL1 = typename TileCopy::CopyL1ToL0A::LayoutSrc;
        using LayoutBInL1 = typename TileCopy::CopyL1ToL0B::LayoutSrc;
        using LayoutAInL0 = typename TileCopy::CopyL1ToL0A::LayoutDst;
        using LayoutBInL0 = typename TileCopy::CopyL1ToL0B::LayoutDst;

        typename TileCopy::CopyGmToL1A copyGmToL1A;
        typename TileCopy::CopyGmToL1B copyGmToL1B;
        typename TileCopy::CopyL1ToL0A copyL1ToL0A;
        typename TileCopy::CopyL1ToL0B copyL1ToL0B;
        typename TileCopy::CopyL0CToGm copyL0CToGm;
        TileMmad tileMmad;

        uint32_t mRound = kda_align_up(m, 16u);
        uint32_t nRound = kda_align_up(n, 16u);
        uint32_t kRound = kda_align_up(k, 16u);
        auto layoutAInL1 = LayoutAInL1::template MakeLayout<float>(mRound, kRound);
        auto layoutBInL1 = LayoutBInL1::template MakeLayout<float>(kRound, nRound);
        auto layoutAInL0 = LayoutAInL0::template MakeLayout<float>(mRound, kRound);
        auto layoutBInL0 = LayoutBInL0::template MakeLayout<float>(kRound, nRound);
        auto layoutInL0C = layout::zN::MakeLayoutInL0C(MakeCoord(mRound, nRound));

        auto& zero_f = zero_gm_f;
        auto l1A_f = l1A[l1Id].ReinterpretCast<float>();
        auto l1B_f = l1B[l1Id].ReinterpretCast<float>();
        auto l0A_f = l0A[l0AId].ReinterpretCast<float>();
        auto l0B_f = l0B[l0BId].ReinterpretCast<float>();

        LayoutA layoutA(m, k, ldA);
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1Id);
        if (m < mRound || k < kRound) {
            AscendC::DataCopy(l1A_f, zero_f, mRound * kRound);
            AscendC::PipeBarrier<PIPE_MTE2>();
        }
        copyGmToL1A(l1A_f, gmA, layoutAInL1, layoutA.GetTileLayout(MakeCoord(m, k)));
        AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1Id);

        if constexpr (!PinB) {
            LayoutB layoutB(k, n, ldB);
            AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1Id + STAGES);
            if (n < nRound || k < kRound) {
                AscendC::DataCopy(l1B_f, zero_f, kRound * nRound);
                AscendC::PipeBarrier<PIPE_MTE2>();
            }
            copyGmToL1B(l1B_f, gmB, layoutBInL1, layoutB.GetTileLayout(MakeCoord(k, n)));
            AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1Id + STAGES);
        }

        uint32_t cid = l0CId;
        auto& l0CTile = l0C[cid];
        AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cid);

        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0AId);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(l1Id);
        copyL1ToL0A(l0A_f, l1A_f, layoutAInL0, layoutAInL1);
        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(l1Id);

        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0BId + STAGES);
        if constexpr (PinB) {
            auto l1BPin_f = l1Pin[pinSlotB].ReinterpretCast<float>();
            copyL1ToL0B(l0B_f, l1BPin_f, layoutBInL0, layoutBInL1);
        } else {
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(l1Id + STAGES);
            copyL1ToL0B(l0B_f, l1B_f, layoutBInL0, layoutBInL1);
            AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(l1Id + STAGES);
        }

        AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
        tileMmad(l0CTile, l0A_f, l0B_f, mRound, nRound, kRound, true, 0b00);

        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0BId + STAGES);
        l0BId ^= 1u;
        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0AId);
        l0AId ^= 1u;
        l1Id ^= 1u;

        layout::RowMajor layoutC(m, n, ldC);
        AscendC::SetFlag<AscendC::HardEvent::M_FIX>(cid);
        AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(cid);
        copyL0CToGm(gmC, l0CTile, layoutC, layoutInL0C);
        AscendC::SetFlag<AscendC::HardEvent::FIX_M>(cid);
        l0CId ^= 1u;
    }

    // HF32 GEMM with dual FixPipe drain (float -> gmC_f32 AND bfloat16_t -> gmC_bf16 from SAME L0C!)
    template<bool TransA, bool TransB>
    CATLASS_DEVICE void gemm_f32_dual(
        AscendC::GlobalTensor<float> const& gmA, uint32_t ldA,
        AscendC::GlobalTensor<float> const& gmB, uint32_t ldB,
        AscendC::GlobalTensor<float> const& gmC_f32, uint32_t ldCf,
        AscendC::GlobalTensor<bfloat16_t> const& gmC_bf16, uint32_t ldCb,
        uint32_t m, uint32_t n, uint32_t k) {
        if (m == 0u || n == 0u || k == 0u) return;
        using LayoutA = std::conditional_t<TransA, layout::ColumnMajor, layout::RowMajor>;
        using LayoutB = std::conditional_t<TransB, layout::ColumnMajor, layout::RowMajor>;
        using AType = Gemm::GemmType<float, LayoutA>;
        using BType = Gemm::GemmType<float, LayoutB>;
        using CTypeF = Gemm::GemmType<float, layout::RowMajor>;
        using CTypeB = Gemm::GemmType<bfloat16_t, layout::RowMajor>;
        using TileCopyF = Gemm::Tile::TileCopy<ArchTag, AType, BType, CTypeF>;
        using TileCopyB = Gemm::Tile::TileCopy<ArchTag, AType, BType, CTypeB>;
        using TileMmad = Gemm::Tile::TileMmad<ArchTag, AType, BType, void>;
        using LayoutAInL1 = typename TileCopyF::CopyL1ToL0A::LayoutSrc;
        using LayoutBInL1 = typename TileCopyF::CopyL1ToL0B::LayoutSrc;
        using LayoutAInL0 = typename TileCopyF::CopyL1ToL0A::LayoutDst;
        using LayoutBInL0 = typename TileCopyF::CopyL1ToL0B::LayoutDst;

        typename TileCopyF::CopyGmToL1A copyGmToL1A;
        typename TileCopyF::CopyGmToL1B copyGmToL1B;
        typename TileCopyF::CopyL1ToL0A copyL1ToL0A;
        typename TileCopyF::CopyL1ToL0B copyL1ToL0B;
        typename TileCopyF::CopyL0CToGm copyL0CToGmF;
        typename TileCopyB::CopyL0CToGm copyL0CToGmB;
        TileMmad tileMmad;

        uint32_t mRound = kda_align_up(m, 16u);
        uint32_t nRound = kda_align_up(n, 16u);
        uint32_t kRound = kda_align_up(k, 16u);
        auto layoutAInL1 = LayoutAInL1::template MakeLayout<float>(mRound, kRound);
        auto layoutBInL1 = LayoutBInL1::template MakeLayout<float>(kRound, nRound);
        auto layoutAInL0 = LayoutAInL0::template MakeLayout<float>(mRound, kRound);
        auto layoutBInL0 = LayoutBInL0::template MakeLayout<float>(kRound, nRound);
        auto layoutInL0C = layout::zN::MakeLayoutInL0C(MakeCoord(mRound, nRound));

        auto& zero_f = zero_gm_f;
        auto l1A_f = l1A[l1Id].ReinterpretCast<float>();
        auto l1B_f = l1B[l1Id].ReinterpretCast<float>();
        auto l0A_f = l0A[l0AId].ReinterpretCast<float>();
        auto l0B_f = l0B[l0BId].ReinterpretCast<float>();

        LayoutA layoutA(m, k, ldA);
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1Id);
        if (m < mRound || k < kRound) {
            AscendC::DataCopy(l1A_f, zero_f, mRound * kRound);
            AscendC::PipeBarrier<PIPE_MTE2>();
        }
        copyGmToL1A(l1A_f, gmA, layoutAInL1, layoutA.GetTileLayout(MakeCoord(m, k)));
        AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1Id);

        LayoutB layoutB(k, n, ldB);
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1Id + STAGES);
        if (n < nRound || k < kRound) {
            AscendC::DataCopy(l1B_f, zero_f, kRound * nRound);
            AscendC::PipeBarrier<PIPE_MTE2>();
        }
        copyGmToL1B(l1B_f, gmB, layoutBInL1, layoutB.GetTileLayout(MakeCoord(k, n)));
        AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1Id + STAGES);

        uint32_t cid = l0CId;
        auto& l0CTile = l0C[cid];
        AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cid);

        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0AId);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(l1Id);
        copyL1ToL0A(l0A_f, l1A_f, layoutAInL0, layoutAInL1);
        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(l1Id);

        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0BId + STAGES);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(l1Id + STAGES);
        copyL1ToL0B(l0B_f, l1B_f, layoutBInL0, layoutBInL1);
        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(l1Id + STAGES);

        AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
        tileMmad(l0CTile, l0A_f, l0B_f, mRound, nRound, kRound, true, 0b00);

        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0BId + STAGES);
        l0BId ^= 1u;
        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0AId);
        l0AId ^= 1u;
        l1Id ^= 1u;

        layout::RowMajor layoutCf(m, n, ldCf);
        layout::RowMajor layoutCb(m, n, ldCb);
        AscendC::SetFlag<AscendC::HardEvent::M_FIX>(cid);
        AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(cid);
        copyL0CToGmF(gmC_f32, l0CTile, layoutCf, layoutInL0C);
        copyL0CToGmB(gmC_bf16, l0CTile, layoutCb, layoutInL0C);
        AscendC::SetFlag<AscendC::HardEvent::FIX_M>(cid);
        l0CId ^= 1u;
    }

    // Fused 2-term HF32 sum-of-GEMMs: gmC = gmA1 @ gmB1 + gmA2 @ gmB2 (L0C accum, zero atomic add!)
    template<bool TransA, bool TransB, typename OutT = float>
    CATLASS_DEVICE void gemm_f32_sum2(
        AscendC::GlobalTensor<float> const& gmA1, uint32_t ldA1,
        AscendC::GlobalTensor<float> const& gmB1, uint32_t ldB1,
        AscendC::GlobalTensor<float> const& gmA2, uint32_t ldA2,
        AscendC::GlobalTensor<float> const& gmB2, uint32_t ldB2,
        AscendC::GlobalTensor<OutT> const& gmC, uint32_t ldC,
        uint32_t m, uint32_t n, uint32_t k) {
        if (m == 0u || n == 0u || k == 0u) return;
        using LayoutA = std::conditional_t<TransA, layout::ColumnMajor, layout::RowMajor>;
        using LayoutB = std::conditional_t<TransB, layout::ColumnMajor, layout::RowMajor>;
        using AType = Gemm::GemmType<float, LayoutA>;
        using BType = Gemm::GemmType<float, LayoutB>;
        using CType = Gemm::GemmType<OutT, layout::RowMajor>;
        using TileCopy = Gemm::Tile::TileCopy<ArchTag, AType, BType, CType>;
        using TileMmad = Gemm::Tile::TileMmad<ArchTag, AType, BType, void>;
        using LayoutAInL1 = typename TileCopy::CopyL1ToL0A::LayoutSrc;
        using LayoutBInL1 = typename TileCopy::CopyL1ToL0B::LayoutSrc;
        using LayoutAInL0 = typename TileCopy::CopyL1ToL0A::LayoutDst;
        using LayoutBInL0 = typename TileCopy::CopyL1ToL0B::LayoutDst;

        typename TileCopy::CopyGmToL1A copyGmToL1A;
        typename TileCopy::CopyGmToL1B copyGmToL1B;
        typename TileCopy::CopyL1ToL0A copyL1ToL0A;
        typename TileCopy::CopyL1ToL0B copyL1ToL0B;
        typename TileCopy::CopyL0CToGm copyL0CToGm;
        TileMmad tileMmad;

        uint32_t mRound = kda_align_up(m, 16u);
        uint32_t nRound = kda_align_up(n, 16u);
        uint32_t kRound = kda_align_up(k, 16u);
        auto layoutAInL1 = LayoutAInL1::template MakeLayout<float>(mRound, kRound);
        auto layoutBInL1 = LayoutBInL1::template MakeLayout<float>(kRound, nRound);
        auto layoutAInL0 = LayoutAInL0::template MakeLayout<float>(mRound, kRound);
        auto layoutBInL0 = LayoutBInL0::template MakeLayout<float>(kRound, nRound);
        auto layoutInL0C = layout::zN::MakeLayoutInL0C(MakeCoord(mRound, nRound));

        uint32_t s0 = l1Id;
        uint32_t s1 = s0 ^ 1u;
        auto& zero_f = zero_gm_f;
        auto l1A0 = l1A[s0].ReinterpretCast<float>();
        auto l1B0 = l1B[s0].ReinterpretCast<float>();
        auto l1A1 = l1A[s1].ReinterpretCast<float>();
        auto l1B1 = l1B[s1].ReinterpretCast<float>();

        LayoutA layoutA1(m, k, ldA1), layoutA2(m, k, ldA2);
        LayoutB layoutB1(k, n, ldB1), layoutB2(k, n, ldB2);

        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(s0);
        if (m < mRound || k < kRound) { AscendC::DataCopy(l1A0, zero_f, mRound * kRound); AscendC::PipeBarrier<PIPE_MTE2>(); }
        copyGmToL1A(l1A0, gmA1, layoutAInL1, layoutA1.GetTileLayout(MakeCoord(m, k)));
        AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(s0);

        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(s0 + STAGES);
        if (n < nRound || k < kRound) { AscendC::DataCopy(l1B0, zero_f, kRound * nRound); AscendC::PipeBarrier<PIPE_MTE2>(); }
        copyGmToL1B(l1B0, gmB1, layoutBInL1, layoutB1.GetTileLayout(MakeCoord(k, n)));
        AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(s0 + STAGES);

        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(s1);
        if (m < mRound || k < kRound) { AscendC::DataCopy(l1A1, zero_f, mRound * kRound); AscendC::PipeBarrier<PIPE_MTE2>(); }
        copyGmToL1A(l1A1, gmA2, layoutAInL1, layoutA2.GetTileLayout(MakeCoord(m, k)));
        AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(s1);

        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(s1 + STAGES);
        if (n < nRound || k < kRound) { AscendC::DataCopy(l1B1, zero_f, kRound * nRound); AscendC::PipeBarrier<PIPE_MTE2>(); }
        copyGmToL1B(l1B1, gmB2, layoutBInL1, layoutB2.GetTileLayout(MakeCoord(k, n)));
        AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(s1 + STAGES);

        uint32_t cid = l0CId;
        auto& l0CTile = l0C[cid];
        AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cid);

        // Term 1 (initC = true)
        {
            auto l0Af = l0A[l0AId].ReinterpretCast<float>();
            auto l0Bf = l0B[l0BId].ReinterpretCast<float>();
            AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0AId);
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(s0);
            copyL1ToL0A(l0Af, l1A0, layoutAInL0, layoutAInL1);
            AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(s0);

            AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0BId + STAGES);
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(s0 + STAGES);
            copyL1ToL0B(l0Bf, l1B0, layoutBInL0, layoutBInL1);
            AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(s0 + STAGES);

            AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
            tileMmad(l0CTile, l0Af, l0Bf, mRound, nRound, kRound, true, 0b00);

            AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0BId + STAGES);
            l0BId ^= 1u;
            AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0AId);
            l0AId ^= 1u;
        }
        // Term 2 (initC = false, accumulates into L0C!)
        {
            auto l0Af = l0A[l0AId].ReinterpretCast<float>();
            auto l0Bf = l0B[l0BId].ReinterpretCast<float>();
            AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0AId);
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(s1);
            copyL1ToL0A(l0Af, l1A1, layoutAInL0, layoutAInL1);
            AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(s1);

            AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0BId + STAGES);
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(s1 + STAGES);
            copyL1ToL0B(l0Bf, l1B1, layoutBInL0, layoutBInL1);
            AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(s1 + STAGES);

            AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
            tileMmad(l0CTile, l0Af, l0Bf, mRound, nRound, kRound, false, 0b00);

            AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0BId + STAGES);
            l0BId ^= 1u;
            AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0AId);
            l0AId ^= 1u;
        }

        layout::RowMajor layoutC(m, n, ldC);
        AscendC::SetFlag<AscendC::HardEvent::M_FIX>(cid);
        AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(cid);
        copyL0CToGm(gmC, l0CTile, layoutC, layoutInL0C);
        AscendC::SetFlag<AscendC::HardEvent::FIX_M>(cid);
        l0CId ^= 1u;
    }

    // Native AtlasA2 FP16 (half) single-K-tile GEMM (2x Cube speed vs HF32, 10-bit mantissa, 50% MTE2 bytes!)
    template<bool TransA, bool TransB, typename OutT = float>
    CATLASS_DEVICE void gemm_f16(
        AscendC::GlobalTensor<half> const& gmA, uint32_t ldA,
        AscendC::GlobalTensor<half> const& gmB, uint32_t ldB,
        AscendC::GlobalTensor<OutT> const& gmC, uint32_t ldC,
        uint32_t m, uint32_t n, uint32_t k) {
        if (m == 0u || n == 0u || k == 0u) return;
        using LayoutA = std::conditional_t<TransA, layout::ColumnMajor, layout::RowMajor>;
        using LayoutB = std::conditional_t<TransB, layout::ColumnMajor, layout::RowMajor>;
        using AType = Gemm::GemmType<half, LayoutA>;
        using BType = Gemm::GemmType<half, LayoutB>;
        using CType = Gemm::GemmType<OutT, layout::RowMajor>;
        using TileCopy = Gemm::Tile::TileCopy<ArchTag, AType, BType, CType>;
        using TileMmad = Gemm::Tile::TileMmad<ArchTag, AType, BType, void>;
        using LayoutAInL1 = typename TileCopy::CopyL1ToL0A::LayoutSrc;
        using LayoutBInL1 = typename TileCopy::CopyL1ToL0B::LayoutSrc;
        using LayoutAInL0 = typename TileCopy::CopyL1ToL0A::LayoutDst;
        using LayoutBInL0 = typename TileCopy::CopyL1ToL0B::LayoutDst;

        typename TileCopy::CopyGmToL1A copyGmToL1A;
        typename TileCopy::CopyGmToL1B copyGmToL1B;
        typename TileCopy::CopyL1ToL0A copyL1ToL0A;
        typename TileCopy::CopyL1ToL0B copyL1ToL0B;
        typename TileCopy::CopyL0CToGm copyL0CToGm;
        TileMmad tileMmad;

        uint32_t mRound = kda_align_up(m, 16u);
        uint32_t nRound = kda_align_up(n, 16u);
        uint32_t kRound = kda_align_up(k, 16u);
        auto layoutAInL1 = LayoutAInL1::template MakeLayout<half>(mRound, kRound);
        auto layoutBInL1 = LayoutBInL1::template MakeLayout<half>(kRound, nRound);
        auto layoutAInL0 = LayoutAInL0::template MakeLayout<half>(mRound, kRound);
        auto layoutBInL0 = LayoutBInL0::template MakeLayout<half>(kRound, nRound);
        auto layoutInL0C = layout::zN::MakeLayoutInL0C(MakeCoord(mRound, nRound));

        auto l1A_h = l1A[l1Id].ReinterpretCast<half>();
        auto l1B_h = l1B[l1Id].ReinterpretCast<half>();
        auto l0A_h = l0A[l0AId].ReinterpretCast<half>();
        auto l0B_h = l0B[l0BId].ReinterpretCast<half>();

        LayoutA layoutA(m, k, ldA);
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1Id);
        if (m < mRound || k < kRound) {
            AscendC::DataCopy(l1A_h, zero_gm_h, mRound * kRound);
            AscendC::PipeBarrier<PIPE_MTE2>();
        }
        copyGmToL1A(l1A_h, gmA, layoutAInL1, layoutA.GetTileLayout(MakeCoord(m, k)));
        AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1Id);

        LayoutB layoutB(k, n, ldB);
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1Id + STAGES);
        if (n < nRound || k < kRound) {
            AscendC::DataCopy(l1B_h, zero_gm_h, kRound * nRound);
            AscendC::PipeBarrier<PIPE_MTE2>();
        }
        copyGmToL1B(l1B_h, gmB, layoutBInL1, layoutB.GetTileLayout(MakeCoord(k, n)));
        AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1Id + STAGES);

        uint32_t cid = l0CId;
        auto& l0CTile = l0C[cid];
        AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cid);

        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0AId);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(l1Id);
        copyL1ToL0A(l0A_h, l1A_h, layoutAInL0, layoutAInL1);
        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(l1Id);

        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0BId + STAGES);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(l1Id + STAGES);
        copyL1ToL0B(l0B_h, l1B_h, layoutBInL0, layoutBInL1);
        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(l1Id + STAGES);

        AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
        tileMmad(l0CTile, l0A_h, l0B_h, mRound, nRound, kRound, true, 0b00);

        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0BId + STAGES);
        l0BId ^= 1u;
        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0AId);
        l0AId ^= 1u;
        l1Id ^= 1u;

        layout::RowMajor layoutC(m, n, ldC);
        AscendC::SetFlag<AscendC::HardEvent::M_FIX>(cid);
        AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(cid);
        copyL0CToGm(gmC, l0CTile, layoutC, layoutInL0C);
        AscendC::SetFlag<AscendC::HardEvent::FIX_M>(cid);
        l0CId ^= 1u;
    }
};

// ===========================================================================
// Common AIV Helpers (128-col row reductions, broadcasts, strided TND copies)
// ===========================================================================
__aicore__ inline void kda_copy_tnd_in_bf16(
    AscendC::LocalTensor<bfloat16_t> const& dst_ub,
    AscendC::GlobalTensor<bfloat16_t> const& src_gm,
    uint32_t t0, uint32_t rows, uint32_t h, uint32_t heads) {
    uint64_t base_off = (static_cast<uint64_t>(t0) * heads + h) * KDA_D;
    if (heads == 1u) {
        AscendC::DataCopy(dst_ub, src_gm[base_off], rows * KDA_D);
    } else {
        AscendC::DataCopyParams cp{
            static_cast<uint16_t>(rows),
            static_cast<uint16_t>(KDA_D / 16u),  // 8 blocks of 32B
            static_cast<uint16_t>((heads - 1u) * (KDA_D / 16u)),
            0};
        AscendC::DataCopy(dst_ub, src_gm[base_off], cp);
    }
}

__aicore__ inline void kda_copy_tnd_out_bf16(
    AscendC::GlobalTensor<bfloat16_t> const& dst_gm,
    AscendC::LocalTensor<bfloat16_t> const& src_ub,
    uint32_t t0, uint32_t rows, uint32_t h, uint32_t heads) {
    uint64_t base_off = (static_cast<uint64_t>(t0) * heads + h) * KDA_D;
    if (heads == 1u) {
        AscendC::DataCopy(dst_gm[base_off], src_ub, rows * KDA_D);
    } else {
        AscendC::DataCopyParams cp{
            static_cast<uint16_t>(rows),
            static_cast<uint16_t>(KDA_D / 16u),
            0,
            static_cast<uint16_t>((heads - 1u) * (KDA_D / 16u))};
        AscendC::DataCopy(dst_gm[base_off], src_ub, cp);
    }
}

__aicore__ inline void kda_copy_tnd_in_f32(
    AscendC::LocalTensor<float> const& dst_ub,
    AscendC::GlobalTensor<float> const& src_gm,
    uint32_t t0, uint32_t rows, uint32_t h, uint32_t heads) {
    uint64_t base_off = (static_cast<uint64_t>(t0) * heads + h) * KDA_D;
    if (heads == 1u) {
        AscendC::DataCopy(dst_ub, src_gm[base_off], rows * KDA_D);
    } else {
        AscendC::DataCopyParams cp{
            static_cast<uint16_t>(rows),
            static_cast<uint16_t>(KDA_D / 8u),  // 16 blocks of 32B
            static_cast<uint16_t>((heads - 1u) * (KDA_D / 8u)),
            0};
        AscendC::DataCopy(dst_ub, src_gm[base_off], cp);
    }
}

__aicore__ inline void kda_copy_tnd_out_f32(
    AscendC::GlobalTensor<float> const& dst_gm,
    AscendC::LocalTensor<float> const& src_ub,
    uint32_t t0, uint32_t rows, uint32_t h, uint32_t heads) {
    uint64_t base_off = (static_cast<uint64_t>(t0) * heads + h) * KDA_D;
    if (heads == 1u) {
        AscendC::DataCopy(dst_gm[base_off], src_ub, rows * KDA_D);
    } else {
        AscendC::DataCopyParams cp{
            static_cast<uint16_t>(rows),
            static_cast<uint16_t>(KDA_D / 8u),
            0,
            static_cast<uint16_t>((heads - 1u) * (KDA_D / 8u))};
        AscendC::DataCopy(dst_gm[base_off], src_ub, cp);
    }
}

__aicore__ inline void kda_rowsum_128(
    AscendC::LocalTensor<float> const& dst_rows,
    AscendC::LocalTensor<float> const& src_r128,
    AscendC::LocalTensor<float> const& red_part,
    uint32_t rows) {
    // Exact 2-stage PIPE_V WholeReduceSum: [rows, 128] -> [rows, 8] (stride 4) -> [rows]
    // Preserves src_r128 untouched and keeps every 2nd-stage repeat 32B-aligned!
    AscendC::Duplicate(red_part, 0.0f, rows * 8u);
    AscendC::PipeBarrier<PIPE_V>();
    AscendC::WholeReduceSum<float>(red_part, src_r128, 64, static_cast<int32_t>(rows * 2u), 4, 1, 8);
    AscendC::PipeBarrier<PIPE_V>();
    AscendC::WholeReduceSum<float>(dst_rows, red_part, 8, static_cast<int32_t>(rows), 1, 1, 1);
    AscendC::PipeBarrier<PIPE_V>();
}

__aicore__ inline void kda_mul_row_vec_128(
    AscendC::LocalTensor<float> const& mat_r128,
    AscendC::LocalTensor<float> const& vec_r,
    AscendC::LocalTensor<float> const& brc_512,
    uint32_t rows) {
    uint32_t blk_cnt = kda_align_up(rows, 8u) / 8u;
    AscendC::Brcb(
        brc_512.ReinterpretCast<uint32_t>(),
        vec_r.ReinterpretCast<uint32_t>(),
        static_cast<uint8_t>(blk_cnt),
        AscendC::BrcbRepeatParams(1, 8));
    AscendC::PipeBarrier<PIPE_V>();
    AscendC::Mul(mat_r128[0], mat_r128[0], brc_512, 64, static_cast<uint8_t>(rows),
                 AscendC::BinaryRepeatParams(1, 1, 0, 16, 16, 1));
    AscendC::Mul(mat_r128[64], mat_r128[64], brc_512, 64, static_cast<uint8_t>(rows),
                 AscendC::BinaryRepeatParams(1, 1, 0, 16, 16, 1));
    AscendC::PipeBarrier<PIPE_V>();
}

__aicore__ inline void kda_mul_row_vec_128_out(
    AscendC::LocalTensor<float> const& dst_r128,
    AscendC::LocalTensor<float> const& src_r128,
    AscendC::LocalTensor<float> const& vec_r,
    AscendC::LocalTensor<float> const& brc_512,
    uint32_t rows) {
    uint32_t blk_cnt = kda_align_up(rows, 8u) / 8u;
    AscendC::Brcb(
        brc_512.ReinterpretCast<uint32_t>(),
        vec_r.ReinterpretCast<uint32_t>(),
        static_cast<uint8_t>(blk_cnt),
        AscendC::BrcbRepeatParams(1, 8));
    AscendC::PipeBarrier<PIPE_V>();
    AscendC::Mul(dst_r128[0], src_r128[0], brc_512, 64, static_cast<uint8_t>(rows),
                 AscendC::BinaryRepeatParams(1, 1, 0, 16, 16, 1));
    AscendC::Mul(dst_r128[64], src_r128[64], brc_512, 64, static_cast<uint8_t>(rows),
                 AscendC::BinaryRepeatParams(1, 1, 0, 16, 16, 1));
    AscendC::PipeBarrier<PIPE_V>();
}

// Broadcast a single 128-float row `row_128` across `rows` rows of `dst_r128` via Sub/Add/Mul
__aicore__ inline void kda_sub_vec128_rows(
    AscendC::LocalTensor<float> const& dst,
    AscendC::LocalTensor<float> const& a,
    AscendC::LocalTensor<float> const& row_128,
    uint32_t rows) {
    AscendC::Sub(dst[0], a[0], row_128[0], 64, static_cast<uint8_t>(rows),
                 AscendC::BinaryRepeatParams(1, 1, 1, 16, 16, 0));
    AscendC::Sub(dst[64], a[64], row_128[64], 64, static_cast<uint8_t>(rows),
                 AscendC::BinaryRepeatParams(1, 1, 1, 16, 16, 0));
    AscendC::PipeBarrier<PIPE_V>();
}

__aicore__ inline void kda_rsub_vec128_rows(
    AscendC::LocalTensor<float> const& dst,
    AscendC::LocalTensor<float> const& row_128,
    AscendC::LocalTensor<float> const& a,
    uint32_t rows) {
    AscendC::Sub(dst[0], row_128[0], a[0], 64, static_cast<uint8_t>(rows),
                 AscendC::BinaryRepeatParams(1, 1, 1, 16, 0, 16));
    AscendC::Sub(dst[64], row_128[64], a[64], 64, static_cast<uint8_t>(rows),
                 AscendC::BinaryRepeatParams(1, 1, 1, 16, 0, 16));
    AscendC::PipeBarrier<PIPE_V>();
}

__aicore__ inline void kda_add_vec128_rows(
    AscendC::LocalTensor<float> const& dst,
    AscendC::LocalTensor<float> const& a,
    AscendC::LocalTensor<float> const& row_128,
    uint32_t rows) {
    AscendC::Add(dst[0], a[0], row_128[0], 64, static_cast<uint8_t>(rows),
                 AscendC::BinaryRepeatParams(1, 1, 1, 16, 16, 0));
    AscendC::Add(dst[64], a[64], row_128[64], 64, static_cast<uint8_t>(rows),
                 AscendC::BinaryRepeatParams(1, 1, 1, 16, 16, 0));
    AscendC::PipeBarrier<PIPE_V>();
}

__aicore__ inline void kda_mul_vec128_rows(
    AscendC::LocalTensor<float> const& dst,
    AscendC::LocalTensor<float> const& a,
    AscendC::LocalTensor<float> const& row_128,
    uint32_t rows) {
    AscendC::Mul(dst[0], a[0], row_128[0], 64, static_cast<uint8_t>(rows),
                 AscendC::BinaryRepeatParams(1, 1, 1, 16, 16, 0));
    AscendC::Mul(dst[64], a[64], row_128[64], 64, static_cast<uint8_t>(rows),
                 AscendC::BinaryRepeatParams(1, 1, 1, 16, 16, 0));
    AscendC::PipeBarrier<PIPE_V>();
}

// 6-step ping-pong parallel forward prefix sum over `rows <= 64` rows of width 128 in UB (5x fewer copies!)
__aicore__ inline void kda_prefix_sum_fwd_64x128(
    AscendC::LocalTensor<float> const& g_ub,
    AscendC::LocalTensor<float> const& tmp_ub,
    uint32_t rows) {
    bool in_tmp = false;
    for (uint32_t step = 1u; step < rows; step <<= 1) {
        auto const& src = in_tmp ? tmp_ub : g_ub;
        auto const& dst = in_tmp ? g_ub : tmp_ub;
        uint32_t cnt = (rows - step) * KDA_D;
        AscendC::Adds(dst[0], src[0], 0.0f, step * KDA_D);
        AscendC::Add(dst[step * KDA_D], src[step * KDA_D], src[0], cnt);
        AscendC::PipeBarrier<PIPE_V>();
        in_tmp = !in_tmp;
    }
    if (in_tmp) {
        AscendC::Adds(g_ub[0], tmp_ub[0], 0.0f, rows * KDA_D);
        AscendC::PipeBarrier<PIPE_V>();
    }
}

// 6-step ping-pong parallel reverse prefix sum over `rows <= 64` rows of width 128 in UB (5x fewer copies!)
__aicore__ inline void kda_prefix_sum_rev_64x128(
    AscendC::LocalTensor<float> const& g_ub,
    AscendC::LocalTensor<float> const& tmp_ub,
    uint32_t rows) {
    bool in_tmp = false;
    for (uint32_t step = 1u; step < rows; step <<= 1) {
        auto const& src = in_tmp ? tmp_ub : g_ub;
        auto const& dst = in_tmp ? g_ub : tmp_ub;
        uint32_t cnt = (rows - step) * KDA_D;
        AscendC::Add(dst[0], src[0], src[step * KDA_D], cnt);
        AscendC::Adds(dst[cnt], src[cnt], 0.0f, step * KDA_D);
        AscendC::PipeBarrier<PIPE_V>();
        in_tmp = !in_tmp;
    }
    if (in_tmp) {
        AscendC::Adds(g_ub[0], tmp_ub[0], 0.0f, rows * KDA_D);
        AscendC::PipeBarrier<PIPE_V>();
    }
}

// Fast binary-tree column sum: acc_128 += sum_{r=0..rows-1} src[r, :] (destroys src!)
__aicore__ inline void kda_colsum_add_128(
    AscendC::LocalTensor<float> const& acc_128,
    AscendC::LocalTensor<float> const& src_r128,
    uint32_t rows) {
    uint32_t cur = rows;
    while (cur > 1u) {
        uint32_t half = cur >> 1;
        AscendC::Add(src_r128[0], src_r128[0], src_r128[(cur - half) * KDA_D], half * KDA_D);
        AscendC::PipeBarrier<PIPE_V>();
        cur -= half;
    }
    if (rows > 0u) {
        AscendC::Add(acc_128, acc_128, src_r128[0], KDA_D);
        AscendC::PipeBarrier<PIPE_V>();
    }
}

// Byte-exact MTE2/MTE3 copies for [H, T] FP32 1D per-head sequences (no scalar GM stores!)
__aicore__ inline void kda_copy_ht_in_f32(
    AscendC::LocalTensor<float> const& dst_ub,
    AscendC::GlobalTensor<float> const& src_gm,
    uint32_t h, uint32_t t0, uint32_t rows, uint32_t total_tokens) {
    uint64_t off = static_cast<uint64_t>(h) * total_tokens + t0;
    uint32_t pad_r = kda_align_up(rows, 8u) - rows;
    AscendC::DataCopyPad(
        dst_ub, src_gm[off],
        AscendC::DataCopyExtParams{1, rows * 4u, 0, 0, 0},
        AscendC::DataCopyPadExtParams<float>{pad_r > 0u, 0, static_cast<uint8_t>(pad_r), 0.0f});
}

__aicore__ inline void kda_copy_ht_out_f32(
    AscendC::GlobalTensor<float> const& dst_gm,
    AscendC::LocalTensor<float> const& src_ub,
    uint32_t h, uint32_t t0, uint32_t rows, uint32_t total_tokens) {
    uint64_t off = static_cast<uint64_t>(h) * total_tokens + t0;
    AscendC::DataCopyPad(
        dst_gm[off], src_ub,
        AscendC::DataCopyExtParams{1, rows * 4u, 0, 0, 0});
}

// ===========================================================================
// Kernel 1: Pure-AIV Fused L2Norm + Gate + Chunk Cumsum + qg/kg/kbg/vb + 4x16x16 Diag Aqk/Akk
// ===========================================================================
struct KdaPrepParams {
    uint32_t total_tokens;
    uint32_t heads;
    uint32_t num_chunks;
    float scale;
    float lower_bound;
    float eps;
    uint64_t q_raw;        // [T, H, 128] bf16
    uint64_t k_raw;        // [T, H, 128] bf16
    uint64_t v_raw;        // [T, H, 128] bf16
    uint64_t a_raw;        // [T, H, 128] bf16
    uint64_t beta_raw;     // [T, H] fp32
    uint64_t a_log;        // [H] fp32
    uint64_t dt_bias;      // [H, 128] fp32
    uint64_t chunk_meta;   // [NC, 4] int32: (doc_id, tok_start, chunk_len, local_idx)
    uint64_t q_hat;        // [T, H, 128] bf16
    uint64_t k_hat;        // [T, H, 128] bf16
    uint64_t q_rstd;       // [T, H] fp32
    uint64_t k_rstd;       // [T, H] fp32
    uint64_t beta_eff;     // [T, H] fp32
    uint64_t gk;           // [T, H, 128] fp32
    uint64_t g_last;       // [NC, H, 128] fp32
    uint64_t qg;           // [T, H, 128] bf16
    uint64_t kg;           // [T, H, 128] bf16
    uint64_t k_beta_g;     // [T, H, 128] bf16
    uint64_t v_beta;       // [T, H, 128] bf16
    uint64_t aqk_diag;     // [NC, H, 4, 16, 16] fp32
    uint64_t akk_diag;     // [NC, H, 4, 16, 16] fp32
};

__global__ __aicore__ void kda_fwd_prep_aiv_kernel(KdaPrepParams p) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    uint32_t vid = AscendC::GetBlockIdx();
    if (vid >= KDA_AIV_CORES) return;

    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> ub;
    pipe.InitBuffer(ub, 190 * 1024);
    auto base = ub.Get<uint8_t>();

    // UB layout (185 KiB <= 190 KiB):
    // [0, 32768)       : q_f       [64, 128] fp32 (32 KiB)
    // [32768, 65536)   : k_f       [64, 128] fp32 (32 KiB)
    // [65536, 98304)   : g_f       [64, 128] fp32 (32 KiB)
    // [98304, 131072)  : tmp_f     [64, 128] fp32 (32 KiB)
    // [131072, 147456) : io1_bf16  [64, 128] bf16 (16 KiB)
    // [147456, 163840) : io2_bf16  [64, 128] bf16 (16 KiB)
    // [163840, 172032) : diag_aqk  [4, 16, 16] fp32 (4 KiB) + diag_akk [4, 16, 16] fp32 (4 KiB)
    // [172032, 176128) : red_part  [1024] fp32 (4 KiB)
    // [176128, 178176) : brc_512   [512] fp32 (2 KiB)
    // [178176, 180224) : ones_512  [512] fp32 (2 KiB)
    // [180224, 184320) : dt_bias_f (512B), g_last_f (512B), beta_f (256B), rstd_q (256B),
    //                    rstd_k (256B), row_dot (256B), meta_ub (16B)
    auto q_f = base[0].ReinterpretCast<float>();
    auto k_f = base[32768].ReinterpretCast<float>();
    auto g_f = base[65536].ReinterpretCast<float>();
    auto tmp_f = base[98304].ReinterpretCast<float>();
    auto io1_bf16 = base[131072].ReinterpretCast<bfloat16_t>();
    auto io2_bf16 = base[147456].ReinterpretCast<bfloat16_t>();
    auto diag_aqk = base[163840].ReinterpretCast<float>();
    auto diag_akk = base[167936].ReinterpretCast<float>();
    auto red_part = base[172032].ReinterpretCast<float>();
    auto brc_512 = base[176128].ReinterpretCast<float>();
    auto ones_512 = base[178176].ReinterpretCast<float>();
    auto dt_bias_f = base[180224].ReinterpretCast<float>();
    auto g_last_f = base[180736].ReinterpretCast<float>();
    auto beta_f = base[181248].ReinterpretCast<float>();
    auto rstd_q = base[181504].ReinterpretCast<float>();
    auto rstd_k = base[181760].ReinterpretCast<float>();
    auto row_dot = base[182016].ReinterpretCast<float>();

    AscendC::Duplicate(ones_512, 1.0f, 512);
    AscendC::PipeBarrier<PIPE_V>();

    AscendC::GlobalTensor<bfloat16_t> q_raw_gm, k_raw_gm, v_raw_gm, a_raw_gm;
    AscendC::GlobalTensor<bfloat16_t> q_hat_gm, k_hat_gm, qg_gm, kg_gm, kbg_gm, vb_gm;
    AscendC::GlobalTensor<float> beta_raw_gm, a_log_gm, dt_bias_gm;
    AscendC::GlobalTensor<float> q_rstd_gm, k_rstd_gm, beta_eff_gm, gk_gm, g_last_gm, aqk_d_gm, akk_d_gm;
    AscendC::GlobalTensor<int32_t> meta_gm;

    q_raw_gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.q_raw));
    k_raw_gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.k_raw));
    v_raw_gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.v_raw));
    a_raw_gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.a_raw));
    beta_raw_gm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(p.beta_raw));
    a_log_gm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(p.a_log));
    dt_bias_gm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(p.dt_bias));
    meta_gm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(p.chunk_meta));

    q_hat_gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.q_hat));
    k_hat_gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.k_hat));
    q_rstd_gm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(p.q_rstd));
    k_rstd_gm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(p.k_rstd));
    beta_eff_gm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(p.beta_eff));
    gk_gm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(p.gk));
    g_last_gm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(p.g_last));
    qg_gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.qg));
    kg_gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.kg));
    kbg_gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.k_beta_g));
    vb_gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.v_beta));
    aqk_d_gm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(p.aqk_diag));
    akk_d_gm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(p.akk_diag));

    const uint32_t total_tasks = p.num_chunks * p.heads;
    const uint32_t H = p.heads;
    uint32_t cached_h = 0xffffffffu;
    float cached_a_exp = 1.0f;

    // Partition by head-major so dt_bias / a_log stay cached in UB!
    for (uint32_t tid = vid; tid < total_tasks; tid += KDA_AIV_CORES) {
        uint32_t h = tid / p.num_chunks;
        uint32_t c = tid - h * p.num_chunks;
        uint32_t t0 = static_cast<uint32_t>(meta_gm.GetValue(c * 4u + 1u));
        uint32_t L = static_cast<uint32_t>(meta_gm.GetValue(c * 4u + 2u));
        if (L == 0u) continue;
        uint32_t elems = L * KDA_D;

        if (h != cached_h) {
            cached_h = h;
            float al = a_log_gm.GetValue(h);
            // Compute exp(a_log[h]) via PIPE_V on 8 floats
            beta_f.SetValue(0, al);
            AscendC::SetFlag<AscendC::HardEvent::S_V>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::S_V>(EVENT_ID0);
            AscendC::Exp(beta_f, beta_f, 8);
            AscendC::SetFlag<AscendC::HardEvent::V_S>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::V_S>(EVENT_ID0);
            cached_a_exp = beta_f.GetValue(0);

            AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID1);
            AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID1);
            AscendC::DataCopy(dt_bias_f, dt_bias_gm[static_cast<uint64_t>(h) * KDA_D], KDA_D);
            AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID1);
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID1);
        }

        // Load q_raw, k_raw, beta_raw ([H, T] fp32 via MTE2 DataCopyPad)
        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
        kda_copy_tnd_in_bf16(io1_bf16, q_raw_gm, t0, L, h, H);
        kda_copy_tnd_in_bf16(io2_bf16, k_raw_gm, t0, L, h, H);
        kda_copy_ht_in_f32(beta_f, beta_raw_gm, h, t0, L, p.total_tokens);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

        // beta_eff = sigmoid(beta_raw)
        AscendC::Muls(beta_f, beta_f, -1.0f, kda_align_up(L, 8u));
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Exp(beta_f, beta_f, kda_align_up(L, 8u));
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Adds(beta_f, beta_f, 1.0f, kda_align_up(L, 8u));
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Div(beta_f, ones_512, beta_f, kda_align_up(L, 8u));
        AscendC::PipeBarrier<PIPE_V>();

        // 1. Exact FP32 L2Norm on Q and K
        AscendC::Cast(q_f, io1_bf16, AscendC::RoundMode::CAST_NONE, elems);
        AscendC::Cast(k_f, io2_bf16, AscendC::RoundMode::CAST_NONE, elems);
        AscendC::PipeBarrier<PIPE_V>();

        // Start loading a_raw into io1_bf16 and v_raw into io2_bf16 right after Cast!
        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
        kda_copy_tnd_in_bf16(io1_bf16, a_raw_gm, t0, L, h, H);
        kda_copy_tnd_in_bf16(io2_bf16, v_raw_gm, t0, L, h, H);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

        AscendC::Mul(tmp_f, q_f, q_f, elems);
        AscendC::PipeBarrier<PIPE_V>();
        kda_rowsum_128(rstd_q, tmp_f, red_part, L);
        AscendC::Adds(rstd_q, rstd_q, p.eps, kda_align_up(L, 8u));
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Rsqrt(rstd_q, rstd_q, kda_align_up(L, 8u));
        AscendC::PipeBarrier<PIPE_V>();
        kda_mul_row_vec_128(q_f, rstd_q, brc_512, L);

        AscendC::Mul(tmp_f, k_f, k_f, elems);
        AscendC::PipeBarrier<PIPE_V>();
        kda_rowsum_128(rstd_k, tmp_f, red_part, L);
        AscendC::Adds(rstd_k, rstd_k, p.eps, kda_align_up(L, 8u));
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Rsqrt(rstd_k, rstd_k, kda_align_up(L, 8u));
        AscendC::PipeBarrier<PIPE_V>();
        kda_mul_row_vec_128(k_f, rstd_k, brc_512, L);

        // Wait for a_raw & v_raw load
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::Cast(g_f, io1_bf16, AscendC::RoundMode::CAST_NONE, elems);
        AscendC::Cast(tmp_f, io2_bf16, AscendC::RoundMode::CAST_NONE, elems);  // v_f in tmp_f
        AscendC::PipeBarrier<PIPE_V>();

        // Store q_hat, k_hat (and round q_f, k_f to exact saved BF16 values!)
        AscendC::Cast(io1_bf16, q_f, AscendC::RoundMode::CAST_RINT, elems);
        AscendC::Cast(io2_bf16, k_f, AscendC::RoundMode::CAST_RINT, elems);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Cast(q_f, io1_bf16, AscendC::RoundMode::CAST_NONE, elems);
        AscendC::Cast(k_f, io2_bf16, AscendC::RoundMode::CAST_NONE, elems);
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        kda_copy_tnd_out_bf16(q_hat_gm, io1_bf16, t0, L, h, H);
        kda_copy_tnd_out_bf16(k_hat_gm, io2_bf16, t0, L, h, H);

        // Compute v_beta = v * beta_eff -> store vb_gm
        kda_mul_row_vec_128(tmp_f, beta_f, brc_512, L);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
        AscendC::Cast(io2_bf16, tmp_f, AscendC::RoundMode::CAST_RINT, elems);
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        kda_copy_tnd_out_bf16(vb_gm, io2_bf16, t0, L, h, H);

        // Store q_rstd, k_rstd, beta_eff ([H, T] fp32 via MTE3 DataCopyPad — 100% HBM coherent!)
        kda_copy_ht_out_f32(q_rstd_gm, rstd_q, h, t0, L, p.total_tokens);
        kda_copy_ht_out_f32(k_rstd_gm, rstd_k, h, t0, L, p.total_tokens);
        kda_copy_ht_out_f32(beta_eff_gm, beta_f, h, t0, L, p.total_tokens);

        // 2. Exact lowerbound gate + 6-step parallel chunk cumsum
        // g_step = lower_bound * sigmoid(exp(a_log) * (a + dt_bias))
        kda_add_vec128_rows(g_f, g_f, dt_bias_f, L);
        AscendC::Muls(g_f, g_f, -cached_a_exp, elems);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Exp(g_f, g_f, elems);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Adds(g_f, g_f, 1.0f, elems);
        AscendC::PipeBarrier<PIPE_V>();
        // tmp_f = lower_bound / (1 + exp(-...))
        AscendC::Duplicate(tmp_f, p.lower_bound, 128);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Div(g_f[0], tmp_f[0], g_f[0], 64, static_cast<uint8_t>(L),
                     AscendC::BinaryRepeatParams(1, 1, 1, 16, 0, 16));
        AscendC::Div(g_f[64], tmp_f[64], g_f[64], 64, static_cast<uint8_t>(L),
                     AscendC::BinaryRepeatParams(1, 1, 1, 16, 0, 16));
        AscendC::PipeBarrier<PIPE_V>();

        // Chunk-local prefix sum -> gk in g_f!
        kda_prefix_sum_fwd_64x128(g_f, tmp_f, L);

        // Save g_last = gk[L-1]
        AscendC::Adds(g_last_f, g_f[(L - 1u) * KDA_D], 0.0f, KDA_D);
        AscendC::PipeBarrier<PIPE_V>();

        // Store gk and g_last
        AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        kda_copy_tnd_out_f32(gk_gm, g_f, t0, L, h, H);
        AscendC::DataCopy(g_last_gm[(static_cast<uint64_t>(c) * H + h) * KDA_D], g_last_f, KDA_D);

        // 3. Compute qg = q_hat * exp(gk), k_beta_g = k_hat * beta * exp(gk), kg = k_hat * exp(g_last - gk)
        //    Compute exp(gk) ONCE into tmp_f and reuse across qg & k_beta_g (q_f is dead after qg!).
        AscendC::Exp(tmp_f, g_f, elems);  // exp(gk) in (0, 1]
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Mul(q_f, q_f, tmp_f, elems);
        AscendC::Mul(tmp_f, k_f, tmp_f, elems);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Cast(io1_bf16, q_f, AscendC::RoundMode::CAST_RINT, elems);
        kda_mul_row_vec_128(tmp_f, beta_f, brc_512, L);
        AscendC::Cast(io2_bf16, tmp_f, AscendC::RoundMode::CAST_RINT, elems);

        AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        kda_copy_tnd_out_bf16(qg_gm, io1_bf16, t0, L, h, H);
        kda_copy_tnd_out_bf16(kbg_gm, io2_bf16, t0, L, h, H);

        // kg = k_hat * exp(g_last - gk)
        kda_rsub_vec128_rows(tmp_f, g_last_f, g_f, L);  // g_last - gk <= 0
        AscendC::Exp(tmp_f, tmp_f, elems);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Mul(tmp_f, k_f, tmp_f, elems);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
        AscendC::Cast(io1_bf16, tmp_f, AscendC::RoundMode::CAST_RINT, elems);
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        kda_copy_tnd_out_bf16(kg_gm, io1_bf16, t0, L, h, H);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
    }
    AscendC::PipeBarrier<PIPE_ALL>();
}

// ===========================================================================
// Kernel 1+2 Fused (v5): 48-AIV Dual-Slot 2-Epoch Fused Prep + Intra + Blocked HF32 SolveTril + WY
// ===========================================================================
class KdaFwdPrepIntraWyKernel {
public:
    using ArchTag = Arch::AtlasA2;

    // Per-slot workspace (180,224 B = 176 KiB), x2 slots (sub0/sub1) x2 epochs (ep=0/1) = 704 KiB/core (~16.5 MiB chip-wide)
    static constexpr uint64_t WS_ZERO_BYTES = 65536ULL;
    static constexpr uint64_t WS_SLOT_BYTES = 180224ULL;
    static constexpr uint64_t WS_PER_CORE_BYTES = 4ULL * WS_SLOT_BYTES;

    struct Params {
        uint32_t total_tokens;
        uint32_t heads;
        uint32_t num_chunks;
        float scale;
        float lower_bound;
        float eps;
        uint64_t q_raw;
        uint64_t k_raw;
        uint64_t v_raw;
        uint64_t a_raw;
        uint64_t beta_raw;
        uint64_t a_log;
        uint64_t dt_bias;
        uint64_t chunk_meta;
        uint64_t q_hat;
        uint64_t k_hat;
        uint64_t q_rstd;
        uint64_t k_rstd;
        uint64_t beta_eff;
        uint64_t gk;
        uint64_t g_last;
        uint64_t qg;
        uint64_t kg;
        uint64_t aqk_out;
        uint64_t akk_inv_out;
        uint64_t w_out;
        uint64_t u_out;
        uint64_t workspace;
    };

    struct SlotGm {
        AscendC::GlobalTensor<bfloat16_t> qk_anc, kp_anc, diag_qk, diag_ki, kbg_ws, vb_ws;
        AscendC::GlobalTensor<float> off_out, diag_out, inv_f32_ws, a_off_f32, tmp_merge;

        CATLASS_DEVICE void bind(uint64_t base) {
            qk_anc.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(base + 0ULL));
            kp_anc.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(base + 24576ULL));
            diag_qk.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(base + 49152ULL));
            diag_ki.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(base + 81920ULL));
            off_out.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(base + 98304ULL));
            diag_out.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(base + 110592ULL));
            kbg_ws.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(base + 118784ULL));
            vb_ws.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(base + 135168ULL));
            inv_f32_ws.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(base + 151552ULL));
            a_off_f32.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(base + 167936ULL));
            tmp_merge.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(base + 174080ULL));
        }
    };

    template<int32_t CORE_TYPE = g_coreType>
    CATLASS_DEVICE void operator()(Params const& p);

    template<>
    CATLASS_DEVICE void operator()<AscendC::AIC>(Params const& p) {
        KdaCubeRunner cube(resource, p.workspace);
        AscendC::GlobalTensor<int32_t> meta_gm;
        AscendC::GlobalTensor<bfloat16_t> akk_inv_out_gm, w_gm, u_gm;
        meta_gm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(p.chunk_meta));
        akk_inv_out_gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.akk_inv_out));
        w_gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.w_out));
        u_gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.u_out));

        const uint32_t core = AscendC::GetBlockIdx();
        const uint32_t cores = AscendC::GetBlockNum();
        const uint64_t ws_core = p.workspace + WS_ZERO_BYTES + static_cast<uint64_t>(core) * WS_PER_CORE_BYTES;
        const uint32_t H = p.heads;
        const uint32_t hd = H * KDA_D;
        const uint32_t total_tasks = p.num_chunks * H;
        const uint32_t num_pairs = (total_tasks + 1u) / 2u;
        const uint32_t base_p = num_pairs / cores;
        const uint32_t rem_p = num_pairs - base_p * cores;
        const uint32_t p_begin = core * base_p + (core < rem_p ? core : rem_p);
        const uint32_t p_cnt = base_p + (core < rem_p ? 1u : 0u);

        Arch::CrossCoreSetFlag<0x2, PIPE_FIX>(flag_slot_free[0]);
        Arch::CrossCoreSetFlag<0x2, PIPE_FIX>(flag_slot_free[1]);

        SlotGm slot[2];

        for (uint32_t iter = 0u; iter < p_cnt; ++iter) {
            const uint32_t ep = iter & 1u;
            uint32_t L_s[2] = {0u, 0u};
            uint64_t t_off_s[2] = {0ULL, 0ULL};
            uint64_t m_off_s[2] = {0ULL, 0ULL};
            bool valid_s[2] = {false, false};

            for (uint32_t s = 0u; s < 2u; ++s) {
                slot[s].bind(ws_core + static_cast<uint64_t>(ep * 2u + s) * WS_SLOT_BYTES);
                uint32_t tid = (p_begin + iter) * 2u + s;
                if (tid < total_tasks) {
                    uint32_t h = tid / p.num_chunks;
                    uint32_t c = tid - h * p.num_chunks;
                    uint32_t t0 = static_cast<uint32_t>(meta_gm.GetValue(c * 4u + 1u));
                    uint32_t L = static_cast<uint32_t>(meta_gm.GetValue(c * 4u + 2u));
                    if (L > 0u) {
                        valid_s[s] = true;
                        L_s[s] = L;
                        t_off_s[s] = (static_cast<uint64_t>(t0) * H + h) * KDA_D;
                        m_off_s[s] = (static_cast<uint64_t>(c) * H + h) * 4096ULL;
                    }
                }
            }

            // 1. Wait for AIV anchors -> run off-diag + 4x16x16 diag GEMMs for BOTH slots!
            Arch::CrossCoreWaitFlag(flag_anc_ready[ep]);
            for (uint32_t s = 0u; s < 2u; ++s) {
                if (!valid_s[s]) continue;
                uint32_t L = L_s[s];
                if (L > 16u) {
                    cube.gemm_small<false, true, float>(
                        slot[s].qk_anc[0], KDA_D, 0u, slot[s].kp_anc[0], KDA_D, 0u,
                        slot[s].off_out[0], 16u, 32u, 16u, KDA_D, 16u, false);
                }
                if (L > 32u) {
                    cube.gemm_small<false, true, float>(
                        slot[s].qk_anc[32u * KDA_D], KDA_D, 0u, slot[s].kp_anc[16u * KDA_D], KDA_D, 0u,
                        slot[s].off_out[512u], 32u, 32u, 32u, KDA_D, 32u, false);
                }
                if (L > 48u) {
                    cube.gemm_small<false, true, float>(
                        slot[s].qk_anc[64u * KDA_D], KDA_D, 0u, slot[s].kp_anc[48u * KDA_D], KDA_D, 0u,
                        slot[s].off_out[1536u], 48u, 32u, 48u, KDA_D, 48u, false);
                }
                for (uint32_t d = 0u; d < 4u; ++d) {
                    if (d * 16u >= L) break;
                    cube.gemm_small<false, true, float>(
                        slot[s].diag_qk[d * 32u * KDA_D], KDA_D, 0u,
                        slot[s].diag_ki[d * 16u * KDA_D], KDA_D, 0u,
                        slot[s].diag_out[d * 512u], 16u, 32u, 16u, KDA_D, 16u, false);
                }
            }
            Arch::CrossCoreSetFlag<0x2, PIPE_FIX>(flag_off_ready[ep]);

            // 2. Wait for AIV 4x16x16 T_diag & -A_off -> HF32 Cube blocked solve_tril merge + WY (w, u)!
            Arch::CrossCoreWaitFlag(flag_inv_ready[ep]);
            bool any_gt16 = (valid_s[0] && L_s[0] > 16u) || (valid_s[1] && L_s[1] > 16u);
            bool any_gt32 = (valid_s[0] && L_s[0] > 32u) || (valid_s[1] && L_s[1] > 32u);

            if (any_gt16) {
                for (uint32_t s = 0u; s < 2u; ++s) {
                    if (!valid_s[s] || L_s[s] <= 16u) continue;
                    uint32_t L = L_s[s];
                    uint32_t nr1 = (L - 16u < 16u) ? (L - 16u) : 16u;
                    cube.gemm_f32<false, false, float>(
                        slot[s].a_off_f32[0], 16u, slot[s].inv_f32_ws[0], KDA_BT, 0u,
                        slot[s].tmp_merge[0], 16u, nr1, 16u, 16u);
                    if (L > 48u) {
                        uint32_t nr3 = L - 48u;
                        cube.gemm_f32<false, false, float>(
                            slot[s].a_off_f32[256], 16u, slot[s].inv_f32_ws[32u * KDA_BT + 32u], KDA_BT, 0u,
                            slot[s].tmp_merge[256], 16u, nr3, 16u, 16u);
                    }
                }
                AscendC::PipeBarrier<PIPE_ALL>();

                for (uint32_t s = 0u; s < 2u; ++s) {
                    if (!valid_s[s] || L_s[s] <= 16u) continue;
                    uint32_t L = L_s[s];
                    uint32_t nr1 = (L - 16u < 16u) ? (L - 16u) : 16u;
                    cube.gemm_f32_dual<false, false>(
                        slot[s].inv_f32_ws[16u * KDA_BT + 16u], KDA_BT, slot[s].tmp_merge[0], 16u,
                        slot[s].inv_f32_ws[16u * KDA_BT], KDA_BT,
                        akk_inv_out_gm[m_off_s[s] + 16u * KDA_BT], KDA_BT, nr1, 16u, nr1);
                    if (L > 48u) {
                        uint32_t nr3 = L - 48u;
                        cube.gemm_f32_dual<false, false>(
                            slot[s].inv_f32_ws[48u * KDA_BT + 48u], KDA_BT, slot[s].tmp_merge[256], 16u,
                            slot[s].inv_f32_ws[48u * KDA_BT + 32u], KDA_BT,
                            akk_inv_out_gm[m_off_s[s] + 48u * KDA_BT + 32u], KDA_BT, nr3, 16u, nr3);
                    }
                }
                AscendC::PipeBarrier<PIPE_ALL>();
            }

            if (any_gt32) {
                for (uint32_t s = 0u; s < 2u; ++s) {
                    if (!valid_s[s] || L_s[s] <= 32u) continue;
                    uint32_t nr2 = L_s[s] - 32u;
                    cube.gemm_f32<false, false, float>(
                        slot[s].a_off_f32[512], 32u, slot[s].inv_f32_ws[0], KDA_BT, 0u,
                        slot[s].tmp_merge[0], 32u, nr2, 32u, 32u);
                }
                AscendC::PipeBarrier<PIPE_ALL>();

                for (uint32_t s = 0u; s < 2u; ++s) {
                    if (!valid_s[s] || L_s[s] <= 32u) continue;
                    uint32_t nr2 = L_s[s] - 32u;
                    cube.gemm_f32<false, false, bfloat16_t>(
                        slot[s].inv_f32_ws[32u * KDA_BT + 32u], KDA_BT, slot[s].tmp_merge[0], 32u, 0u,
                        akk_inv_out_gm[m_off_s[s] + 32u * KDA_BT], KDA_BT, nr2, 32u, nr2);
                }
                AscendC::PipeBarrier<PIPE_ALL>();
            }

            for (uint32_t s = 0u; s < 2u; ++s) {
                if (!valid_s[s]) continue;
                uint32_t L = L_s[s];
                cube.pin_a<false>(0u, akk_inv_out_gm[m_off_s[s]], KDA_BT, L, L);
                cube.gemm_small<false, false, bfloat16_t, true, false>(
                    akk_inv_out_gm[m_off_s[s]], KDA_BT, 0u,
                    slot[s].kbg_ws, KDA_D, 0u,
                    w_gm[t_off_s[s]], hd, L, KDA_D, L, KDA_D, false);
                cube.gemm_small<false, false, bfloat16_t, true, false>(
                    akk_inv_out_gm[m_off_s[s]], KDA_BT, 0u,
                    slot[s].vb_ws, KDA_D, 0u,
                    u_gm[t_off_s[s]], hd, L, KDA_D, L, KDA_D, false);
            }
            Arch::CrossCoreSetFlag<0x2, PIPE_FIX>(flag_slot_free[ep]);
        }
        AscendC::PipeBarrier<PIPE_ALL>();
    }

    template<>
    CATLASS_DEVICE void operator()<AscendC::AIV>(Params const& p) {
        const uint32_t subblocks = AscendC::GetSubBlockNum();
        const uint32_t sub_idx = AscendC::GetSubBlockIdx();
        const uint32_t core = AscendC::GetBlockIdx() / subblocks;
        const uint32_t cores = AscendC::GetBlockNum();
        const uint64_t ws_core = p.workspace + WS_ZERO_BYTES + static_cast<uint64_t>(core) * WS_PER_CORE_BYTES;

        AscendC::GlobalTensor<int32_t> meta_gm;
        AscendC::GlobalTensor<bfloat16_t> q_raw_gm, k_raw_gm, v_raw_gm, a_raw_gm;
        AscendC::GlobalTensor<bfloat16_t> q_hat_gm, k_hat_gm, qg_gm, kg_gm, aqk_out_gm, akk_inv_out_gm;
        AscendC::GlobalTensor<float> beta_raw_gm, a_log_gm, dt_bias_gm;
        AscendC::GlobalTensor<float> q_rstd_gm, k_rstd_gm, beta_eff_gm, gk_gm, g_last_gm;

        meta_gm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(p.chunk_meta));
        q_raw_gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.q_raw));
        k_raw_gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.k_raw));
        v_raw_gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.v_raw));
        a_raw_gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.a_raw));
        beta_raw_gm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(p.beta_raw));
        a_log_gm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(p.a_log));
        dt_bias_gm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(p.dt_bias));

        q_hat_gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.q_hat));
        k_hat_gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.k_hat));
        q_rstd_gm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(p.q_rstd));
        k_rstd_gm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(p.k_rstd));
        beta_eff_gm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(p.beta_eff));
        gk_gm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(p.gk));
        g_last_gm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(p.g_last));
        qg_gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.qg));
        kg_gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.kg));
        aqk_out_gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.aqk_out));
        akk_inv_out_gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.akk_inv_out));

        // UB layout (181,504 B = 177.25 KiB <= 192 KiB, 100% owned per AIV subblock!):
        auto q_f = resource.ubBuf.template GetBufferByByte<float>(0);                  // 32 KiB [64,128]
        auto k_f = resource.ubBuf.template GetBufferByByte<float>(32768);              // 32 KiB [64,128]
        auto g_f = resource.ubBuf.template GetBufferByByte<float>(65536);              // 32 KiB [64,128]
        auto tmp_f = resource.ubBuf.template GetBufferByByte<float>(98304);            // 32 KiB [64,128]
        auto io1_bf16 = resource.ubBuf.template GetBufferByByte<bfloat16_t>(131072);   // 16 KiB [64,128]
        auto io2_bf16 = resource.ubBuf.template GetBufferByByte<bfloat16_t>(147456);   // 16 KiB [64,128]
        auto io_bf_32k = resource.ubBuf.template GetBufferByByte<bfloat16_t>(131072);  // 32 KiB [128,128]
        auto tril4x16_mask = resource.ubBuf.template GetBufferByByte<float>(163840);   // 4 KiB  [16,64]
        auto eye4x16 = resource.ubBuf.template GetBufferByByte<float>(167936);         // 4 KiB  [16,64]
        auto tril16_inc = resource.ubBuf.template GetBufferByByte<float>(172032);      // 1 KiB  [16,16]
        auto gather_off = resource.ubBuf.template GetBufferByByte<uint32_t>(173056);   // 512 B  [128]
        auto red_part = resource.ubBuf.template GetBufferByByte<float>(173568);        // 2 KiB  [512]
        auto brc_512 = resource.ubBuf.template GetBufferByByte<float>(175616);         // 2 KiB  [512]
        auto ones_512 = resource.ubBuf.template GetBufferByByte<float>(177664);        // 2 KiB  [512]
        auto dt_bias_f = resource.ubBuf.template GetBufferByByte<float>(179712);       // 512 B  [128]
        auto g_last_f = resource.ubBuf.template GetBufferByByte<float>(180224);        // 512 B  [128]
        auto beta_f = resource.ubBuf.template GetBufferByByte<float>(180736);          // 256 B  [64]
        auto rstd_q = resource.ubBuf.template GetBufferByByte<float>(180992);          // 256 B  [64]
        auto rstd_k = resource.ubBuf.template GetBufferByByte<float>(181248);          // 256 B  [64]

        // Post-anchor aliases inside dead q_f/k_f/g_f:
        auto a_mat = resource.ubBuf.template GetBufferByByte<float>(0);                // 16 KiB [64,64]
        auto out64_bf16 = resource.ubBuf.template GetBufferByByte<bfloat16_t>(16384);  // 8 KiB  [64,64]
        auto a_off_ub = resource.ubBuf.template GetBufferByByte<float>(24576);         // 6 KiB  [1536]
        auto col_dup = resource.ubBuf.template GetBufferByByte<float>(30720);          // 512 B  [128]
        auto off_f = resource.ubBuf.template GetBufferByByte<float>(32768);            // 12 KiB [3072]
        auto diag_f = resource.ubBuf.template GetBufferByByte<float>(45056);           // 8 KiB  [2048]
        auto a16_pack = resource.ubBuf.template GetBufferByByte<float>(53248);         // 4 KiB  [16,64]
        auto t16_pack = resource.ubBuf.template GetBufferByByte<float>(57344);         // 4 KiB  [16,64]
        auto brc_1024 = resource.ubBuf.template GetBufferByByte<float>(61440);         // 4 KiB  [16,64]
        auto tmp_1024 = resource.ubBuf.template GetBufferByByte<float>(65536);         // 4 KiB  [16,64]

        AscendC::Duplicate(ones_512, 1.0f, 512u);
        AscendC::Duplicate(tril4x16_mask, 0.0f, 1024u);
        AscendC::Duplicate(eye4x16, 0.0f, 1024u);
        AscendC::Duplicate(tril16_inc, 0.0f, 256u);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::SetFlag<AscendC::HardEvent::V_S>(EVENT_ID1);
        AscendC::WaitFlag<AscendC::HardEvent::V_S>(EVENT_ID1);
        for (uint32_t r = 0u; r < 16u; ++r) {
            for (uint32_t c = 0u; c <= r; ++c) {
                tril16_inc.SetValue(r * 16u + c, 1.0f);
            }
            for (uint32_t s = 0u; s < 4u; ++s) {
                eye4x16.SetValue(r * 64u + s * 16u + r, 1.0f);
                for (uint32_t c = 0u; c < r; ++c) {
                    tril4x16_mask.SetValue(r * 64u + s * 16u + c, 1.0f);
                }
                uint32_t boff = (r * 64u + s * 16u) * 4u;
                gather_off.SetValue(r * 8u + s * 2u + 0u, boff);
                gather_off.SetValue(r * 8u + s * 2u + 1u, boff);
            }
        }
        AscendC::SetFlag<AscendC::HardEvent::S_V>(EVENT_ID1);
        AscendC::WaitFlag<AscendC::HardEvent::S_V>(EVENT_ID1);

        const uint32_t H = p.heads;
        const uint32_t total_tasks = p.num_chunks * H;
        const uint32_t num_pairs = (total_tasks + 1u) / 2u;
        const uint32_t base_p = num_pairs / cores;
        const uint32_t rem_p = num_pairs - base_p * cores;
        const uint32_t p_begin = core * base_p + (core < rem_p ? core : rem_p);
        const uint32_t p_cnt = base_p + (core < rem_p ? 1u : 0u);

        uint32_t cached_h = 0xffffffffu;
        float cached_a_exp = 1.0f;
        SlotGm sl;

        for (uint32_t iter = 0u; iter < p_cnt; ++iter) {
            const uint32_t ep = iter & 1u;
            const uint32_t tid = (p_begin + iter) * 2u + sub_idx;
            sl.bind(ws_core + static_cast<uint64_t>(ep * 2u + sub_idx) * WS_SLOT_BYTES);

            uint32_t h = 0u, c = 0u, t0 = 0u, L = 0u, elems = 0u;
            uint64_t m_off = 0ULL;
            bool valid = false;
            if (tid < total_tasks) {
                h = tid / p.num_chunks;
                c = tid - h * p.num_chunks;
                t0 = static_cast<uint32_t>(meta_gm.GetValue(c * 4u + 1u));
                L = static_cast<uint32_t>(meta_gm.GetValue(c * 4u + 2u));
                if (L > 0u) {
                    valid = true;
                    elems = L * KDA_D;
                    m_off = (static_cast<uint64_t>(c) * H + h) * 4096ULL;
                }
            }

            if (valid && h != cached_h) {
                cached_h = h;
                float al = a_log_gm.GetValue(h);
                beta_f.SetValue(0, al);
                AscendC::SetFlag<AscendC::HardEvent::S_V>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::S_V>(EVENT_ID0);
                AscendC::Exp(beta_f, beta_f, 8);
                AscendC::SetFlag<AscendC::HardEvent::V_S>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::V_S>(EVENT_ID0);
                cached_a_exp = beta_f.GetValue(0);
                AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID1);
                AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID1);
                AscendC::DataCopy(dt_bias_f, dt_bias_gm[static_cast<uint64_t>(h) * KDA_D], KDA_D);
                AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID1);
                AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID1);
            }

            Arch::CrossCoreWaitFlag(flag_slot_free[ep]);

            if (valid) {
                // Step 1: Load raw q, k, beta -> beta_eff & L2Norm(q, k)
                AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
                kda_copy_tnd_in_bf16(io1_bf16, q_raw_gm, t0, L, h, H);
                kda_copy_tnd_in_bf16(io2_bf16, k_raw_gm, t0, L, h, H);
                kda_copy_ht_in_f32(beta_f, beta_raw_gm, h, t0, L, p.total_tokens);
                AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

                uint32_t l_al8 = kda_align_up(L, 8u);
                AscendC::Muls(beta_f, beta_f, -1.0f, l_al8);
                AscendC::Cast(q_f, io1_bf16, AscendC::RoundMode::CAST_NONE, elems);
                AscendC::Cast(k_f, io2_bf16, AscendC::RoundMode::CAST_NONE, elems);
                AscendC::PipeBarrier<PIPE_V>();

                // Prefetch a_raw & v_raw WHILE computing beta sigmoid & Q/K L2Norm!
                AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
                kda_copy_tnd_in_bf16(io1_bf16, a_raw_gm, t0, L, h, H);
                kda_copy_tnd_in_bf16(io2_bf16, v_raw_gm, t0, L, h, H);
                AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

                AscendC::Exp(beta_f, beta_f, l_al8);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Adds(beta_f, beta_f, 1.0f, l_al8);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Div(beta_f, ones_512, beta_f, l_al8);
                AscendC::PipeBarrier<PIPE_V>();

                AscendC::Mul(tmp_f, q_f, q_f, elems);
                AscendC::PipeBarrier<PIPE_V>();
                kda_rowsum_128(rstd_q, tmp_f, red_part, L);
                AscendC::Adds(rstd_q, rstd_q, p.eps, l_al8);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Rsqrt(rstd_q, rstd_q, l_al8);
                AscendC::PipeBarrier<PIPE_V>();
                kda_mul_row_vec_128(q_f, rstd_q, brc_512, L);

                AscendC::Mul(tmp_f, k_f, k_f, elems);
                AscendC::PipeBarrier<PIPE_V>();
                kda_rowsum_128(rstd_k, tmp_f, red_part, L);
                AscendC::Adds(rstd_k, rstd_k, p.eps, l_al8);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Rsqrt(rstd_k, rstd_k, l_al8);
                AscendC::PipeBarrier<PIPE_V>();
                kda_mul_row_vec_128(k_f, rstd_k, brc_512, L);

                AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
                AscendC::Cast(g_f, io1_bf16, AscendC::RoundMode::CAST_NONE, elems);
                AscendC::Cast(tmp_f, io2_bf16, AscendC::RoundMode::CAST_NONE, elems);
                AscendC::PipeBarrier<PIPE_V>();

                AscendC::Cast(io1_bf16, q_f, AscendC::RoundMode::CAST_RINT, elems);
                AscendC::Cast(io2_bf16, k_f, AscendC::RoundMode::CAST_RINT, elems);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Cast(q_f, io1_bf16, AscendC::RoundMode::CAST_NONE, elems);
                AscendC::Cast(k_f, io2_bf16, AscendC::RoundMode::CAST_NONE, elems);
                AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
                kda_copy_tnd_out_bf16(q_hat_gm, io1_bf16, t0, L, h, H);
                kda_copy_tnd_out_bf16(k_hat_gm, io2_bf16, t0, L, h, H);
                kda_copy_ht_out_f32(q_rstd_gm, rstd_q, h, t0, L, p.total_tokens);
                kda_copy_ht_out_f32(k_rstd_gm, rstd_k, h, t0, L, p.total_tokens);
                kda_copy_ht_out_f32(beta_eff_gm, beta_f, h, t0, L, p.total_tokens);

                // Compute v_beta = v * beta_eff -> L2-hot sl.vb_ws
                kda_mul_row_vec_128(tmp_f, beta_f, brc_512, L);
                AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
                AscendC::Cast(io2_bf16, tmp_f, AscendC::RoundMode::CAST_RINT, elems);
                AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
                AscendC::DataCopy(sl.vb_ws, io2_bf16, elems);

                // Step 2: Lowerbound gate (exact 24-bit IEEE FP32 Div!) + ping-pong chunk cumsum -> gk in g_f
                kda_add_vec128_rows(g_f, g_f, dt_bias_f, L);
                AscendC::Muls(g_f, g_f, -cached_a_exp, elems);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Exp(g_f, g_f, elems);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Adds(g_f, g_f, 1.0f, elems);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Duplicate(tmp_f, p.lower_bound, 128u);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Div(g_f[0], tmp_f[0], g_f[0], 64, static_cast<uint8_t>(L),
                             AscendC::BinaryRepeatParams(1, 1, 1, 16, 0, 16));
                AscendC::Div(g_f[64], tmp_f[64], g_f[64], 64, static_cast<uint8_t>(L),
                             AscendC::BinaryRepeatParams(1, 1, 1, 16, 0, 16));
                AscendC::PipeBarrier<PIPE_V>();

                kda_prefix_sum_fwd_64x128(g_f, tmp_f, L);
                AscendC::Adds(g_last_f, g_f[(L - 1u) * KDA_D], 0.0f, KDA_D);
                AscendC::PipeBarrier<PIPE_V>();

                AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
                AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
                kda_copy_tnd_out_f32(gk_gm, g_f, t0, L, h, H);
                AscendC::DataCopy(g_last_gm[(static_cast<uint64_t>(c) * H + h) * KDA_D], g_last_f, KDA_D);

                // Step 3: Prepare off-diag & 4x16x16 diag anchors from UB-resident q_f, k_f, g_f, beta_f!
                AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
                for (uint32_t sr = 1u; sr <= 3u; ++sr) {
                    uint32_t r0 = sr * 16u;
                    if (r0 >= L) break;
                    uint32_t nr = (L - r0 < 16u) ? (L - r0) : 16u;
                    uint32_t cnt = nr * KDA_D;
                    kda_sub_vec128_rows(tmp_f, g_f[r0 * KDA_D], g_f[r0 * KDA_D], nr);
                    AscendC::Exp(tmp_f, tmp_f, cnt);
                    AscendC::PipeBarrier<PIPE_V>();
                    if (nr < 16u) {
                        AscendC::Duplicate(io_bf_32k.ReinterpretCast<uint16_t>(), static_cast<uint16_t>(0), 32u * KDA_D);
                        AscendC::PipeBarrier<PIPE_V>();
                    }
                    AscendC::Mul(tmp_f[16u * KDA_D], q_f[r0 * KDA_D], tmp_f, cnt);
                    AscendC::Mul(tmp_f[32u * KDA_D], k_f[r0 * KDA_D], tmp_f, cnt);
                    AscendC::PipeBarrier<PIPE_V>();
                    AscendC::Cast(io_bf_32k[0], tmp_f[16u * KDA_D], AscendC::RoundMode::CAST_RINT, cnt);
                    kda_mul_row_vec_128(tmp_f[32u * KDA_D], beta_f[r0], brc_512, nr);
                    AscendC::Cast(io_bf_32k[16u * KDA_D], tmp_f[32u * KDA_D], AscendC::RoundMode::CAST_RINT, cnt);
                    AscendC::PipeBarrier<PIPE_V>();

                    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
                    AscendC::DataCopy(sl.qk_anc[(sr - 1u) * 32u * KDA_D], io_bf_32k, 32u * KDA_D);
                    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);

                    uint32_t kp_off = (sr == 1u) ? 0u : ((sr == 2u) ? (16u * KDA_D) : (48u * KDA_D));
                    kda_rsub_vec128_rows(tmp_f, g_f[r0 * KDA_D], g_f[0], r0);
                    AscendC::Exp(tmp_f, tmp_f, r0 * KDA_D);
                    AscendC::PipeBarrier<PIPE_V>();
                    AscendC::Mul(tmp_f, k_f[0], tmp_f, r0 * KDA_D);
                    AscendC::PipeBarrier<PIPE_V>();
                    AscendC::Cast(io_bf_32k, tmp_f, AscendC::RoundMode::CAST_RINT, r0 * KDA_D);
                    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
                    AscendC::DataCopy(sl.kp_anc[kp_off], io_bf_32k, r0 * KDA_D);
                    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
                }

                for (uint32_t s = 0u; s < 4u; ++s) {
                    uint32_t s_base = s * 16u;
                    if (s_base >= L) break;
                    uint32_t s_len = (L - s_base < 16u) ? (L - s_base) : 16u;
                    uint32_t m = s_base + (s_len >> 1);
                    uint32_t cnt = s_len * KDA_D;

                    kda_sub_vec128_rows(tmp_f[0], g_f[s_base * KDA_D], g_f[m * KDA_D], s_len);
                    AscendC::Exp(tmp_f[0], tmp_f[0], cnt);
                    kda_rsub_vec128_rows(tmp_f[48u * KDA_D], g_f[m * KDA_D], g_f[s_base * KDA_D], s_len);
                    AscendC::Exp(tmp_f[48u * KDA_D], tmp_f[48u * KDA_D], cnt);
                    AscendC::PipeBarrier<PIPE_V>();

                    if (s_len < 16u) {
                        AscendC::Duplicate(io_bf_32k.ReinterpretCast<uint16_t>(), static_cast<uint16_t>(0), 48u * KDA_D);
                        AscendC::PipeBarrier<PIPE_V>();
                    }
                    AscendC::Mul(tmp_f[16u * KDA_D], q_f[s_base * KDA_D], tmp_f[0], cnt);
                    AscendC::Mul(tmp_f[32u * KDA_D], k_f[s_base * KDA_D], tmp_f[0], cnt);
                    AscendC::Mul(tmp_f[48u * KDA_D], k_f[s_base * KDA_D], tmp_f[48u * KDA_D], cnt);
                    AscendC::PipeBarrier<PIPE_V>();
                    AscendC::Cast(io_bf_32k[0], tmp_f[16u * KDA_D], AscendC::RoundMode::CAST_RINT, cnt);
                    kda_mul_row_vec_128(tmp_f[32u * KDA_D], beta_f[s_base], brc_512, s_len);
                    AscendC::Cast(io_bf_32k[16u * KDA_D], tmp_f[32u * KDA_D], AscendC::RoundMode::CAST_RINT, cnt);
                    AscendC::Cast(io_bf_32k[32u * KDA_D], tmp_f[48u * KDA_D], AscendC::RoundMode::CAST_RINT, cnt);
                    AscendC::PipeBarrier<PIPE_V>();

                    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
                    AscendC::DataCopy(sl.diag_qk[s * 32u * KDA_D], io_bf_32k[0], 32u * KDA_D);
                    AscendC::DataCopy(sl.diag_ki[s * 16u * KDA_D], io_bf_32k[32u * KDA_D], 16u * KDA_D);
                    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
                }
            }
            Arch::CrossCoreSetFlag<0x2, PIPE_MTE3>(flag_anc_ready[ep]);

            // Step 4 (100% overlapped with AIC off-diag + diag Cube GEMMs!): Compute qg, kbg_ws, kg!
            if (valid) {
                AscendC::Exp(tmp_f, g_f, elems);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Mul(q_f, q_f, tmp_f, elems);
                AscendC::Mul(tmp_f, k_f, tmp_f, elems);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Cast(io1_bf16, q_f, AscendC::RoundMode::CAST_RINT, elems);
                kda_mul_row_vec_128(tmp_f, beta_f, brc_512, L);
                AscendC::Cast(io2_bf16, tmp_f, AscendC::RoundMode::CAST_RINT, elems);
                AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
                kda_copy_tnd_out_bf16(qg_gm, io1_bf16, t0, L, h, H);
                AscendC::DataCopy(sl.kbg_ws, io2_bf16, elems);

                kda_rsub_vec128_rows(tmp_f, g_last_f, g_f, L);
                AscendC::Exp(tmp_f, tmp_f, elems);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Mul(tmp_f, k_f, tmp_f, elems);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
                AscendC::Cast(io1_bf16, tmp_f, AscendC::RoundMode::CAST_RINT, elems);
                AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
                kda_copy_tnd_out_bf16(kg_gm, io1_bf16, t0, L, h, H);
                AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
            }

            // Step 5: Wait for AIC off+diag -> Assemble Aqk + 15-step 4x16x16 solve_tril!
            Arch::CrossCoreWaitFlag(flag_off_ready[ep]);
            if (valid) {
                AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
                if (L > 16u) AscendC::DataCopy(off_f, sl.off_out, 3072u);
                AscendC::DataCopy(diag_f, sl.diag_out, 2048u);
                AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

                // 5a. Assemble Aqk (ZERO SetVectorMask scalar loop!)
                AscendC::Duplicate(a_mat, 0.0f, 4096u);
                AscendC::PipeBarrier<PIPE_V>();
                for (uint32_t s = 0u; s < 4u; ++s) {
                    if (s * 16u >= L) break;
                    AscendC::Mul(tmp_1024, diag_f[s * 512u], tril16_inc, 256u);
                    AscendC::PipeBarrier<PIPE_V>();
                    AscendC::DataCopy(a_mat[s * 16u * 64u + s * 16u], tmp_1024, AscendC::DataCopyParams{16, 2, 0, 6});
                }
                if (L > 16u) AscendC::DataCopy(a_mat[16u * 64u], off_f[0], AscendC::DataCopyParams{16, 2, 0, 6});
                if (L > 32u) AscendC::DataCopy(a_mat[32u * 64u], off_f[512u], AscendC::DataCopyParams{16, 4, 0, 4});
                if (L > 48u) AscendC::DataCopy(a_mat[48u * 64u], off_f[1536u], AscendC::DataCopyParams{16, 6, 0, 2});
                AscendC::PipeBarrier<PIPE_V>();
                if (L < 64u) {
                    AscendC::Duplicate(a_mat[L * 64u], 0.0f, (64u - L) * 64u);
                    AscendC::PipeBarrier<PIPE_V>();
                }
                AscendC::Muls(a_mat, a_mat, p.scale, 4096u);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Cast(out64_bf16, a_mat, AscendC::RoundMode::CAST_RINT, 4096u);
                AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
                AscendC::DataCopy(aqk_out_gm[m_off], out64_bf16, 4096u);

                // 5b. Simultaneous 4x16x16 FP32 inverse in 15 vector steps!
                AscendC::Duplicate(a16_pack, 0.0f, 1024u);
                AscendC::Adds(t16_pack, eye4x16, 0.0f, 1024u);
                AscendC::PipeBarrier<PIPE_V>();
                for (uint32_t s = 0u; s < 4u; ++s) {
                    if (s * 16u >= L) break;
                    AscendC::DataCopy(a16_pack[s * 16u], diag_f[s * 512u + 256u], AscendC::DataCopyParams{16, 2, 0, 6});
                }
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Mul(a16_pack, a16_pack, tril4x16_mask, 1024u);
                AscendC::PipeBarrier<PIPE_V>();

                if (L < 64u) {
                    AscendC::SetFlag<AscendC::HardEvent::V_S>(EVENT_ID1);
                    AscendC::WaitFlag<AscendC::HardEvent::V_S>(EVENT_ID1);
                    for (uint32_t s = 0u; s < 4u; ++s) {
                        for (uint32_t r = 0u; r < 16u; ++r) {
                            if (s * 16u + r >= L) {
                                t16_pack.SetValue(r * 64u + s * 16u + r, 0.0f);
                                for (uint32_t col = 0u; col < r; ++col) {
                                    a16_pack.SetValue(r * 64u + s * 16u + col, 0.0f);
                                }
                            }
                        }
                    }
                    AscendC::SetFlag<AscendC::HardEvent::S_V>(EVENT_ID1);
                    AscendC::WaitFlag<AscendC::HardEvent::S_V>(EVENT_ID1);
                }

                for (uint32_t k = 0u; k < 15u; ++k) {
                    uint32_t n_rows = 15u - k;
                    AscendC::Gather(col_dup, a16_pack, gather_off, k * 4u, 128u);
                    AscendC::PipeBarrier<PIPE_V>();
                    AscendC::Brcb(brc_1024.ReinterpretCast<uint32_t>(),
                                  col_dup[(k + 1u) * 8u].ReinterpretCast<uint32_t>(),
                                  static_cast<uint8_t>(n_rows), AscendC::BrcbRepeatParams(1, 8));
                    AscendC::PipeBarrier<PIPE_V>();
                    AscendC::Mul(tmp_1024, brc_1024, t16_pack[k * 64u], 64, static_cast<uint8_t>(n_rows),
                                 AscendC::BinaryRepeatParams(1, 1, 1, 8, 8, 0));
                    AscendC::PipeBarrier<PIPE_V>();
                    AscendC::Sub(t16_pack[(k + 1u) * 64u], t16_pack[(k + 1u) * 64u], tmp_1024, n_rows * 64u);
                    AscendC::PipeBarrier<PIPE_V>();
                }

                AscendC::Duplicate(a_mat, 0.0f, 4096u);
                AscendC::PipeBarrier<PIPE_V>();
                for (uint32_t s = 0u; s < 4u; ++s) {
                    if (s * 16u >= L) break;
                    AscendC::DataCopy(a_mat[s * 16u * 64u + s * 16u], t16_pack[s * 16u], AscendC::DataCopyParams{16, 2, 6, 6});
                }
                AscendC::PipeBarrier<PIPE_V>();

                if (L > 16u) {
                    AscendC::Duplicate(a_off_ub, 0.0f, 1536u);
                    AscendC::PipeBarrier<PIPE_V>();
                    AscendC::DataCopy(a_off_ub[0], off_f[256u], 256u);
                    if (L > 32u) {
                        AscendC::DataCopy(a_off_ub[512u], off_f[1024u], 512u);
                    }
                    if (L > 48u) {
                        AscendC::DataCopy(a_off_ub[256u], off_f[2304u + 32u], AscendC::DataCopyParams{16, 2, 4, 0});
                        AscendC::DataCopy(a_off_ub[1024u], off_f[2304u], AscendC::DataCopyParams{16, 4, 2, 0});
                    }
                    AscendC::PipeBarrier<PIPE_V>();
                    AscendC::Muls(a_off_ub, a_off_ub, -1.0f, 1536u);
                    AscendC::PipeBarrier<PIPE_V>();
                }

                AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
                AscendC::Cast(out64_bf16, a_mat, AscendC::RoundMode::CAST_RINT, 4096u);
                AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
                AscendC::DataCopy(sl.inv_f32_ws, a_mat, 4096u);
                AscendC::DataCopy(akk_inv_out_gm[m_off], out64_bf16, 4096u);
                if (L > 16u) {
                    AscendC::DataCopy(sl.a_off_f32, a_off_ub, 1536u);
                }
                AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
            }
            Arch::CrossCoreSetFlag<0x2, PIPE_MTE3>(flag_inv_ready[ep]);
        }
        Arch::CrossCoreWaitFlag(flag_slot_free[0]);
        Arch::CrossCoreWaitFlag(flag_slot_free[1]);
        AscendC::PipeBarrier<PIPE_ALL>();
    }

private:
    Arch::CrossCoreFlag flag_anc_ready[2]{{0}, {1}};
    Arch::CrossCoreFlag flag_off_ready[2]{{2}, {3}};
    Arch::CrossCoreFlag flag_inv_ready[2]{{4}, {5}};
    Arch::CrossCoreFlag flag_slot_free[2]{{6}, {7}};
    Arch::Resource<ArchTag> resource;
};

// ===========================================================================
// Kernel 3: Mixed AIC+AIV Fused ChunkFwdH + ChunkFwdO (100% UB-Resident h + L1 Reuse + Full Overlap!)
// ===========================================================================
class KdaFwdHOKernel {
public:
    using ArchTag = Arch::AtlasA2;

    // Per-AIC workspace (320 KiB):
    //   +0      : h_bf16[0]     [128, 128] bf16 (32 KiB)
    //   +32768  : h_bf16[1]     [128, 128] bf16 (32 KiB)
    //   +65536  : wh_f32        [64, 128]  fp32 (32 KiB)
    //   +98304  : vnew_bf16     [64, 128]  bf16 (16 KiB)
    //   +114688 : ointer_f32[0] [64, 128]  fp32 (32 KiB)
    //   +147456 : ointer_f32[1] [64, 128]  fp32 (32 KiB)
    //   +180224 : ointra_f32[0] [64, 128]  fp32 (32 KiB)
    //   +212992 : ointra_f32[1] [64, 128]  fp32 (32 KiB)
    //   +245760 : dh_f32        [128, 128] fp32 (64 KiB)
    //   Total = 311,296 B -> 320 KiB per AIC core!
    static constexpr uint64_t WS_ZERO_BYTES = 65536ULL;
    static constexpr uint64_t WS_PER_CORE_BYTES = 327680ULL;

    struct Params {
        uint32_t total_tokens;
        uint32_t heads;
        uint32_t num_docs;
        uint32_t save_states;
        float scale;
        uint64_t doc_chunks;   // [num_docs + 1] int32
        uint64_t chunk_meta;   // [NC, 4] int32
        uint64_t w;            // [T, H, 128] bf16
        uint64_t u;            // [T, H, 128] bf16
        uint64_t qg;           // [T, H, 128] bf16
        uint64_t kg;           // [T, H, 128] bf16
        uint64_t aqk;          // [NC, H, 64, 64] bf16
        uint64_t g_last;       // [NC, H, 128] fp32
        uint64_t o_out;        // [T, H, 128] bf16
        uint64_t v_new_out;    // [T, H, 128] bf16 (optional)
        uint64_t h_out;        // [NC, H, 128, 128] bf16 (optional)
        uint64_t workspace;
    };

    template<int32_t CORE_TYPE = g_coreType>
    CATLASS_DEVICE void operator()(Params const& p);

    template<>
    CATLASS_DEVICE void operator()<AscendC::AIC>(Params const& p) {
        KdaCubeRunner cube(resource, p.workspace);
        AscendC::GlobalTensor<int32_t> doc_c_gm, meta_gm;
        AscendC::GlobalTensor<bfloat16_t> w_gm, qg_gm, kg_gm, aqk_gm;
        doc_c_gm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(p.doc_chunks));
        meta_gm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(p.chunk_meta));
        w_gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.w));
        qg_gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.qg));
        kg_gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.kg));
        aqk_gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.aqk));

        uint32_t core = AscendC::GetBlockIdx();
        uint32_t cores = AscendC::GetBlockNum();
        uint64_t ws_base = p.workspace + WS_ZERO_BYTES + static_cast<uint64_t>(core) * WS_PER_CORE_BYTES;

        AscendC::GlobalTensor<bfloat16_t> h_ws[2], vnew_ws;
        AscendC::GlobalTensor<float> wh_ws, ointer_ws[2], ointra_ws[2], dh_ws;
        h_ws[0].SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(ws_base));
        h_ws[1].SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(ws_base + 32768ULL));
        wh_ws.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(ws_base + 65536ULL));
        vnew_ws.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(ws_base + 98304ULL));
        ointer_ws[0].SetGlobalBuffer(reinterpret_cast<__gm__ float*>(ws_base + 114688ULL));
        ointer_ws[1].SetGlobalBuffer(reinterpret_cast<__gm__ float*>(ws_base + 147456ULL));
        ointra_ws[0].SetGlobalBuffer(reinterpret_cast<__gm__ float*>(ws_base + 180224ULL));
        ointra_ws[1].SetGlobalBuffer(reinterpret_cast<__gm__ float*>(ws_base + 212992ULL));
        dh_ws.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(ws_base + 245760ULL));

        const uint32_t H = p.heads;
        const uint32_t hd = H * KDA_D;
        const uint32_t total_tasks = p.num_docs * H;

        for (uint32_t tid = core; tid < total_tasks; tid += cores) {
            uint32_t doc = tid / H;
            uint32_t h = tid - doc * H;
            uint32_t c_begin = static_cast<uint32_t>(doc_c_gm.GetValue(doc));
            uint32_t c_end = static_cast<uint32_t>(doc_c_gm.GetValue(doc + 1u));
            uint32_t nt = c_end - c_begin;

            for (uint32_t step = 0u; step < nt; ++step) {
                uint32_t c = c_begin + step;
                uint32_t buf = step & 1u;
                uint32_t t0 = static_cast<uint32_t>(meta_gm.GetValue(c * 4u + 1u));
                uint32_t L = static_cast<uint32_t>(meta_gm.GetValue(c * 4u + 2u));
                uint64_t t_off = (static_cast<uint64_t>(t0) * H + h) * KDA_D;
                uint64_t aqk_off = (static_cast<uint64_t>(c) * H + h) * 4096ULL;

                if (step >= 2u) {
                    Arch::CrossCoreWaitFlag(flag_o_done);
                }
                if (step > 0u) {
                    // Wait for updated h[step] from AIV, pin h in L1[0], run BOTH w@h and qg@h!
                    Arch::CrossCoreWaitFlag(flag_h_ready[buf]);
                    cube.pin_b<false>(0u, h_ws[buf], KDA_D, KDA_D, KDA_D);
                    // GEMM 1: wh = w[t] @ h[t]
                    cube.gemm_small<false, false, float, false, true>(
                        w_gm[t_off], hd, 0u, h_ws[buf], KDA_D, 0u,
                        wh_ws, KDA_D, L, KDA_D, KDA_D, KDA_D, false);
                    Arch::CrossCoreSetFlag<0x2, PIPE_FIX>(flag_wh_ready);

                    // GEMM 2 (overlaps with AIV v_new = u - wh!): o_inter[buf] = qg[t] @ h[t]
                    cube.gemm_small<false, false, float, false, true>(
                        qg_gm[t_off], hd, 0u, h_ws[buf], KDA_D, 0u,
                        ointer_ws[buf], KDA_D, L, KDA_D, KDA_D, KDA_D, false);
                    Arch::CrossCoreSetFlag<0x2, PIPE_FIX>(flag_ointer_ready);
                }

                // Wait for AIV v_new[t], pin v_new in L1[1], run BOTH kg^T @ v_new and Aqk @ v_new!
                Arch::CrossCoreWaitFlag(flag_vnew_ready);
                cube.pin_b<false>(1u, vnew_ws, KDA_D, L, KDA_D);
                if (step + 1u < nt) {
                    // GEMM 3: dh = kg[t]^T @ v_new[t]
                    cube.gemm_small<true, false, float, false, true>(
                        kg_gm[t_off], hd, 0u, vnew_ws, KDA_D, 1u,
                        dh_ws, KDA_D, KDA_D, KDA_D, L, KDA_D, false);
                    Arch::CrossCoreSetFlag<0x2, PIPE_FIX>(flag_dh_ready);
                }
                // GEMM 4 (overlaps with AIV h update!): o_intra[buf] = Aqk[t] @ v_new[t]
                cube.gemm_small<false, false, float, false, true>(
                    aqk_gm[aqk_off], KDA_BT, 0u, vnew_ws, KDA_D, 1u,
                    ointra_ws[buf], KDA_D, L, KDA_D, L, KDA_D, false);
                Arch::CrossCoreSetFlag<0x2, PIPE_FIX>(flag_ointra_ready);
            }
            uint32_t drain_o = (nt < 2u) ? nt : 2u;
            for (uint32_t d = 0u; d < drain_o; ++d) {
                Arch::CrossCoreWaitFlag(flag_o_done);
            }
        }
        AscendC::PipeBarrier<PIPE_ALL>();
    }

    template<>
    CATLASS_DEVICE void operator()<AscendC::AIV>(Params const& p) {
        uint32_t subblocks = AscendC::GetSubBlockNum();
        uint32_t sub_idx = AscendC::GetSubBlockIdx();
        uint32_t core = AscendC::GetBlockIdx() / subblocks;
        uint32_t cores = AscendC::GetBlockNum();
        uint64_t ws_base = p.workspace + WS_ZERO_BYTES + static_cast<uint64_t>(core) * WS_PER_CORE_BYTES;

        AscendC::GlobalTensor<int32_t> doc_c_gm, meta_gm;
        AscendC::GlobalTensor<bfloat16_t> u_gm, o_gm, vnew_out_gm, h_out_gm;
        AscendC::GlobalTensor<float> g_last_gm;
        doc_c_gm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(p.doc_chunks));
        meta_gm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(p.chunk_meta));
        u_gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.u));
        o_gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.o_out));
        if (p.save_states) {
            vnew_out_gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.v_new_out));
            h_out_gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.h_out));
        }
        g_last_gm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(p.g_last));

        AscendC::GlobalTensor<bfloat16_t> h_ws[2], vnew_ws;
        AscendC::GlobalTensor<float> wh_ws, ointer_ws[2], ointra_ws[2], dh_ws;
        h_ws[0].SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(ws_base));
        h_ws[1].SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(ws_base + 32768ULL));
        wh_ws.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(ws_base + 65536ULL));
        vnew_ws.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(ws_base + 98304ULL));
        ointer_ws[0].SetGlobalBuffer(reinterpret_cast<__gm__ float*>(ws_base + 114688ULL));
        ointer_ws[1].SetGlobalBuffer(reinterpret_cast<__gm__ float*>(ws_base + 147456ULL));
        ointra_ws[0].SetGlobalBuffer(reinterpret_cast<__gm__ float*>(ws_base + 180224ULL));
        ointra_ws[1].SetGlobalBuffer(reinterpret_cast<__gm__ float*>(ws_base + 212992ULL));
        dh_ws.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(ws_base + 245760ULL));

        // Each AIV subblock owns 64 rows of h [64, 128] (32 KiB) AND 32 rows of v_new/o [32, 128] (16 KiB)!
        // Total UB = 32 + 32 + 16 + 16 + 16 + 16 + 8 + 4 = 140 KiB <= 192 KiB!
        auto h_ub = resource.ubBuf.template GetBufferByByte<float>(0);             // 32 KiB [64, 128]
        auto dh_ub = resource.ubBuf.template GetBufferByByte<float>(32768);        // 32 KiB [64, 128]
        auto h_bf16 = resource.ubBuf.template GetBufferByByte<bfloat16_t>(65536);  // 16 KiB [64, 128]
        auto u_f = resource.ubBuf.template GetBufferByByte<float>(81920);          // 16 KiB [32, 128]
        auto wh_f = resource.ubBuf.template GetBufferByByte<float>(98304);         // 16 KiB [32, 128]
        auto io_bf16 = resource.ubBuf.template GetBufferByByte<bfloat16_t>(114688);// 8 KiB  [32, 128]
        auto g_sub = resource.ubBuf.template GetBufferByByte<float>(122880);       // 256 B  [64]
        auto brc_512 = resource.ubBuf.template GetBufferByByte<float>(123136);     // 2 KiB  [512]

        const uint32_t H = p.heads;
        const uint32_t total_tasks = p.num_docs * H;
        const uint32_t h_row_off = sub_idx * 64u;
        const uint32_t t_row_off = sub_idx * 32u;

        for (uint32_t tid = core; tid < total_tasks; tid += cores) {
            uint32_t doc = tid / H;
            uint32_t h = tid - doc * H;
            uint32_t c_begin = static_cast<uint32_t>(doc_c_gm.GetValue(doc));
            uint32_t c_end = static_cast<uint32_t>(doc_c_gm.GetValue(doc + 1u));
            uint32_t nt = c_end - c_begin;

            AscendC::Duplicate(h_ub, 0.0f, 64u * KDA_D);
            AscendC::PipeBarrier<PIPE_V>();

            for (uint32_t step = 0u; step < nt; ++step) {
                uint32_t c = c_begin + step;
                uint32_t buf = step & 1u;
                uint32_t nbuf = (step + 1u) & 1u;
                uint32_t t0 = static_cast<uint32_t>(meta_gm.GetValue(c * 4u + 1u));
                uint32_t L = static_cast<uint32_t>(meta_gm.GetValue(c * 4u + 2u));
                uint32_t my_rows = (L > t_row_off) ? ((L - t_row_off < 32u) ? (L - t_row_off) : 32u) : 0u;

                // 1. Compute v_new = u[t] - (step > 0 ? wh : 0) FIRST to unblock AIC immediately!
                if (my_rows > 0u) {
                    AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
                    kda_copy_tnd_in_bf16(io_bf16, u_gm, t0 + t_row_off, my_rows, h, H);
                    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
                }
                if (step > 0u) {
                    Arch::CrossCoreWaitFlag(flag_wh_ready);
                    if (my_rows > 0u) {
                        AscendC::Cast(u_f, io_bf16, AscendC::RoundMode::CAST_NONE, my_rows * KDA_D);
                        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
                        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
                        AscendC::DataCopy(wh_f, wh_ws[t_row_off * KDA_D], my_rows * KDA_D);
                        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
                        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
                        AscendC::Sub(u_f, u_f, wh_f, my_rows * KDA_D);
                        AscendC::PipeBarrier<PIPE_V>();
                        AscendC::Cast(io_bf16, u_f, AscendC::RoundMode::CAST_RINT, my_rows * KDA_D);
                        AscendC::PipeBarrier<PIPE_V>();
                    }
                }
                if (my_rows > 0u) {
                    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
                    AscendC::DataCopy(vnew_ws[t_row_off * KDA_D], io_bf16, my_rows * KDA_D);
                    if (p.save_states) {
                        kda_copy_tnd_out_bf16(vnew_out_gm, io_bf16, t0 + t_row_off, my_rows, h, H);
                    }
                    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
                }
                // Signal AIC so Cube immediately runs kg^T @ v_new and Aqk @ v_new!
                Arch::CrossCoreSetFlag<0x2, PIPE_MTE3>(flag_vnew_ready);

                // Save h[0] = zeros overlapped with AIC kg^T @ v_new (step > 0 already saved at end of step-1!)
                if (p.save_states && step == 0u) {
                    uint64_t h_off = ((static_cast<uint64_t>(c) * H + h) * KDA_D + h_row_off) * KDA_D;
                    AscendC::Cast(h_bf16, h_ub, AscendC::RoundMode::CAST_RINT, 64u * KDA_D);
                    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID1);
                    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID1);
                    AscendC::DataCopy(h_out_gm[h_off], h_bf16, 64u * KDA_D);
                    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID1);
                    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID1);
                }

                // 2. While AIC computes Aqk @ v_new, update h_ub = h_ub * exp(g_last) + dh_ws!
                if (step + 1u < nt) {
                    uint64_t gl_off = (static_cast<uint64_t>(c) * H + h) * KDA_D + h_row_off;
                    AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID1);
                    AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID1);
                    AscendC::DataCopy(g_sub, g_last_gm[gl_off], 64);
                    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID1);
                    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID1);
                    AscendC::Exp(g_sub, g_sub, 64);
                    AscendC::PipeBarrier<PIPE_V>();
                    kda_mul_row_vec_128(h_ub, g_sub, brc_512, 64);

                    Arch::CrossCoreWaitFlag(flag_dh_ready);
                    AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID1);
                    AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID1);
                    AscendC::DataCopy(dh_ub, dh_ws[h_row_off * KDA_D], 64u * KDA_D);
                    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID1);
                    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID1);
                    AscendC::Add(h_ub, h_ub, dh_ub, 64u * KDA_D);
                    AscendC::PipeBarrier<PIPE_V>();
                    AscendC::Cast(h_bf16, h_ub, AscendC::RoundMode::CAST_RINT, 64u * KDA_D);
                    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID1);
                    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID1);
                    AscendC::DataCopy(h_ws[nbuf][h_row_off * KDA_D], h_bf16, 64u * KDA_D);
                    Arch::CrossCoreSetFlag<0x2, PIPE_MTE3>(flag_h_ready[nbuf]);
                    if (p.save_states) {
                        uint64_t h_next_off = ((static_cast<uint64_t>(c + 1u) * H + h) * KDA_D + h_row_off) * KDA_D;
                        AscendC::DataCopy(h_out_gm[h_next_off], h_bf16, 64u * KDA_D);
                    }
                    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID1);
                    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID1);
                }

                // 3. Finalize o[t] = bf16(scale * o_inter[buf] + o_intra[buf]) (overlapped with AIC step+1 w@h!)
                if (step > 0u) {
                    Arch::CrossCoreWaitFlag(flag_ointer_ready);
                }
                Arch::CrossCoreWaitFlag(flag_ointra_ready);
                if (my_rows > 0u) {
                    AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
                    AscendC::DataCopy(u_f, ointra_ws[buf][t_row_off * KDA_D], my_rows * KDA_D);
                    if (step > 0u) {
                        AscendC::DataCopy(wh_f, ointer_ws[buf][t_row_off * KDA_D], my_rows * KDA_D);
                    }
                    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
                    if (step > 0u) {
                        AscendC::Axpy(u_f, wh_f, p.scale, my_rows * KDA_D);
                        AscendC::PipeBarrier<PIPE_V>();
                    }
                    AscendC::Cast(io_bf16, u_f, AscendC::RoundMode::CAST_RINT, my_rows * KDA_D);
                    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
                    kda_copy_tnd_out_bf16(o_gm, io_bf16, t0 + t_row_off, my_rows, h, H);
                    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
                }
                Arch::CrossCoreSetFlag<0x2, PIPE_MTE2>(flag_o_done);
            }
        }
        AscendC::PipeBarrier<PIPE_ALL>();
    }

private:
    Arch::CrossCoreFlag flag_h_ready[2]{{0}, {1}};
    Arch::CrossCoreFlag flag_wh_ready{2};
    Arch::CrossCoreFlag flag_vnew_ready{3};
    Arch::CrossCoreFlag flag_ointer_ready{4};
    Arch::CrossCoreFlag flag_dh_ready{5};
    Arch::CrossCoreFlag flag_ointra_ready{6};
    Arch::CrossCoreFlag flag_o_done{7};
    Arch::Resource<ArchTag> resource;
};

// ===========================================================================
// Kernel 4: Mixed AIC+AIV Reverse-Time ChunkBwdDhu + Fused dAv (100% UB-Resident dh!)
// ===========================================================================
class KdaBwdDhuKernel {
public:
    using ArchTag = Arch::AtlasA2;

    // Per-AIC workspace (320 KiB):
    //   +0      : dh_bf16[0]      [128, 128] bf16 (32 KiB)
    //   +32768  : dh_bf16[1]      [128, 128] bf16 (32 KiB)
    //   +65536  : dv_intra_f32[0] [64, 128]  fp32 (32 KiB)
    //   +98304  : dv_intra_f32[1] [64, 128]  fp32 (32 KiB)
    //   +131072 : dv_inter_f32    [64, 128]  fp32 (32 KiB)
    //   +163840 : dv_tot_bf16     [64, 128]  bf16 (16 KiB)
    //   +180224 : daqk_f32        [64, 64]   fp32 (16 KiB)
    //   +196608 : dh_q_f32        [128, 128] fp32 (64 KiB)
    //   +262144 : dh_w_f32        [128, 128] fp32 (64 KiB)
    //   Total = 327,680 B = 320 KiB per AIC core!
    static constexpr uint64_t WS_ZERO_BYTES = 65536ULL;
    static constexpr uint64_t WS_PER_CORE_BYTES = 327680ULL;

    struct Params {
        uint32_t total_tokens;
        uint32_t heads;
        uint32_t num_docs;
        float scale;
        uint64_t doc_chunks;
        uint64_t chunk_meta;
        uint64_t qg;
        uint64_t kg;
        uint64_t w;
        uint64_t v_new;
        uint64_t aqk;
        uint64_t g_last;
        uint64_t do_in;
        uint64_t h_in;         // [NC, H, 128, 128] bf16
        uint64_t dh_out;       // [NC, H, 128, 128] bf16
        uint64_t dv_out;       // [T, H, 128] bf16
        uint64_t daqk_out;     // [NC, H, 64, 64] fp32 (exact FP32 for HF32 Cube!)
        uint64_t dgk_last_out; // [NC, H, 128] fp32 (fused sum_v(h * dh) * exp(g_last)!)
        uint64_t workspace;
    };

    template<int32_t CORE_TYPE = g_coreType>
    CATLASS_DEVICE void operator()(Params const& p);

    template<>
    CATLASS_DEVICE void operator()<AscendC::AIC>(Params const& p) {
        KdaCubeRunner cube(resource, p.workspace);
        AscendC::GlobalTensor<int32_t> doc_c_gm, meta_gm;
        AscendC::GlobalTensor<bfloat16_t> qg_gm, kg_gm, w_gm, vnew_gm, aqk_gm, do_gm;
        doc_c_gm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(p.doc_chunks));
        meta_gm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(p.chunk_meta));
        qg_gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.qg));
        kg_gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.kg));
        w_gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.w));
        vnew_gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.v_new));
        aqk_gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.aqk));
        do_gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.do_in));

        uint32_t core = AscendC::GetBlockIdx();
        uint32_t cores = AscendC::GetBlockNum();
        uint64_t ws_base = p.workspace + WS_ZERO_BYTES + static_cast<uint64_t>(core) * WS_PER_CORE_BYTES;

        AscendC::GlobalTensor<bfloat16_t> dh_ws[2], dv_tot_ws;
        AscendC::GlobalTensor<float> dv_intra_ws[2], dv_inter_ws, daqk_ws, dh_q_ws, dh_w_ws;
        dh_ws[0].SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(ws_base));
        dh_ws[1].SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(ws_base + 32768ULL));
        dv_intra_ws[0].SetGlobalBuffer(reinterpret_cast<__gm__ float*>(ws_base + 65536ULL));
        dv_intra_ws[1].SetGlobalBuffer(reinterpret_cast<__gm__ float*>(ws_base + 98304ULL));
        dv_inter_ws.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(ws_base + 131072ULL));
        dv_tot_ws.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(ws_base + 163840ULL));
        daqk_ws.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(ws_base + 180224ULL));
        dh_q_ws.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(ws_base + 196608ULL));
        dh_w_ws.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(ws_base + 262144ULL));

        const uint32_t H = p.heads;
        const uint32_t hd = H * KDA_D;
        const uint32_t total_tasks = p.num_docs * H;

        for (uint32_t tid = core; tid < total_tasks; tid += cores) {
            uint32_t doc = tid / H;
            uint32_t h = tid - doc * H;
            uint32_t c_begin = static_cast<uint32_t>(doc_c_gm.GetValue(doc));
            uint32_t c_end = static_cast<uint32_t>(doc_c_gm.GetValue(doc + 1u));
            uint32_t nt = c_end - c_begin;

            for (uint32_t rev = 0u; rev < nt; ++rev) {
                uint32_t step = nt - 1u - rev;
                uint32_t c = c_begin + step;
                uint32_t buf = rev & 1u;
                uint32_t t0 = static_cast<uint32_t>(meta_gm.GetValue(c * 4u + 1u));
                uint32_t L = static_cast<uint32_t>(meta_gm.GetValue(c * 4u + 2u));
                uint64_t t_off = (static_cast<uint64_t>(t0) * H + h) * KDA_D;
                uint64_t aqk_off = (static_cast<uint64_t>(c) * H + h) * 4096ULL;

                // Pin do[t] in L1 + GEMM 1 (dv_intra[buf] = Aqk[t]^T @ do[t]) OVERLAPS with AIV dh_ub(rev-1)!
                cube.pin_b<false>(0u, do_gm[t_off], hd, L, KDA_D);
                cube.pin_a<false>(1u, do_gm[t_off], hd, L, KDA_D);

                cube.gemm_small<true, false, float, false, true>(
                    aqk_gm[aqk_off], KDA_BT, 0u, do_gm[t_off], hd, 0u,
                    dv_intra_ws[buf], KDA_D, L, KDA_D, L, KDA_D, false);

                if (rev > 0u) {
                    Arch::CrossCoreWaitFlag(flag_dh_ready[buf]);
                    // GEMM 2: dv_inter = kg[t] @ dh[t]
                    cube.gemm_small<false, false, float>(
                        kg_gm[t_off], hd, 0u, dh_ws[buf], KDA_D, 0u,
                        dv_inter_ws, KDA_D, L, KDA_D, KDA_D, KDA_D, false);
                }
                Arch::CrossCoreSetFlag<0x2, PIPE_FIX>(flag_dv_parts_ready);

                // GEMM 3 & 4 (overlap 100% with AIV dv_total = dv_intra + dv_inter!):
                // dAqk = do[t] @ v_new[t]^T
                cube.gemm_small<false, true, float, true, false>(
                    do_gm[t_off], hd, 1u, vnew_gm[t_off], hd, 0u,
                    daqk_ws, KDA_BT, L, L, KDA_D, KDA_BT, false);
                Arch::CrossCoreSetFlag<0x2, PIPE_FIX>(flag_daqk_ready);

                if (step > 0u) {
                    // dh_q = qg[t]^T @ do[t]
                    cube.gemm_small<true, false, float, false, true>(
                        qg_gm[t_off], hd, 0u, do_gm[t_off], hd, 0u,
                        dh_q_ws, KDA_D, KDA_D, KDA_D, L, KDA_D, false);
                }

                Arch::CrossCoreWaitFlag(flag_dv_ready);
                if (step > 0u) {
                    // GEMM 5: dh_w = w[t]^T @ dv_total[t]
                    cube.gemm_small<true, false, float>(
                        w_gm[t_off], hd, 0u, dv_tot_ws, KDA_D, 0u,
                        dh_w_ws, KDA_D, KDA_D, KDA_D, L, KDA_D, false);
                    Arch::CrossCoreSetFlag<0x2, PIPE_FIX>(flag_dh_upd_ready);
                } else {
                    // Wait ONLY at end-of-doc (step == 0): zero mid-doc step_done stall!
                    Arch::CrossCoreWaitFlag(flag_step_done);
                }
            }
        }
        AscendC::PipeBarrier<PIPE_ALL>();
    }

    template<>
    CATLASS_DEVICE void operator()<AscendC::AIV>(Params const& p) {
        uint32_t subblocks = AscendC::GetSubBlockNum();
        uint32_t sub_idx = AscendC::GetSubBlockIdx();
        uint32_t core = AscendC::GetBlockIdx() / subblocks;
        uint32_t cores = AscendC::GetBlockNum();
        uint64_t ws_base = p.workspace + WS_ZERO_BYTES + static_cast<uint64_t>(core) * WS_PER_CORE_BYTES;

        AscendC::GlobalTensor<int32_t> doc_c_gm, meta_gm;
        AscendC::GlobalTensor<bfloat16_t> h_in_gm, dh_out_gm, dv_out_gm;
        AscendC::GlobalTensor<float> g_last_gm, daqk_out_gm, dgk_last_out_gm;
        doc_c_gm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(p.doc_chunks));
        meta_gm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(p.chunk_meta));
        h_in_gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.h_in));
        dh_out_gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.dh_out));
        dv_out_gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.dv_out));
        daqk_out_gm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(p.daqk_out));
        dgk_last_out_gm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(p.dgk_last_out));
        g_last_gm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(p.g_last));

        AscendC::GlobalTensor<bfloat16_t> dh_ws[2], dv_tot_ws;
        AscendC::GlobalTensor<float> dv_intra_ws[2], dv_inter_ws, daqk_ws, dh_q_ws, dh_w_ws;
        dh_ws[0].SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(ws_base));
        dh_ws[1].SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(ws_base + 32768ULL));
        dv_intra_ws[0].SetGlobalBuffer(reinterpret_cast<__gm__ float*>(ws_base + 65536ULL));
        dv_intra_ws[1].SetGlobalBuffer(reinterpret_cast<__gm__ float*>(ws_base + 98304ULL));
        dv_inter_ws.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(ws_base + 131072ULL));
        dv_tot_ws.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(ws_base + 163840ULL));
        daqk_ws.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(ws_base + 180224ULL));
        dh_q_ws.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(ws_base + 196608ULL));
        dh_w_ws.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(ws_base + 262144ULL));

        // UB layout (178.5 KiB <= 192 KiB):
        auto dh_ub = resource.ubBuf.template GetBufferByByte<float>(0);             // 32 KiB [64, 128]
        auto tmp1_64 = resource.ubBuf.template GetBufferByByte<float>(32768);       // 32 KiB [64, 128]
        auto tmp2_64 = resource.ubBuf.template GetBufferByByte<float>(65536);       // 32 KiB [64, 128]
        auto dh_bf16 = resource.ubBuf.template GetBufferByByte<bfloat16_t>(98304);  // 16 KiB [64, 128]
        auto dv1_f = resource.ubBuf.template GetBufferByByte<float>(114688);        // 16 KiB [32, 128]
        auto dv2_f = resource.ubBuf.template GetBufferByByte<float>(131072);        // 16 KiB [32, 128]
        auto dv_bf16 = resource.ubBuf.template GetBufferByByte<bfloat16_t>(147456); // 8 KiB  [32, 128]
        auto daqk_ub = resource.ubBuf.template GetBufferByByte<float>(155648);      // 8 KiB  [32, 64]
        auto daqk_tril = resource.ubBuf.template GetBufferByByte<float>(163840);    // 8 KiB  [32, 64] static tril!
        auto g_sub = resource.ubBuf.template GetBufferByByte<float>(172032);        // 256 B  [64]
        auto dgk_sub = resource.ubBuf.template GetBufferByByte<float>(172288);      // 256 B  [64]
        auto brc_512 = resource.ubBuf.template GetBufferByByte<float>(172544);      // 2 KiB  [512]
        auto red_part = resource.ubBuf.template GetBufferByByte<float>(174592);     // 2 KiB  [512]

        const uint32_t H = p.heads;
        const uint32_t total_tasks = p.num_docs * H;
        const uint32_t h_row_off = sub_idx * 64u;
        const uint32_t t_row_off = sub_idx * 32u;

        // Precompute static tril(0) mask for sub_idx's 32 rows (ZERO SetVectorMask loop!)
        AscendC::Duplicate(daqk_tril, 0.0f, 32u * KDA_BT);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::SetFlag<AscendC::HardEvent::V_S>(EVENT_ID1);
        AscendC::WaitFlag<AscendC::HardEvent::V_S>(EVENT_ID1);
        for (uint32_t r = 0u; r < 32u; ++r) {
            uint32_t gr = t_row_off + r;
            for (uint32_t col = 0u; col <= gr; ++col) {
                daqk_tril.SetValue(r * KDA_BT + col, 1.0f);
            }
        }
        AscendC::SetFlag<AscendC::HardEvent::S_V>(EVENT_ID1);
        AscendC::WaitFlag<AscendC::HardEvent::S_V>(EVENT_ID1);

        for (uint32_t tid = core; tid < total_tasks; tid += cores) {
            uint32_t doc = tid / H;
            uint32_t h = tid - doc * H;
            uint32_t c_begin = static_cast<uint32_t>(doc_c_gm.GetValue(doc));
            uint32_t c_end = static_cast<uint32_t>(doc_c_gm.GetValue(doc + 1u));
            uint32_t nt = c_end - c_begin;

            AscendC::Duplicate(dh_ub, 0.0f, 64u * KDA_D);
            AscendC::PipeBarrier<PIPE_V>();

            for (uint32_t rev = 0u; rev < nt; ++rev) {
                uint32_t step = nt - 1u - rev;
                uint32_t c = c_begin + step;
                uint32_t buf = rev & 1u;
                uint32_t nbuf = (rev + 1u) & 1u;
                uint32_t t0 = static_cast<uint32_t>(meta_gm.GetValue(c * 4u + 1u));
                uint32_t L = static_cast<uint32_t>(meta_gm.GetValue(c * 4u + 2u));
                uint32_t my_rows = (L > t_row_off) ? ((L - t_row_off < 32u) ? (L - t_row_off) : 32u) : 0u;
                uint64_t dh_off = ((static_cast<uint64_t>(c) * H + h) * KDA_D + h_row_off) * KDA_D;
                uint64_t gl_off = (static_cast<uint64_t>(c) * H + h) * KDA_D + h_row_off;

                // 1. Overlapped with AIC GEMM 1 (dv_intra) + GEMM 2 (dv_inter): fused dgk_last_h (dh_out_gm[c] for rev>0 already written!)
                {
                    if (rev == 0u) {
                        AscendC::Cast(dh_bf16, dh_ub, AscendC::RoundMode::CAST_RINT, 64u * KDA_D);
                        AscendC::Duplicate(dgk_sub, 0.0f, 64u);
                        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID1);
                        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID1);
                        AscendC::DataCopy(dh_out_gm[dh_off], dh_bf16, 64u * KDA_D);
                        AscendC::DataCopy(dgk_last_out_gm[gl_off], dgk_sub, 64u);
                        AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID1);
                        AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID1);
                    } else {
                        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID1);
                        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID1);
                        AscendC::DataCopy(dh_bf16, h_in_gm[dh_off], 64u * KDA_D);
                        AscendC::DataCopy(g_sub, g_last_gm[gl_off], 64u);
                        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID1);
                        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID1);
                        AscendC::Cast(tmp1_64, dh_bf16, AscendC::RoundMode::CAST_NONE, 64u * KDA_D);
                        AscendC::Exp(g_sub, g_sub, 64u);  // reused in Step 3!
                        AscendC::PipeBarrier<PIPE_V>();
                        AscendC::Mul(tmp1_64, tmp1_64, dh_ub, 64u * KDA_D);
                        AscendC::PipeBarrier<PIPE_V>();
                        kda_rowsum_128(dgk_sub, tmp1_64, red_part, 64u);
                        AscendC::Mul(dgk_sub, dgk_sub, g_sub, 64u);
                        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID1);
                        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID1);
                        AscendC::DataCopy(dgk_last_out_gm[gl_off], dgk_sub, 64u);
                        AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID1);
                        AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID1);
                    }
                }

                // 2. dv_total = dv_intra[buf] + (rev > 0 ? dv_inter : 0) -> unblock AIC GEMM 5!
                Arch::CrossCoreWaitFlag(flag_dv_parts_ready);
                if (my_rows > 0u) {
                    AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
                    AscendC::DataCopy(dv1_f, dv_intra_ws[buf][t_row_off * KDA_D], my_rows * KDA_D);
                    if (rev > 0u) {
                        AscendC::DataCopy(dv2_f, dv_inter_ws[t_row_off * KDA_D], my_rows * KDA_D);
                    }
                    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
                    if (rev > 0u) {
                        AscendC::Add(dv1_f, dv1_f, dv2_f, my_rows * KDA_D);
                        AscendC::PipeBarrier<PIPE_V>();
                    }
                    AscendC::Cast(dv_bf16, dv1_f, AscendC::RoundMode::CAST_RINT, my_rows * KDA_D);
                    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
                    AscendC::DataCopy(dv_tot_ws[t_row_off * KDA_D], dv_bf16, my_rows * KDA_D);
                    kda_copy_tnd_out_bf16(dv_out_gm, dv_bf16, t0 + t_row_off, my_rows, h, H);
                    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
                }
                Arch::CrossCoreSetFlag<0x2, PIPE_MTE3>(flag_dv_ready);

                // Mask lower-triangular dAqk (i >= j) * scale -> write EXACT FP32 daqk_out_gm (ZERO Cast!)
                Arch::CrossCoreWaitFlag(flag_daqk_ready);
                {
                    AscendC::Duplicate(daqk_ub, 0.0f, 32u * KDA_BT);
                    AscendC::PipeBarrier<PIPE_V>();
                    if (my_rows > 0u) {
                        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
                        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
                        AscendC::DataCopy(daqk_ub, daqk_ws[t_row_off * KDA_BT], my_rows * KDA_BT);
                        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
                        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
                        AscendC::Mul(daqk_ub, daqk_ub, daqk_tril, my_rows * KDA_BT);
                        AscendC::PipeBarrier<PIPE_V>();
                        AscendC::Muls(daqk_ub, daqk_ub, p.scale, my_rows * KDA_BT);
                        AscendC::PipeBarrier<PIPE_V>();
                    }
                    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
                    uint64_t d_off = (static_cast<uint64_t>(c) * H + h) * 4096ULL + t_row_off * KDA_BT;
                    AscendC::DataCopy(daqk_out_gm[d_off], daqk_ub, 32u * KDA_BT);
                    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
                }

                // 3. Update dh_ub = dh_ub * exp(g_last[t]) + scale * dh_q - dh_w -> write BOTH dh_ws[nbuf] & dh_out_gm[c-1]!
                if (step > 0u) {
                    if (rev > 0u) {
                        kda_mul_row_vec_128(dh_ub, g_sub, brc_512, 64u);
                    }
                    Arch::CrossCoreWaitFlag(flag_dh_upd_ready);
                    AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID1);
                    AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID1);
                    AscendC::DataCopy(tmp1_64, dh_q_ws[h_row_off * KDA_D], 64u * KDA_D);
                    AscendC::DataCopy(tmp2_64, dh_w_ws[h_row_off * KDA_D], 64u * KDA_D);
                    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID1);
                    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID1);
                    AscendC::Axpy(dh_ub, tmp1_64, p.scale, 64u * KDA_D);
                    AscendC::PipeBarrier<PIPE_V>();
                    AscendC::Sub(dh_ub, dh_ub, tmp2_64, 64u * KDA_D);
                    AscendC::PipeBarrier<PIPE_V>();
                    AscendC::Cast(dh_bf16, dh_ub, AscendC::RoundMode::CAST_RINT, 64u * KDA_D);
                    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID1);
                    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID1);
                    uint64_t dh_prev_off = ((static_cast<uint64_t>(c - 1u) * H + h) * KDA_D + h_row_off) * KDA_D;
                    AscendC::DataCopy(dh_ws[nbuf][h_row_off * KDA_D], dh_bf16, 64u * KDA_D);
                    Arch::CrossCoreSetFlag<0x2, PIPE_MTE3>(flag_dh_ready[nbuf]);
                    AscendC::DataCopy(dh_out_gm[dh_prev_off], dh_bf16, 64u * KDA_D);
                    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID1);
                    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID1);
                    AscendC::SetFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID1);
                    AscendC::WaitFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID1);
                } else {
                    Arch::CrossCoreSetFlag<0x2, PIPE_MTE2>(flag_step_done);
                }
            }
        }
        AscendC::PipeBarrier<PIPE_ALL>();
    }

private:
    Arch::CrossCoreFlag flag_dh_ready[2]{{0}, {1}};
    Arch::CrossCoreFlag flag_dv_parts_ready{2};
    Arch::CrossCoreFlag flag_dv_ready{3};
    Arch::CrossCoreFlag flag_daqk_ready{4};
    Arch::CrossCoreFlag flag_dh_upd_ready{5};
    Arch::CrossCoreFlag flag_step_done{6};
    Arch::Resource<ArchTag> resource;
};

__aicore__ inline void kda_flush_head_accum(
    uint32_t prev_h, uint32_t core, uint32_t H, float dalog_acc,
    AscendC::LocalTensor<float> const& row_dot,
    AscendC::LocalTensor<float> const& ddtb_acc,
    AscendC::GlobalTensor<float> const& dalog_part_gm,
    AscendC::GlobalTensor<float> const& ddtb_part_gm) {
    if (prev_h == 0xffffffffu) return;
    row_dot.SetValue(0, dalog_acc);
    AscendC::SetFlag<AscendC::HardEvent::S_MTE3>(EVENT_ID2);
    AscendC::WaitFlag<AscendC::HardEvent::S_MTE3>(EVENT_ID2);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID2);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID2);
    AscendC::DataCopyPad(
        dalog_part_gm[static_cast<uint64_t>(core) * H + prev_h], row_dot,
        AscendC::DataCopyExtParams{1, 4u, 0, 0, 0});
    AscendC::DataCopy(ddtb_part_gm[(static_cast<uint64_t>(core) * H + prev_h) * KDA_D], ddtb_acc, KDA_D);
    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID2);
    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID2);
    AscendC::SetFlag<AscendC::HardEvent::MTE3_S>(EVENT_ID2);
    AscendC::WaitFlag<AscendC::HardEvent::MTE3_S>(EVENT_ID2);
}

// ===========================================================================
// Kernel 5 (v5.2): Packed 14-GEMM HF32-Cube + 1-Step-Delayed Software-Pipelined Backward Finalize
//   - Packs M = [dAqk; -dAkk] ([32, K]) -> cuts Phase 4 from 28 MMADs + 7 pins -> 14 HF32 GEMMs/slot
//     and lifts row-side M=16 -> M=32 (>= PIPE_M_BARRIER_THRESHOLD, eliminating Cube pipeline flushes!)
//   - 1-Step-Delayed Software Pipelining across 2 epochs (`ep = iter & 1`, 8 flags `0..7` exact):
//     AIV executes Merge+Epilogue(iter-1) 100% IN PARALLEL with AIC Phase 4(iter)!
//   - Exact FP32 daqk + fused dgk_last_h from KdaBwdDhu (eliminates 262 MB h/dh reads!)
//   - Zero SetVectorMask scalar loops (1 KiB precomputed tril16_strict) + zero redundant Exp in merge!
// ===========================================================================
class KdaBwdFinalizeKernel {
public:
    using ArchTag = Arch::AtlasA2;

    // Per-slot workspace (686,080 B = 670 KiB), x4 slots/core = 2.62 MiB/core (~62.8 MiB chip-wide, 33% of L2!):
    //   +0      : dq_ws         [64, 128] fp32 (32 KiB) - live from Phase 1 until Merge (ZERO spill/reload!)
    //   +32768  : dk_ws         [64, 128] fp32 (32 KiB) - live from Phase 1 until Merge (ZERO spill/reload!)
    //   +65536  : dkgb_ws       [64, 128] fp32 (32 KiB) - live from Phase 1 until Merge (ZERO spill/reload!)
    //   +98304  : off_row_out   [3,32,128]fp32 (48 KiB) - Phase 1..2 aliases dvb_ws(32K) + da_ws(16K)
    //   +147456 : off_col_ws    [96, 128] fp32 (48 KiB) - Phase 1..2 aliases dw_bf(16K), kg0_bf(16K), da_bf(8K), da_tmp_bf(8K)
    //   +196608 : q_hat_ws      [64, 128] bf16 (16 KiB)
    //   +212992 : k_hat_ws      [64, 128] bf16 (16 KiB)
    //   +229376 : packed_m_off  [3072]    fp32 (12 KiB: sr=1 [32,16], sr=2 [32,32], sr=3 [32,48])
    //   +241664 : packed_m_diag [2048]    fp32 (8 KiB:  4x [32,16])
    //   +249856 : off_k_f32     [96, 128] fp32 (48 KiB: K_prev for sr=1,2,3)
    //   +299008 : off_q_f32     [96, 128] fp32 (48 KiB: 3x [Q_row(16); KB_row(16)])
    //   +348160 : diag_ki_f32   [64, 128] fp32 (32 KiB: 4x KI_mid(16))
    //   +380928 : diag_qkb_f32  [128,128] fp32 (64 KiB: 4x [Q_mid(16); KB_mid(16)])
    //   +446464 : diag_es_ws    [64, 128] fp32 (32 KiB)
    //   +479232 : diag_er_ws    [64, 128] fp32 (32 KiB)
    //   +512000 : off_er_row    [48, 128] fp32 (24 KiB)
    //   +536576 : off_er_col    [96, 128] fp32 (48 KiB)
    //   +585728 : diag_row_out  [4,32,128]fp32 (64 KiB)
    //   +651264 : diag_col_out  [4,16,128]fp32 (32 KiB)
    //   +684032 : save_vecs     [448]     fp32 (1792 B -> +2048 -> 686,080 B = 670 KiB!)
    static constexpr uint64_t WS_ZERO_BYTES = 65536ULL;
    static constexpr uint64_t WS_SLOT_BYTES = 686080ULL;
    static constexpr uint64_t WS_PER_CORE_BYTES = 4ULL * WS_SLOT_BYTES;

    struct Params {
        uint32_t total_tokens;
        uint32_t heads;
        uint32_t num_chunks;
        float scale;
        float lower_bound;
        uint64_t chunk_meta;
        uint64_t q_hat;
        uint64_t k_hat;
        uint64_t v_raw;
        uint64_t v_new;
        uint64_t a_raw;
        uint64_t gk;
        uint64_t g_last;
        uint64_t beta_eff;
        uint64_t q_rstd;
        uint64_t k_rstd;
        uint64_t a_log;
        uint64_t dt_bias;
        uint64_t akk_inv;
        uint64_t h;
        uint64_t dh;
        uint64_t do_in;
        uint64_t dv_in;
        uint64_t daqk_in;     // [NC, H, 64, 64] fp32
        uint64_t dgk_last_in; // [NC, H, 128] fp32
        uint64_t dq_out;
        uint64_t dk_out;
        uint64_t dv_out;
        uint64_t da_out;
        uint64_t dbeta_out;
        uint64_t da_log_part;
        uint64_t ddt_bias_part;
        uint64_t workspace;
    };

    struct SlotGm {
        AscendC::GlobalTensor<float> dq_ws, dk_ws, dkgb_ws, dvb_ws, da_ws, off_row_out, off_col_ws;
        AscendC::GlobalTensor<bfloat16_t> dw_bf_ws, kg0_bf_ws, da_bf_ws, da_tmp_bf_ws, q_hat_ws, k_hat_ws;
        AscendC::GlobalTensor<float> packed_m_off, packed_m_diag, off_k_f32, off_q_f32, diag_ki_f32, diag_qkb_f32;
        AscendC::GlobalTensor<float> diag_es_ws, diag_er_ws, off_er_row, off_er_col;
        AscendC::GlobalTensor<float> diag_row_out, diag_col_out, save_vecs;

        CATLASS_DEVICE void bind(uint64_t base) {
            dq_ws.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(base + 0ULL));
            dk_ws.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(base + 32768ULL));
            dkgb_ws.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(base + 65536ULL));
            dvb_ws.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(base + 98304ULL));
            da_ws.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(base + 131072ULL));
            off_row_out.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(base + 98304ULL));
            off_col_ws.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(base + 147456ULL));
            dw_bf_ws.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(base + 147456ULL));
            kg0_bf_ws.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(base + 163840ULL));
            da_bf_ws.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(base + 180224ULL));
            da_tmp_bf_ws.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(base + 188416ULL));
            q_hat_ws.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(base + 196608ULL));
            k_hat_ws.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(base + 212992ULL));
            packed_m_off.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(base + 229376ULL));
            packed_m_diag.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(base + 241664ULL));
            off_k_f32.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(base + 249856ULL));
            off_q_f32.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(base + 299008ULL));
            diag_ki_f32.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(base + 348160ULL));
            diag_qkb_f32.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(base + 380928ULL));
            diag_es_ws.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(base + 446464ULL));
            diag_er_ws.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(base + 479232ULL));
            off_er_row.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(base + 512000ULL));
            off_er_col.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(base + 536576ULL));
            diag_row_out.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(base + 585728ULL));
            diag_col_out.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(base + 651264ULL));
            save_vecs.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(base + 684032ULL));
        }
    };

    template<int32_t CORE_TYPE = g_coreType>
    CATLASS_DEVICE void operator()(Params const& p);

    template<>
    CATLASS_DEVICE void operator()<AscendC::AIC>(Params const& p) {
        KdaCubeRunner cube(resource, p.workspace);
        AscendC::GlobalTensor<int32_t> meta_gm;
        AscendC::GlobalTensor<bfloat16_t> v_gm, vnew_gm, akk_inv_gm, h_gm, dh_gm, do_gm, dv_gm;
        meta_gm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(p.chunk_meta));
        v_gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.v_raw));
        vnew_gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.v_new));
        akk_inv_gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.akk_inv));
        h_gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.h));
        dh_gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.dh));
        do_gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.do_in));
        dv_gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.dv_in));

        const uint32_t core = AscendC::GetBlockIdx();
        const uint32_t cores = AscendC::GetBlockNum();
        const uint64_t ws_core = p.workspace + WS_ZERO_BYTES + static_cast<uint64_t>(core) * WS_PER_CORE_BYTES;
        const uint32_t H = p.heads;
        const uint32_t hd = H * KDA_D;
        const uint32_t total_tasks = p.num_chunks * H;
        const uint32_t num_pairs = (total_tasks + 1u) / 2u;
        const uint32_t base_p = num_pairs / cores;
        const uint32_t rem_p = num_pairs - base_p * cores;
        const uint32_t p_begin = core * base_p + (core < rem_p ? core : rem_p);
        const uint32_t p_cnt = base_p + (core < rem_p ? 1u : 0u);

        SlotGm slot[2];

        for (uint32_t iter = 0u; iter < p_cnt; ++iter) {
            const uint32_t ep = iter & 1u;
            // Before reusing slot[ep] from (iter - 2), wait for AIV Epilogue(iter - 2) to finish!
            if (iter >= 2u) {
                Arch::CrossCoreWaitFlag(flag_ep_done);
            }

            uint32_t L_s[2] = {0u, 0u};
            uint64_t t_off_s[2] = {0ULL, 0ULL};
            uint64_t m_off_s[2] = {0ULL, 0ULL};
            uint64_t s_off_s[2] = {0ULL, 0ULL};
            bool valid_s[2] = {false, false};

            for (uint32_t s = 0u; s < 2u; ++s) {
                slot[s].bind(ws_core + static_cast<uint64_t>(ep * 2u + s) * WS_SLOT_BYTES);
                uint32_t tid = (p_begin + iter) * 2u + s;
                if (tid < total_tasks) {
                    uint32_t h = tid / p.num_chunks;
                    uint32_t c = tid - h * p.num_chunks;
                    uint32_t t0 = static_cast<uint32_t>(meta_gm.GetValue(c * 4u + 1u));
                    uint32_t L = static_cast<uint32_t>(meta_gm.GetValue(c * 4u + 2u));
                    if (L > 0u) {
                        valid_s[s] = true;
                        L_s[s] = L;
                        t_off_s[s] = (static_cast<uint64_t>(t0) * H + h) * KDA_D;
                        m_off_s[s] = (static_cast<uint64_t>(c) * H + h) * 4096ULL;
                        s_off_s[s] = (static_cast<uint64_t>(c) * H + h) * 16384ULL;
                    }
                }
            }

            // Phase 1a (overlapped 100% with AIV Phase 0 + Anchor Prep!):
            //   Write dw_bf_ws DIRECTLY as BF16 via FixPipe -> eliminates Phase 2 roundtrip completely!
            for (uint32_t s = 0u; s < 2u; ++s) {
                if (!valid_s[s]) continue;
                uint32_t L = L_s[s];
                uint32_t akk_pin = 1u + s;
                cube.pin_b<true>(0u, h_gm[s_off_s[s]], KDA_D, KDA_D, KDA_D);
                cube.pin_a<true>(akk_pin, akk_inv_gm[m_off_s[s]], KDA_BT, L, L);
                cube.gemm_small<false, true, float, false, true>(
                    do_gm[t_off_s[s]], hd, 0u, h_gm[s_off_s[s]], KDA_D, 0u,
                    slot[s].dq_ws, KDA_D, L, KDA_D, KDA_D, KDA_D, false);
                cube.gemm_small<false, true, bfloat16_t, false, true>(
                    dv_gm[t_off_s[s]], hd, 0u, h_gm[s_off_s[s]], KDA_D, 0u,
                    slot[s].dw_bf_ws, KDA_D, L, KDA_D, KDA_D, KDA_D, false);
                cube.gemm_small<false, true, float>(
                    vnew_gm[t_off_s[s]], hd, 0u, dh_gm[s_off_s[s]], KDA_D, 0u,
                    slot[s].dk_ws, KDA_D, L, KDA_D, KDA_D, KDA_D, false);
                cube.gemm_small<true, false, float, true, false>(
                    akk_inv_gm[m_off_s[s]], KDA_BT, akk_pin, dv_gm[t_off_s[s]], hd, 0u,
                    slot[s].dvb_ws, KDA_D, L, KDA_D, L, KDA_D, false);
                cube.gemm_small<false, true, float>(
                    dv_gm[t_off_s[s]], hd, 0u, v_gm[t_off_s[s]], hd, 0u,
                    slot[s].da_ws, KDA_BT, L, L, KDA_D, KDA_BT, false);
            }
            AscendC::PipeBarrier<PIPE_ALL>();

            // Phase 1b: Wait for AIV Phase 0 kg0_bf_ws = bf16(-k_hat * exp(gk)) -> finish dkgb_ws & dA!
            Arch::CrossCoreWaitFlag(flag_kg0_ready);
            for (uint32_t s = 0u; s < 2u; ++s) {
                if (!valid_s[s]) continue;
                uint32_t L = L_s[s];
                uint32_t akk_pin = 1u + s;
                cube.gemm_small<true, false, float, true, false>(
                    akk_inv_gm[m_off_s[s]], KDA_BT, akk_pin, slot[s].dw_bf_ws, KDA_D, 0u,
                    slot[s].dkgb_ws, KDA_D, L, KDA_D, L, KDA_D, false);
                cube.gemm_small<false, true, float>(
                    slot[s].dw_bf_ws, KDA_D, 0u, slot[s].kg0_bf_ws, KDA_D, 0u,
                    slot[s].da_ws, KDA_BT, L, L, KDA_D, KDA_BT, true);
            }
            Arch::CrossCoreSetFlag<0x2, PIPE_FIX>(flag_p1_ready);

            // Phase 2: Wait for AIV masked dA_bf -> dAkk = Akk_inv^T @ (dA_bf @ Akk_inv^T) into da_ws
            Arch::CrossCoreWaitFlag(flag_da_ready);
            for (uint32_t s = 0u; s < 2u; ++s) {
                if (!valid_s[s]) continue;
                uint32_t L = L_s[s];
                cube.gemm_small<false, true, bfloat16_t>(
                    slot[s].da_bf_ws, KDA_BT, 0u, akk_inv_gm[m_off_s[s]], KDA_BT, 0u,
                    slot[s].da_tmp_bf_ws, KDA_BT, L, L, L, KDA_BT, false);
            }
            AscendC::PipeBarrier<PIPE_ALL>();
            for (uint32_t s = 0u; s < 2u; ++s) {
                if (!valid_s[s]) continue;
                uint32_t L = L_s[s];
                uint32_t akk_pin = 1u + s;
                cube.gemm_small<true, false, float, true, false>(
                    akk_inv_gm[m_off_s[s]], KDA_BT, akk_pin, slot[s].da_tmp_bf_ws, KDA_BT, 0u,
                    slot[s].da_ws, KDA_BT, L, L, L, KDA_BT, false);
            }
            Arch::CrossCoreSetFlag<0x2, PIPE_FIX>(flag_dakk_ready);

            // Phase 3: 14 PACKED HF32 GEMMs/slot -> 100% OVERLAPPED with AIV Merge + Epilogue(iter - 1)!
            //   Leaves dq_ws, dk_ws, dkgb_ws untouched -> ZERO 96 KiB spill/reload!
            Arch::CrossCoreWaitFlag(flag_intra_ready);
            for (uint32_t s = 0u; s < 2u; ++s) {
                if (!valid_s[s]) continue;
                uint32_t L = L_s[s];

                // 3a. Off-diag (sr = 1, 2, 3): 6 packed HF32 GEMMs (all dims exact multiples of 16!)
                if (L > 16u) {
                    for (uint32_t sr = 1u; sr <= 3u; ++sr) {
                        uint32_t r0 = sr * 16u;
                        if (r0 >= L) break;
                        uint32_t m_off_sr = (sr == 1u) ? 0u : ((sr == 2u) ? 512u : 1536u);
                        uint32_t kp_off = (sr == 1u) ? 0u : ((sr == 2u) ? (16u * KDA_D) : (48u * KDA_D));
                        uint32_t row_out_off = (sr - 1u) * 32u * KDA_D;
                        cube.gemm_f32<false, false, float>(
                            slot[s].packed_m_off[m_off_sr], r0,
                            slot[s].off_k_f32[kp_off], KDA_D, 0u,
                            slot[s].off_row_out[row_out_off], KDA_D, 32u, KDA_D, r0);
                        cube.gemm_f32<true, false, float>(
                            slot[s].packed_m_off[m_off_sr], r0,
                            slot[s].off_q_f32[(sr - 1u) * 32u * KDA_D], KDA_D, 0u,
                            slot[s].off_col_ws[kp_off], KDA_D, r0, KDA_D, 32u);
                    }
                }

                // 3b. 4x16x16 Diagonal (d = 0..3): 8 packed HF32 GEMMs (all dims exact multiples of 16!)
                for (uint32_t d = 0u; d < 4u; ++d) {
                    uint32_t s_base = d * 16u;
                    if (s_base + 1u >= L) break;
                    cube.gemm_f32<false, false, float>(
                        slot[s].packed_m_diag[d * 512u], 16u,
                        slot[s].diag_ki_f32[s_base * KDA_D], KDA_D, 0u,
                        slot[s].diag_row_out[d * 32u * KDA_D], KDA_D, 32u, KDA_D, 16u);
                    cube.gemm_f32<true, false, float>(
                        slot[s].packed_m_diag[d * 512u], 16u,
                        slot[s].diag_qkb_f32[d * 32u * KDA_D], KDA_D, 0u,
                        slot[s].diag_col_out[s_base * KDA_D], KDA_D, 16u, KDA_D, 32u);
                }
            }
            Arch::CrossCoreSetFlag<0x2, PIPE_FIX>(flag_p4_ready);
        }
        AscendC::PipeBarrier<PIPE_ALL>();
    }

    template<>
    CATLASS_DEVICE void operator()<AscendC::AIV>(Params const& p) {
        const uint32_t subblocks = AscendC::GetSubBlockNum();
        const uint32_t sub_idx = AscendC::GetSubBlockIdx();
        const uint32_t core = AscendC::GetBlockIdx() / subblocks;
        const uint32_t cores = AscendC::GetBlockNum();
        const uint32_t vid = core * 2u + sub_idx;
        const uint64_t ws_core = p.workspace + WS_ZERO_BYTES + static_cast<uint64_t>(core) * WS_PER_CORE_BYTES;

        AscendC::GlobalTensor<int32_t> meta_gm;
        AscendC::GlobalTensor<bfloat16_t> q_hat_gm, k_hat_gm, v_gm, a_gm;
        AscendC::GlobalTensor<bfloat16_t> dq_out_gm, dk_out_gm, dv_out_gm, da_out_gm;
        AscendC::GlobalTensor<float> gk_gm, g_last_gm, beta_gm, qr_gm, kr_gm, alog_gm, dtb_gm;
        AscendC::GlobalTensor<float> daqk_gm, dgk_last_in_gm, db_out_gm, dalog_part_gm, ddtb_part_gm;

        meta_gm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(p.chunk_meta));
        q_hat_gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.q_hat));
        k_hat_gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.k_hat));
        v_gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.v_raw));
        a_gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.a_raw));
        gk_gm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(p.gk));
        g_last_gm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(p.g_last));
        beta_gm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(p.beta_eff));
        qr_gm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(p.q_rstd));
        kr_gm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(p.k_rstd));
        alog_gm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(p.a_log));
        dtb_gm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(p.dt_bias));
        daqk_gm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(p.daqk_in));
        dgk_last_in_gm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(p.dgk_last_in));

        dq_out_gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.dq_out));
        dk_out_gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.dk_out));
        dv_out_gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.dv_out));
        da_out_gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.da_out));
        db_out_gm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(p.dbeta_out));
        dalog_part_gm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(p.da_log_part));
        ddtb_part_gm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(p.ddt_bias_part));

        const uint32_t H = p.heads;
        const uint32_t total_tasks = p.num_chunks * H;
        const uint32_t num_pairs = (total_tasks + 1u) / 2u;
        const uint32_t base_p = num_pairs / cores;
        const uint32_t rem_p = num_pairs - base_p * cores;
        const uint32_t p_begin = core * base_p + (core < rem_p ? core : rem_p);
        const uint32_t p_cnt = base_p + (core < rem_p ? 1u : 0u);

        // UB layout (193,024 B = 188.5 KiB <= 192 KiB):
        auto dq_acc = resource.ubBuf.template GetBufferByByte<float>(0);
        auto dk_neg_acc = resource.ubBuf.template GetBufferByByte<float>(32768);
        auto dk_pos_acc = resource.ubBuf.template GetBufferByByte<float>(65536);
        auto g_f = resource.ubBuf.template GetBufferByByte<float>(98304);
        auto tmp_f = resource.ubBuf.template GetBufferByByte<float>(131072);
        auto io_bf16 = resource.ubBuf.template GetBufferByByte<bfloat16_t>(163840);
        auto io_f = resource.ubBuf.template GetBufferByByte<float>(163840);
        auto dt_bias_f = resource.ubBuf.template GetBufferByByte<float>(180224);
        auto g_last_f = resource.ubBuf.template GetBufferByByte<float>(180736);
        auto dgk_last = resource.ubBuf.template GetBufferByByte<float>(181248);
        auto ddtb_acc = resource.ubBuf.template GetBufferByByte<float>(181760);
        auto beta_f = resource.ubBuf.template GetBufferByByte<float>(182272);
        auto db_acc = resource.ubBuf.template GetBufferByByte<float>(182528);
        auto rstd_f = resource.ubBuf.template GetBufferByByte<float>(182784);
        auto row_dot = resource.ubBuf.template GetBufferByByte<float>(183040);
        auto brc_512 = resource.ubBuf.template GetBufferByByte<float>(183296);
        auto red_part = resource.ubBuf.template GetBufferByByte<float>(185344);
        auto ones_128 = resource.ubBuf.template GetBufferByByte<float>(187392);
        auto mat_f = resource.ubBuf.template GetBufferByByte<float>(187904);          // 4 KiB [16, 64]
        auto tril16_strict = resource.ubBuf.template GetBufferByByte<float>(192000);  // 1 KiB [16, 16]

        AscendC::Duplicate(ones_128, 1.0f, 128u);
        AscendC::Duplicate(tril16_strict, 0.0f, 256u);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::SetFlag<AscendC::HardEvent::V_S>(EVENT_ID1);
        AscendC::WaitFlag<AscendC::HardEvent::V_S>(EVENT_ID1);
        for (uint32_t r = 0u; r < 16u; ++r) {
            for (uint32_t col = 0u; col < r; ++col) {
                tril16_strict.SetValue(r * 16u + col, 1.0f);
            }
        }
        AscendC::SetFlag<AscendC::HardEvent::S_V>(EVENT_ID1);
        AscendC::WaitFlag<AscendC::HardEvent::S_V>(EVENT_ID1);

        uint32_t cached_h = 0xffffffffu;
        float cached_a_exp = 1.0f;
        float dalog_acc = 0.0f;

        SlotGm sl_arr[2];
        sl_arr[0].bind(ws_core + static_cast<uint64_t>(sub_idx) * WS_SLOT_BYTES);
        sl_arr[1].bind(ws_core + static_cast<uint64_t>(2u + sub_idx) * WS_SLOT_BYTES);

        bool prev_valid = false;
        uint32_t prev_h = 0u, prev_t0 = 0u, prev_L = 0u;
        const uint32_t total_iters = (p_cnt > 0u) ? (p_cnt + 1u) : 0u;

        for (uint32_t iter = 0u; iter < total_iters; ++iter) {
            uint32_t h = 0u, c = 0u, t0 = 0u, L = 0u, elems = 0u;
            uint64_t m_off = 0ULL;
            bool valid = false;

            if (iter < p_cnt) {
                const uint32_t ep = iter & 1u;
                SlotGm& sl = sl_arr[ep];
                const uint32_t tid = (p_begin + iter) * 2u + sub_idx;

                if (tid < total_tasks) {
                    h = tid / p.num_chunks;
                    c = tid - h * p.num_chunks;
                    t0 = static_cast<uint32_t>(meta_gm.GetValue(c * 4u + 1u));
                    L = static_cast<uint32_t>(meta_gm.GetValue(c * 4u + 2u));
                    if (L > 0u) {
                        valid = true;
                        elems = L * KDA_D;
                        m_off = (static_cast<uint64_t>(c) * H + h) * 4096ULL;
                    }
                }

            // Phase 0 (overlapped with AIC Phase 1a!):
            //   Keep q_f (dq_acc slot) & k_f (dk_neg_acc slot) FP32-resident in UB across ALL of Phase 0..0.5!
            //   Write kg0_bf_ws = bf16(-k_hat * exp(gk)) and wake AIC Phase 1b immediately!
            if (valid) {
                uint64_t gl_off = (static_cast<uint64_t>(c) * H + h) * KDA_D;
                AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
                kda_copy_tnd_in_f32(g_f, gk_gm, t0, L, h, H);
                AscendC::DataCopy(g_last_f, g_last_gm[gl_off], KDA_D);
                AscendC::DataCopy(dgk_last, dgk_last_in_gm[gl_off], KDA_D);
                kda_copy_ht_in_f32(beta_f, beta_gm, h, t0, L, p.total_tokens);
                kda_copy_tnd_in_bf16(io_bf16, q_hat_gm, t0, L, h, H);
                AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
                AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE3>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE3>(EVENT_ID0);
                AscendC::DataCopy(sl.q_hat_ws, io_bf16, elems);
                AscendC::Cast(dq_acc, io_bf16, AscendC::RoundMode::CAST_NONE, elems);  // q_f resident in UB[0..32K)!
                AscendC::Duplicate(db_acc, 0.0f, KDA_BT);
                AscendC::Exp(tmp_f, g_f, elems);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::SetFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID0);
                AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);

                kda_copy_tnd_in_bf16(io_bf16, k_hat_gm, t0, L, h, H);
                AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
                AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE3>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE3>(EVENT_ID0);
                AscendC::DataCopy(sl.k_hat_ws, io_bf16, elems);
                AscendC::Cast(dk_neg_acc, io_bf16, AscendC::RoundMode::CAST_NONE, elems);  // k_f resident in UB[32K..64K)!
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Mul(tmp_f, dk_neg_acc, tmp_f, elems);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Muls(tmp_f, tmp_f, -1.0f, elems);  // -k_hat * exp(gk) so dA = dv@v^T + dw_bf@kg0_bf^T!
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
                AscendC::Cast(io_bf16, tmp_f, AscendC::RoundMode::CAST_RINT, elems);
                AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
                AscendC::DataCopy(sl.kg0_bf_ws, io_bf16, elems);
                AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
            }
            Arch::CrossCoreSetFlag<0x2, PIPE_MTE3>(flag_kg0_ready);

            // Phase 0.5 (100% OVERLAPPED with AIC Phase 1a/1b, PLUS full AIV VEC||MTE3 ping-pong!):
            //   q_f (dq_acc) & k_f (dk_neg_acc) & g_f are ALL hot in FP32 UB -> ZERO k_hat/q_hat/es/er GM re-reads,
            //   ZERO extra casts, and 2-stage ping-pong hiding 328 KiB/slot (1.34 GB!) of MTE3 behind VEC!
            if (valid) {
                if (L > 16u) {
                    uint32_t pp = 0u;
                    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
                    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID1);
                    for (uint32_t sr = 1u; sr <= 3u; ++sr) {
                        uint32_t r0 = sr * 16u;
                        if (r0 >= L) break;
                        uint32_t kp_off = (sr == 1u) ? 0u : ((sr == 2u) ? (16u * KDA_D) : (48u * KDA_D));
                        for (uint32_t rr = 0u; rr < r0; rr += 16u) {
                            uint32_t cnt = 16u * KDA_D;
                            uint32_t boff = pp * 4096u;
                            AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(pp);
                            kda_rsub_vec128_rows(tmp_f[boff], g_f[r0 * KDA_D], g_f[rr * KDA_D], 16u);
                            AscendC::Exp(tmp_f[boff], tmp_f[boff], cnt);
                            AscendC::PipeBarrier<PIPE_V>();
                            AscendC::Mul(tmp_f[boff + 2048u], dk_neg_acc[rr * KDA_D], tmp_f[boff], cnt);
                            AscendC::PipeBarrier<PIPE_V>();
                            AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(pp);
                            AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(pp);
                            AscendC::DataCopy(sl.off_er_col[kp_off + rr * KDA_D], tmp_f[boff], cnt);
                            AscendC::DataCopy(sl.off_k_f32[kp_off + rr * KDA_D], tmp_f[boff + 2048u], cnt);
                            AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(pp);
                            pp ^= 1u;
                        }
                    }
                    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID1);
                }

                // Diag 4x16x16: 2x40 KiB ping-pong (tmp_f+io_f[0] vs dk_pos_acc+io_f[2048]) -> MTE3 100% hidden behind VEC!
                {
                    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
                    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID1);
                    for (uint32_t d = 0u; d < 4u; ++d) {
                        uint32_t s_base = d * 16u;
                        if (s_base + 1u >= L) break;
                        uint32_t s_len = (L - s_base < 16u) ? (L - s_base) : 16u;
                        uint32_t m = s_base + (s_len >> 1);
                        uint32_t cnt = s_len * KDA_D;
                        uint32_t pp = d & 1u;
                        auto& b4 = (pp == 0u) ? tmp_f : dk_pos_acc;
                        uint32_t q_off = pp * 2048u;

                        AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(pp);
                        kda_rsub_vec128_rows(b4[0], g_f[m * KDA_D], g_f[s_base * KDA_D], s_len);
                        AscendC::Exp(b4[0], b4[0], cnt);
                        kda_sub_vec128_rows(b4[4096], g_f[s_base * KDA_D], g_f[m * KDA_D], s_len);
                        AscendC::Exp(b4[4096], b4[4096], cnt);
                        AscendC::PipeBarrier<PIPE_V>();

                        AscendC::Mul(b4[2048], dk_neg_acc[s_base * KDA_D], b4[0], cnt);
                        AscendC::Mul(b4[6144], dk_neg_acc[s_base * KDA_D], b4[4096], cnt);
                        AscendC::Mul(io_f[q_off], dq_acc[s_base * KDA_D], b4[4096], cnt);
                        AscendC::PipeBarrier<PIPE_V>();
                        kda_mul_row_vec_128(b4[6144], beta_f[s_base], brc_512, s_len);
                        if (s_len < 16u) {
                            uint32_t pad = (16u - s_len) * KDA_D;
                            AscendC::Duplicate(b4[2048 + cnt], 0.0f, pad);
                            AscendC::Duplicate(b4[6144 + cnt], 0.0f, pad);
                            AscendC::Duplicate(io_f[q_off + cnt], 0.0f, pad);
                            AscendC::PipeBarrier<PIPE_V>();
                        }
                        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(pp);
                        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(pp);
                        AscendC::DataCopy(sl.diag_er_ws[s_base * KDA_D], b4[0], cnt);
                        AscendC::DataCopy(sl.diag_ki_f32[s_base * KDA_D], b4[2048], 16u * KDA_D);
                        AscendC::DataCopy(sl.diag_es_ws[s_base * KDA_D], b4[4096], cnt);
                        AscendC::DataCopy(sl.diag_qkb_f32[(d * 32u + 16u) * KDA_D], b4[6144], 16u * KDA_D);
                        AscendC::DataCopy(sl.diag_qkb_f32[d * 32u * KDA_D], io_f[q_off], 16u * KDA_D);
                        AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(pp);
                    }
                    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID1);
                }

                // Off-diag rows: 2x24 KiB ping-pong (tmp_f vs dk_pos_acc) -> MTE3 100% hidden behind VEC!
                if (L > 16u) {
                    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
                    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID1);
                    for (uint32_t sr = 1u; sr <= 3u; ++sr) {
                        uint32_t r0 = sr * 16u;
                        if (r0 >= L) break;
                        uint32_t nr = (L - r0 < 16u) ? (L - r0) : 16u;
                        uint32_t cnt = nr * KDA_D;
                        uint32_t pp = sr & 1u;
                        auto& b3 = (pp == 0u) ? tmp_f : dk_pos_acc;

                        AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(pp);
                        kda_sub_vec128_rows(b3[0], g_f[r0 * KDA_D], g_f[r0 * KDA_D], nr);
                        AscendC::Exp(b3[0], b3[0], cnt);
                        AscendC::PipeBarrier<PIPE_V>();
                        AscendC::Mul(b3[2048], dk_neg_acc[r0 * KDA_D], b3[0], cnt);
                        AscendC::Mul(b3[4096], dq_acc[r0 * KDA_D], b3[0], cnt);
                        AscendC::PipeBarrier<PIPE_V>();
                        kda_mul_row_vec_128(b3[2048], beta_f[r0], brc_512, nr);
                        if (nr < 16u) {
                            uint32_t pad = (16u - nr) * KDA_D;
                            AscendC::Duplicate(b3[2048 + cnt], 0.0f, pad);
                            AscendC::Duplicate(b3[4096 + cnt], 0.0f, pad);
                            AscendC::PipeBarrier<PIPE_V>();
                        }
                        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(pp);
                        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(pp);
                        AscendC::DataCopy(sl.off_er_row[(sr - 1u) * 16u * KDA_D], b3[0], cnt);
                        AscendC::DataCopy(sl.off_q_f32[((sr - 1u) * 32u + 16u) * KDA_D], b3[2048], 16u * KDA_D);
                        AscendC::DataCopy(sl.off_q_f32[(sr - 1u) * 32u * KDA_D], b3[4096], 16u * KDA_D);
                        AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(pp);
                    }
                    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID1);
                }
            }

            // Phase 1 Sync -> mask tril(dA * beta_col, -1) -> wake AIC Phase 2 (dAkk) IMMEDIATELY!
            Arch::CrossCoreWaitFlag(flag_p1_ready);
            if (valid) {
                for (uint32_t s = 0u; s < 4u; ++s) {
                    uint32_t r0 = s * 16u;
                    AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
                    AscendC::DataCopy(mat_f, sl.da_ws[r0 * KDA_BT], 16u * KDA_BT);
                    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
                    AscendC::Mul(mat_f, mat_f, beta_f, 64, 16, AscendC::BinaryRepeatParams(1, 1, 1, 8, 8, 0));
                    AscendC::PipeBarrier<PIPE_V>();
                    AscendC::Mul(mat_f[s * 16u], mat_f[s * 16u], tril16_strict, 16, 16,
                                 AscendC::BinaryRepeatParams(1, 1, 1, 8, 8, 2));
                    if (s < 3u) {
                        AscendC::Duplicate(mat_f[(s + 1u) * 16u], 0.0f, (3u - s) * 16u, 16, 1, 8);
                    }
                    AscendC::PipeBarrier<PIPE_V>();
                    if (r0 + 16u > L) {
                        uint32_t keep = (L > r0) ? (L - r0) : 0u;
                        AscendC::Duplicate(mat_f[keep * KDA_BT], 0.0f, (16u - keep) * KDA_BT);
                        AscendC::PipeBarrier<PIPE_V>();
                    }
                    AscendC::Cast(io_bf16, mat_f, AscendC::RoundMode::CAST_RINT, 16u * KDA_BT);
                    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
                    AscendC::DataCopy(sl.da_bf_ws[r0 * KDA_BT], io_bf16, 16u * KDA_BT);
                    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
                }
            }
            Arch::CrossCoreSetFlag<0x2, PIPE_MTE3>(flag_da_ready);

            // Phase 2 AIV (100% OVERLAPPED with AIC Phase 2 dAkk!):
            //   - dv_out & initial db_acc from sl.dvb_ws & v_gm
            //   - Extract rstd_f & pack top-16 rows of dAqk into packed_m_diag & packed_m_off (FP32)
            //   - Spill ONLY tiny 1.75 KiB save_vecs (ZERO 96 KiB matrix spill!)
            if (valid) {
                AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
                AscendC::DataCopy(dq_acc, sl.dvb_ws, elems);
                kda_copy_tnd_in_bf16(io_bf16, v_gm, t0, L, h, H);
                AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
                AscendC::Cast(tmp_f, io_bf16, AscendC::RoundMode::CAST_NONE, elems);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Mul(tmp_f, dq_acc, tmp_f, elems);
                AscendC::PipeBarrier<PIPE_V>();
                kda_rowsum_128(row_dot, tmp_f, red_part, L);
                AscendC::Add(db_acc, db_acc, row_dot, kda_align_up(L, 8u));
                AscendC::PipeBarrier<PIPE_V>();
                kda_mul_row_vec_128(dq_acc, beta_f, brc_512, L);
                AscendC::Cast(io_bf16, dq_acc, AscendC::RoundMode::CAST_RINT, elems);
                AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
                kda_copy_tnd_out_bf16(dv_out_gm, io_bf16, t0, L, h, H);
                AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);

                AscendC::Duplicate(rstd_f, 0.0f, KDA_BT);
                AscendC::PipeBarrier<PIPE_V>();
                for (uint32_t s = 0u; s < 4u; ++s) {
                    uint32_t r0 = s * 16u;
                    if (r0 >= L) break;
                    uint32_t nr = (L - r0 < 16u) ? (L - r0) : 16u;
                    AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
                    AscendC::DataCopy(mat_f, daqk_gm[m_off + r0 * KDA_BT], 16u * KDA_BT);
                    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
                    AscendC::SetFlag<AscendC::HardEvent::V_S>(EVENT_ID1);
                    AscendC::WaitFlag<AscendC::HardEvent::V_S>(EVENT_ID1);
                    for (uint32_t r = 0u; r < nr; ++r) {
                        uint32_t d_idx = r * KDA_BT + r0 + r;
                        rstd_f.SetValue(r0 + r, mat_f.GetValue(d_idx));
                        mat_f.SetValue(d_idx, 0.0f);
                    }
                    AscendC::SetFlag<AscendC::HardEvent::S_MTE3>(EVENT_ID1);
                    AscendC::WaitFlag<AscendC::HardEvent::S_MTE3>(EVENT_ID1);
                    if (nr > 1u) {
                        AscendC::DataCopy(sl.packed_m_diag[s * 512u], mat_f[r0], AscendC::DataCopyParams{16, 2, 6, 0});
                    }
                    if (s >= 1u) {
                        uint32_t m_off_sr = (s == 1u) ? 0u : ((s == 2u) ? 512u : 1536u);
                        uint16_t blk_len = static_cast<uint16_t>(r0 / 8u);
                        uint16_t src_str = static_cast<uint16_t>(8u - blk_len);
                        AscendC::DataCopy(sl.packed_m_off[m_off_sr], mat_f[0], AscendC::DataCopyParams{16, blk_len, src_str, 0});
                    }
                    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
                }

                if (p_cnt > 1u) {
                    AscendC::SetFlag<AscendC::HardEvent::S_MTE3>(EVENT_ID1);
                    AscendC::WaitFlag<AscendC::HardEvent::S_MTE3>(EVENT_ID1);
                    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
                    AscendC::DataCopy(sl.save_vecs[0], beta_f, 64u);
                    AscendC::DataCopy(sl.save_vecs[64], rstd_f, 64u);
                    AscendC::DataCopy(sl.save_vecs[128], db_acc, 64u);
                    AscendC::DataCopy(sl.save_vecs[192], dgk_last, 128u);
                    AscendC::DataCopy(sl.save_vecs[320], g_last_f, 128u);
                    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
                }
            }

            // Phase 3 Sync -> negate & strict-tril mask dAkk -> pack bottom-16 rows (FP32) -> wake AIC Phase 3!
            Arch::CrossCoreWaitFlag(flag_dakk_ready);
            if (valid) {
                for (uint32_t s = 0u; s < 4u; ++s) {
                    uint32_t r0 = s * 16u;
                    if (r0 >= L) break;
                    uint32_t nr = (L - r0 < 16u) ? (L - r0) : 16u;
                    AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
                    AscendC::DataCopy(mat_f, sl.da_ws[r0 * KDA_BT], 16u * KDA_BT);
                    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
                    AscendC::Muls(mat_f, mat_f, -1.0f, 16u * KDA_BT);
                    AscendC::PipeBarrier<PIPE_V>();
                    AscendC::Mul(mat_f[s * 16u], mat_f[s * 16u], tril16_strict, 16, 16,
                                 AscendC::BinaryRepeatParams(1, 1, 1, 8, 8, 2));
                    if (s < 3u) {
                        AscendC::Duplicate(mat_f[(s + 1u) * 16u], 0.0f, (3u - s) * 16u, 16, 1, 8);
                    }
                    AscendC::PipeBarrier<PIPE_V>();
                    if (r0 + 16u > L) {
                        uint32_t keep = (L > r0) ? (L - r0) : 0u;
                        AscendC::Duplicate(mat_f[keep * KDA_BT], 0.0f, (16u - keep) * KDA_BT);
                        AscendC::PipeBarrier<PIPE_V>();
                    }
                    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
                    if (nr > 1u) {
                        AscendC::DataCopy(sl.packed_m_diag[s * 512u + 256u], mat_f[r0], AscendC::DataCopyParams{16, 2, 6, 0});
                    }
                    if (s >= 1u) {
                        uint32_t m_off_sr = (s == 1u) ? 0u : ((s == 2u) ? 512u : 1536u);
                        uint16_t blk_len = static_cast<uint16_t>(r0 / 8u);
                        uint16_t src_str = static_cast<uint16_t>(8u - blk_len);
                        AscendC::DataCopy(sl.packed_m_off[m_off_sr + 16u * r0], mat_f[0],
                                          AscendC::DataCopyParams{16, blk_len, src_str, 0});
                    }
                    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
                }
            }
            // Wake AIC Phase 3(iter, ep) IMMEDIATELY (ZERO 96 KiB spill!)
            Arch::CrossCoreSetFlag<0x2, PIPE_MTE3>(flag_intra_ready);
            }  // end if (iter < p_cnt)

            // Software-pipelined Merge + Consolidated Epilogue on (iter - 1, slot[(iter-1)&1])!
            // Runs 100% IN PARALLEL with AIC Phase 4(iter) + early-releases flag_ep_done so AIC Phase 1(iter+1)
            // ALSO overlaps with L2Norm Q/K + Reverse Cumsum + Gate Backward!
            if (iter >= 1u) {
                Arch::CrossCoreWaitFlag(flag_p4_ready);
                SlotGm& sp = sl_arr[(iter - 1u) & 1u];
                const bool reload_from_ws = (p_cnt > 1u);
                if (prev_valid) {
                    const uint32_t sp_h = prev_h;
                    const uint32_t sp_t0 = prev_t0;
                    const uint32_t sp_L = prev_L;
                    const uint32_t sp_elems = sp_L * KDA_D;
                    if (sp_h != cached_h) {
                        kda_flush_head_accum(cached_h, vid, H, dalog_acc, row_dot, ddtb_acc, dalog_part_gm, ddtb_part_gm);
                        cached_h = sp_h;
                        dalog_acc = 0.0f;
                        AscendC::Duplicate(ddtb_acc, 0.0f, KDA_D);
                        float al = alog_gm.GetValue(sp_h);
                        row_dot.SetValue(0, al);
                        AscendC::SetFlag<AscendC::HardEvent::S_V>(EVENT_ID0);
                        AscendC::WaitFlag<AscendC::HardEvent::S_V>(EVENT_ID0);
                        AscendC::Exp(row_dot, row_dot, 8);
                        AscendC::SetFlag<AscendC::HardEvent::V_S>(EVENT_ID0);
                        AscendC::WaitFlag<AscendC::HardEvent::V_S>(EVENT_ID0);
                        cached_a_exp = row_dot.GetValue(0);
                        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID1);
                        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID1);
                        AscendC::DataCopy(dt_bias_f, dtb_gm[static_cast<uint64_t>(sp_h) * KDA_D], KDA_D);
                        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID1);
                        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID1);
                    }

                    // Load tiny 1.75 KiB save_vecs (when p_cnt > 1) + 4-tensor inter-chunk MTE2 burst (ZERO 96 KiB spill/reload!)
                    AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
                    if (reload_from_ws) {
                        AscendC::DataCopy(beta_f, sp.save_vecs[0], 64u);
                        AscendC::DataCopy(rstd_f, sp.save_vecs[64], 64u);
                        AscendC::DataCopy(db_acc, sp.save_vecs[128], 64u);
                        AscendC::DataCopy(dgk_last, sp.save_vecs[192], 128u);
                        AscendC::DataCopy(g_last_f, sp.save_vecs[320], 128u);
                    }
                    kda_copy_tnd_in_f32(g_f, gk_gm, sp_t0, sp_L, sp_h, H);
                    AscendC::DataCopy(dq_acc, sp.dq_ws, sp_elems);
                    AscendC::DataCopy(dk_neg_acc, sp.dk_ws, sp_elems);
                    AscendC::DataCopy(dk_pos_acc, sp.dkgb_ws, sp_elems);
                    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

                    // Compute inter-chunk dq_acc, dk_pos_acc, dk_neg_acc directly here!
                    AscendC::Exp(tmp_f, g_f, sp_elems);
                    AscendC::PipeBarrier<PIPE_V>();
                    AscendC::Mul(dq_acc, dq_acc, tmp_f, sp_elems);
                    AscendC::Mul(dk_pos_acc, dk_pos_acc, tmp_f, sp_elems);
                    AscendC::PipeBarrier<PIPE_V>();
                    AscendC::Muls(dq_acc, dq_acc, p.scale, sp_elems);
                    AscendC::Muls(dk_pos_acc, dk_pos_acc, -1.0f, sp_elems);  // dkgb_ws = +Akk_inv^T @ dw_bf -> negate!

                    for (uint32_t r0 = 0u; r0 < sp_L; r0 += 32u) {
                        uint32_t nr = (sp_L - r0 < 32u) ? (sp_L - r0) : 32u;
                        uint32_t cnt = nr * KDA_D;
                        kda_rsub_vec128_rows(io_f, g_last_f, g_f[r0 * KDA_D], nr);
                        AscendC::Exp(io_f, io_f, cnt);
                        AscendC::PipeBarrier<PIPE_V>();
                        AscendC::Mul(dk_neg_acc[r0 * KDA_D], dk_neg_acc[r0 * KDA_D], io_f, cnt);
                        AscendC::PipeBarrier<PIPE_V>();
                    }

                    // g_f is now dead -> load k_hat_ws ONCE into g_f for BOTH dgk_last AND Epilogue!
                    AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
                    AscendC::DataCopy(io_bf16, sp.k_hat_ws, sp_elems);
                    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
                    AscendC::Cast(g_f, io_bf16, AscendC::RoundMode::CAST_NONE, sp_elems);
                    AscendC::PipeBarrier<PIPE_V>();
                    AscendC::Mul(tmp_f, g_f, dk_neg_acc, sp_elems);
                    AscendC::PipeBarrier<PIPE_V>();
                    kda_colsum_add_128(dgk_last, tmp_f, sp_L);

                    // 4a. Merge 4x16x16 Diag Cube outputs (packed [32, 128] in sp.diag_row_out, col in sp.diag_col_out!)
                    for (uint32_t d = 0u; d < 4u; ++d) {
                        uint32_t s_base = d * 16u;
                        if (s_base + 1u >= sp_L) break;
                        uint32_t s_len = (sp_L - s_base < 16u) ? (sp_L - s_base) : 16u;
                        uint32_t cnt = s_len * KDA_D;
                        uint32_t off = s_base * KDA_D;
                        uint32_t row_off = d * 32u * KDA_D;
                        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
                        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
                        AscendC::DataCopy(tmp_f[0], sp.diag_es_ws[off], cnt);
                        AscendC::DataCopy(tmp_f[2048], sp.diag_row_out[row_off], cnt);                  // diag_dq
                        AscendC::DataCopy(tmp_f[4096], sp.diag_row_out[row_off + 16u * KDA_D], cnt);    // diag_dkr
                        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
                        AscendC::DataCopy(tmp_f[6144], sp.diag_er_ws[off], cnt);
                        AscendC::DataCopy(io_f[0], sp.diag_col_out[off], cnt);                          // diag_dkc
                        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID1);
                        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
                        AscendC::Mul(tmp_f[2048], tmp_f[2048], tmp_f[0], cnt);
                        AscendC::Mul(tmp_f[4096], tmp_f[4096], tmp_f[0], cnt);
                        AscendC::PipeBarrier<PIPE_V>();
                        AscendC::Add(dq_acc[off], dq_acc[off], tmp_f[2048], cnt);
                        AscendC::Add(dk_pos_acc[off], dk_pos_acc[off], tmp_f[4096], cnt);
                        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID1);
                        AscendC::Mul(io_f[0], io_f[0], tmp_f[6144], cnt);
                        AscendC::PipeBarrier<PIPE_V>();
                        AscendC::Add(dk_neg_acc[off], dk_neg_acc[off], io_f[0], cnt);
                        AscendC::PipeBarrier<PIPE_V>();
                    }

                    // 4b. Merge Off-Diag Cube outputs with MTE2||VEC overlap (prefetch c0=0 col while computing row!)
                    if (sp_L > 16u) {
                        for (uint32_t sr = 1u; sr <= 3u; ++sr) {
                            uint32_t r0 = sr * 16u;
                            if (r0 >= sp_L) break;
                            uint32_t nr = (sp_L - r0 < 16u) ? (sp_L - r0) : 16u;
                            uint32_t cnt = nr * KDA_D;
                            uint32_t er_off = (sr - 1u) * 16u * KDA_D;
                            uint32_t row_off = (sr - 1u) * 32u * KDA_D;
                            uint32_t kp_off = (sr == 1u) ? 0u : ((sr == 2u) ? (16u * KDA_D) : (48u * KDA_D));

                            AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
                            AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
                            AscendC::DataCopy(tmp_f[0], sp.off_er_row[er_off], cnt);
                            AscendC::DataCopy(tmp_f[2048], sp.off_row_out[row_off], cnt);                 // off_dq
                            AscendC::DataCopy(tmp_f[4096], sp.off_row_out[row_off + 16u * KDA_D], cnt);   // off_dkr
                            AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
                            // Prefetch first 16 col rows (io_f[0..4095]) IN PARALLEL with row-side VEC!
                            AscendC::DataCopy(io_f[0], sp.off_er_col[kp_off], 16u * KDA_D);
                            AscendC::DataCopy(io_f[2048], sp.off_col_ws[kp_off], 16u * KDA_D);
                            AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID1);

                            AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
                            AscendC::Mul(tmp_f[2048], tmp_f[2048], tmp_f[0], cnt);
                            AscendC::Mul(tmp_f[4096], tmp_f[4096], tmp_f[0], cnt);
                            AscendC::PipeBarrier<PIPE_V>();
                            AscendC::Add(dq_acc[r0 * KDA_D], dq_acc[r0 * KDA_D], tmp_f[2048], cnt);
                            AscendC::Add(dk_pos_acc[r0 * KDA_D], dk_pos_acc[r0 * KDA_D], tmp_f[4096], cnt);
                            AscendC::PipeBarrier<PIPE_V>();

                            // If sr >= 2 (r0 > 16), prefetch remaining col rows (16..r0-1) into tmp_f while VEC computes c0=0!
                            if (r0 > 16u) {
                                uint32_t rem_cc = (r0 - 16u) * KDA_D;
                                AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
                                AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
                                AscendC::DataCopy(tmp_f[0], sp.off_er_col[kp_off + 16u * KDA_D], rem_cc);
                                AscendC::DataCopy(tmp_f[4096], sp.off_col_ws[kp_off + 16u * KDA_D], rem_cc);
                                AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
                            }

                            AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID1);
                            AscendC::Mul(io_f[2048], io_f[2048], io_f[0], 16u * KDA_D);
                            AscendC::PipeBarrier<PIPE_V>();
                            AscendC::Add(dk_neg_acc[0], dk_neg_acc[0], io_f[2048], 16u * KDA_D);
                            AscendC::PipeBarrier<PIPE_V>();

                            if (r0 > 16u) {
                                uint32_t rem_cc = (r0 - 16u) * KDA_D;
                                AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
                                AscendC::Mul(tmp_f[4096], tmp_f[4096], tmp_f[0], rem_cc);
                                AscendC::PipeBarrier<PIPE_V>();
                                AscendC::Add(dk_neg_acc[16u * KDA_D], dk_neg_acc[16u * KDA_D], tmp_f[4096], rem_cc);
                                AscendC::PipeBarrier<PIPE_V>();
                            }
                        }
                    }

                    // Consolidated Epilogue (k_hat is ALREADY hot in g_f — ZERO k_hat_ws re-read!)
                    AscendC::Mul(tmp_f, g_f, dk_pos_acc, sp_elems);
                    AscendC::PipeBarrier<PIPE_V>();
                    kda_rowsum_128(row_dot, tmp_f, red_part, sp_L);
                    AscendC::Add(db_acc, db_acc, row_dot, kda_align_up(sp_L, 8u));
                    AscendC::PipeBarrier<PIPE_V>();

                    kda_mul_row_vec_128(dk_pos_acc, beta_f, brc_512, sp_L);
                    AscendC::Sub(dk_pos_acc, dk_pos_acc, dk_neg_acc, sp_elems);
                    AscendC::PipeBarrier<PIPE_V>();
                    AscendC::Muls(dk_neg_acc, dk_neg_acc, 2.0f, sp_elems);
                    AscendC::PipeBarrier<PIPE_V>();
                    AscendC::Add(dk_neg_acc, dk_neg_acc, dk_pos_acc, sp_elems);
                    AscendC::Mul(dk_pos_acc, dk_pos_acc, g_f, sp_elems);
                    AscendC::PipeBarrier<PIPE_V>();
                    AscendC::Add(dk_pos_acc[(sp_L - 1u) * KDA_D], dk_pos_acc[(sp_L - 1u) * KDA_D], dgk_last, KDA_D);
                    AscendC::PipeBarrier<PIPE_V>();

                    AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
                    AscendC::DataCopy(io_bf16, sp.q_hat_ws, sp_elems);
                    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
                    // Last read of slot `sp` is DONE -> early-release flag_ep_done so AIC Phase 1(iter+1) overlaps Epilogue!
                    if (iter + 1u < p_cnt) {
                        Arch::CrossCoreSetFlag<0x2, PIPE_MTE2>(flag_ep_done);
                    }
                    AscendC::Cast(tmp_f, io_bf16, AscendC::RoundMode::CAST_NONE, sp_elems);
                    AscendC::PipeBarrier<PIPE_V>();

                    for (uint32_t r0 = 0u; r0 < sp_L; r0 += 32u) {
                        uint32_t nr = (sp_L - r0 < 32u) ? (sp_L - r0) : 32u;
                        uint32_t cnt = nr * KDA_D;
                        AscendC::Mul(io_f, tmp_f[r0 * KDA_D], dq_acc[r0 * KDA_D], cnt);
                        AscendC::PipeBarrier<PIPE_V>();
                        AscendC::Add(dk_pos_acc[r0 * KDA_D], dk_pos_acc[r0 * KDA_D], io_f, cnt);
                        kda_mul_row_vec_128_out(io_f, g_f[r0 * KDA_D], rstd_f[r0], brc_512, nr);
                        AscendC::Add(dq_acc[r0 * KDA_D], dq_acc[r0 * KDA_D], io_f, cnt);
                        kda_mul_row_vec_128_out(io_f, tmp_f[r0 * KDA_D], rstd_f[r0], brc_512, nr);
                        AscendC::Add(dk_neg_acc[r0 * KDA_D], dk_neg_acc[r0 * KDA_D], io_f, cnt);
                        AscendC::PipeBarrier<PIPE_V>();
                    }

                    // L2Norm backward on Q
                    AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
                    kda_copy_ht_in_f32(rstd_f, qr_gm, sp_h, sp_t0, sp_L, p.total_tokens);
                    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
                    for (uint32_t r0 = 0u; r0 < sp_L; r0 += 32u) {
                        uint32_t nr = (sp_L - r0 < 32u) ? (sp_L - r0) : 32u;
                        AscendC::Mul(io_f, dq_acc[r0 * KDA_D], tmp_f[r0 * KDA_D], nr * KDA_D);
                        AscendC::PipeBarrier<PIPE_V>();
                        kda_rowsum_128(row_dot[r0], io_f, red_part, nr);
                    }
                    kda_mul_row_vec_128(tmp_f, row_dot, brc_512, sp_L);
                    AscendC::Sub(dq_acc, dq_acc, tmp_f, sp_elems);
                    AscendC::PipeBarrier<PIPE_V>();
                    kda_mul_row_vec_128(dq_acc, rstd_f, brc_512, sp_L);
                    AscendC::Cast(io_bf16, dq_acc, AscendC::RoundMode::CAST_RINT, sp_elems);
                    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
                    kda_copy_tnd_out_bf16(dq_out_gm, io_bf16, sp_t0, sp_L, sp_h, H);
                    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID2);  // overlap dq_out MTE3 with L2Norm K!

                    // L2Norm backward on K (runs 100% in parallel with dq_out_gm MTE3!)
                    AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
                    kda_copy_ht_in_f32(rstd_f, kr_gm, sp_h, sp_t0, sp_L, p.total_tokens);
                    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
                    AscendC::Mul(tmp_f, dk_neg_acc, g_f, sp_elems);
                    AscendC::PipeBarrier<PIPE_V>();
                    kda_rowsum_128(row_dot, tmp_f, red_part, sp_L);
                    kda_mul_row_vec_128(g_f, row_dot, brc_512, sp_L);
                    AscendC::Sub(dk_neg_acc, dk_neg_acc, g_f, sp_elems);
                    AscendC::PipeBarrier<PIPE_V>();
                    kda_mul_row_vec_128(dk_neg_acc, rstd_f, brc_512, sp_L);
                    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID2);
                    AscendC::Cast(io_bf16, dk_neg_acc, AscendC::RoundMode::CAST_RINT, sp_elems);
                    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
                    kda_copy_tnd_out_bf16(dk_out_gm, io_bf16, sp_t0, sp_L, sp_h, H);
                    AscendC::SetFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID2);  // overlap dk_out MTE3 with Reverse Cumsum!

                    // Reverse chunk cumsum (ping-pong!) runs 100% in parallel with dk_out_gm MTE3!
                    kda_prefix_sum_rev_64x128(dk_pos_acc, tmp_f, sp_L);

                    AscendC::WaitFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID2);
                    AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
                    kda_copy_tnd_in_bf16(io_bf16, a_gm, sp_t0, sp_L, sp_h, H);
                    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
                    AscendC::Cast(g_f, io_bf16, AscendC::RoundMode::CAST_NONE, sp_elems);
                    AscendC::PipeBarrier<PIPE_V>();
                    kda_add_vec128_rows(g_f, g_f, dt_bias_f, sp_L);
                    AscendC::Muls(tmp_f, g_f, -cached_a_exp, sp_elems);
                    AscendC::PipeBarrier<PIPE_V>();
                    AscendC::Exp(tmp_f, tmp_f, sp_elems);
                    AscendC::PipeBarrier<PIPE_V>();
                    AscendC::Adds(tmp_f, tmp_f, 1.0f, sp_elems);
                    AscendC::PipeBarrier<PIPE_V>();
                    AscendC::Div(tmp_f[0], ones_128[0], tmp_f[0], 64, static_cast<uint8_t>(sp_L),
                                 AscendC::BinaryRepeatParams(1, 1, 1, 16, 0, 16));
                    AscendC::Div(tmp_f[64], ones_128[64], tmp_f[64], 64, static_cast<uint8_t>(sp_L),
                                 AscendC::BinaryRepeatParams(1, 1, 1, 16, 0, 16));
                    AscendC::PipeBarrier<PIPE_V>();
                    AscendC::Mul(dk_pos_acc, dk_pos_acc, tmp_f, sp_elems);
                    AscendC::PipeBarrier<PIPE_V>();
                    AscendC::Muls(tmp_f, tmp_f, -1.0f, sp_elems);
                    AscendC::PipeBarrier<PIPE_V>();
                    AscendC::Adds(tmp_f, tmp_f, 1.0f, sp_elems);
                    AscendC::PipeBarrier<PIPE_V>();
                    AscendC::Mul(dk_pos_acc, dk_pos_acc, tmp_f, sp_elems);
                    AscendC::PipeBarrier<PIPE_V>();
                    AscendC::Muls(dk_pos_acc, dk_pos_acc, p.lower_bound * cached_a_exp, sp_elems);
                    AscendC::PipeBarrier<PIPE_V>();

                    AscendC::Cast(io_bf16, dk_pos_acc, AscendC::RoundMode::CAST_RINT, sp_elems);
                    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
                    kda_copy_tnd_out_bf16(da_out_gm, io_bf16, sp_t0, sp_L, sp_h, H);
                    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID2);  // overlap da_out MTE3 with da_log/ddtb/dbeta!

                    AscendC::Mul(tmp_f, dk_pos_acc, g_f, sp_elems);
                    AscendC::PipeBarrier<PIPE_V>();
                    kda_rowsum_128(row_dot, tmp_f, red_part, sp_L);
                    kda_colsum_add_128(ddtb_acc, dk_pos_acc, sp_L);
                    AscendC::SetFlag<AscendC::HardEvent::V_S>(EVENT_ID1);
                    AscendC::WaitFlag<AscendC::HardEvent::V_S>(EVENT_ID1);
                    for (uint32_t r = 0u; r < sp_L; ++r) {
                        dalog_acc += row_dot.GetValue(r);
                    }

                    uint32_t l_al8 = kda_align_up(sp_L, 8u);
                    AscendC::Mul(db_acc, db_acc, beta_f, l_al8);
                    AscendC::Muls(row_dot, beta_f, -1.0f, l_al8);
                    AscendC::PipeBarrier<PIPE_V>();
                    AscendC::Adds(row_dot, row_dot, 1.0f, l_al8);
                    AscendC::PipeBarrier<PIPE_V>();
                    AscendC::Mul(db_acc, db_acc, row_dot, l_al8);
                    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
                    kda_copy_ht_out_f32(db_out_gm, db_acc, sp_h, sp_t0, sp_L, p.total_tokens);
                    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID2);
                } else {
                    if (iter + 1u < p_cnt) {
                        Arch::CrossCoreSetFlag<0x2, PIPE_MTE2>(flag_ep_done);
                    }
                }
            }

            if (iter < p_cnt) {
                prev_valid = valid;
                prev_h = h;
                prev_t0 = t0;
                prev_L = L;
            }
        }

        kda_flush_head_accum(cached_h, vid, H, dalog_acc, row_dot, ddtb_acc, dalog_part_gm, ddtb_part_gm);
        AscendC::PipeBarrier<PIPE_ALL>();
    }

private:
    Arch::CrossCoreFlag flag_kg0_ready{0};
    Arch::CrossCoreFlag flag_p1_ready{1};
    Arch::CrossCoreFlag flag_ep_done{2};
    Arch::CrossCoreFlag flag_da_ready{3};
    Arch::CrossCoreFlag flag_dakk_ready{4};
    Arch::CrossCoreFlag flag_intra_ready{5};
    Arch::CrossCoreFlag flag_p4_ready{6};
    Arch::Resource<ArchTag> resource;
};
template<class Kernel>
__global__ __aicore__ void kda_mix_entry(typename Kernel::Params params, uint64_t sync_address) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    AscendC::SetSyncBaseAddr(sync_address);
    Kernel kernel;
    kernel(params);
}

}  // namespace

namespace ascend_kda {

size_t kda_fwd_intra_wy_workspace_bytes() {
    return static_cast<size_t>(KdaFwdPrepIntraWyKernel::WS_ZERO_BYTES +
                               KDA_AIC_CORES * KdaFwdPrepIntraWyKernel::WS_PER_CORE_BYTES);
}

size_t kda_fwd_ho_workspace_bytes() {
    return static_cast<size_t>(KdaFwdHOKernel::WS_ZERO_BYTES +
                               KDA_AIC_CORES * KdaFwdHOKernel::WS_PER_CORE_BYTES);
}

size_t kda_bwd_dhu_workspace_bytes() {
    return static_cast<size_t>(KdaBwdDhuKernel::WS_ZERO_BYTES +
                               KDA_AIC_CORES * KdaBwdDhuKernel::WS_PER_CORE_BYTES);
}

size_t kda_bwd_finalize_workspace_bytes() {
    return static_cast<size_t>(KdaBwdFinalizeKernel::WS_ZERO_BYTES +
                               KDA_AIC_CORES * KdaBwdFinalizeKernel::WS_PER_CORE_BYTES);
}

void launch_kda_fwd_prep(const KdaFwdPrepHostParams& hp, void* stream) {
    KdaPrepParams p{
        hp.total_tokens, hp.heads, hp.num_chunks, hp.scale, hp.lower_bound, hp.eps,
        hp.q_raw, hp.k_raw, hp.v_raw, hp.a_raw, hp.beta_raw, hp.a_log, hp.dt_bias, hp.chunk_meta,
        hp.q_hat, hp.k_hat, hp.q_rstd, hp.k_rstd, hp.beta_eff, hp.gk, hp.g_last,
        hp.qg, hp.kg, hp.k_beta_g, hp.v_beta, hp.aqk_diag, hp.akk_diag
    };
    kda_fwd_prep_aiv_kernel<<<KDA_AIV_CORES, nullptr, stream>>>(p);
}

void launch_kda_fwd_prep_intra_wy(
    const KdaFwdPrepIntraWyHostParams& hp, uint64_t sync_address, void* stream) {
    KdaFwdPrepIntraWyKernel::Params p{
        hp.total_tokens, hp.heads, hp.num_chunks, hp.scale, hp.lower_bound, hp.eps,
        hp.q_raw, hp.k_raw, hp.v_raw, hp.a_raw, hp.beta_raw, hp.a_log, hp.dt_bias, hp.chunk_meta,
        hp.q_hat, hp.k_hat, hp.q_rstd, hp.k_rstd, hp.beta_eff, hp.gk, hp.g_last,
        hp.qg, hp.kg, hp.aqk_out, hp.akk_inv_out, hp.w_out, hp.u_out, hp.workspace
    };
    kda_mix_entry<KdaFwdPrepIntraWyKernel><<<KDA_AIC_CORES, nullptr, stream>>>(p, sync_address);
}


void launch_kda_fwd_ho(
    uint32_t total_tokens, uint32_t heads, uint32_t num_docs, uint32_t save_states, float scale,
    const void* doc_chunks, const void* chunk_meta,
    const void* w, const void* u, const void* qg, const void* kg, const void* aqk, const void* g_last,
    void* o_out, void* v_new_out, void* h_out,
    void* workspace, uint64_t sync_address, void* stream) {
    KdaFwdHOKernel::Params p{
        total_tokens, heads, num_docs, save_states, scale,
        reinterpret_cast<uint64_t>(const_cast<void*>(doc_chunks)),
        reinterpret_cast<uint64_t>(const_cast<void*>(chunk_meta)),
        reinterpret_cast<uint64_t>(const_cast<void*>(w)),
        reinterpret_cast<uint64_t>(const_cast<void*>(u)),
        reinterpret_cast<uint64_t>(const_cast<void*>(qg)),
        reinterpret_cast<uint64_t>(const_cast<void*>(kg)),
        reinterpret_cast<uint64_t>(const_cast<void*>(aqk)),
        reinterpret_cast<uint64_t>(const_cast<void*>(g_last)),
        reinterpret_cast<uint64_t>(o_out),
        reinterpret_cast<uint64_t>(v_new_out),
        reinterpret_cast<uint64_t>(h_out),
        reinterpret_cast<uint64_t>(workspace)
    };
    kda_mix_entry<KdaFwdHOKernel><<<KDA_AIC_CORES, nullptr, stream>>>(p, sync_address);
}

void launch_kda_bwd_dhu(
    uint32_t total_tokens, uint32_t heads, uint32_t num_docs, float scale,
    const void* doc_chunks, const void* chunk_meta,
    const void* qg, const void* kg, const void* w, const void* v_new, const void* aqk,
    const void* g_last, const void* do_in, const void* h_in,
    void* dh_out, void* dv_out, void* daqk_out, void* dgk_last_out,
    void* workspace, uint64_t sync_address, void* stream) {
    KdaBwdDhuKernel::Params p{
        total_tokens, heads, num_docs, scale,
        reinterpret_cast<uint64_t>(const_cast<void*>(doc_chunks)),
        reinterpret_cast<uint64_t>(const_cast<void*>(chunk_meta)),
        reinterpret_cast<uint64_t>(const_cast<void*>(qg)),
        reinterpret_cast<uint64_t>(const_cast<void*>(kg)),
        reinterpret_cast<uint64_t>(const_cast<void*>(w)),
        reinterpret_cast<uint64_t>(const_cast<void*>(v_new)),
        reinterpret_cast<uint64_t>(const_cast<void*>(aqk)),
        reinterpret_cast<uint64_t>(const_cast<void*>(g_last)),
        reinterpret_cast<uint64_t>(const_cast<void*>(do_in)),
        reinterpret_cast<uint64_t>(const_cast<void*>(h_in)),
        reinterpret_cast<uint64_t>(dh_out),
        reinterpret_cast<uint64_t>(dv_out),
        reinterpret_cast<uint64_t>(daqk_out),
        reinterpret_cast<uint64_t>(dgk_last_out),
        reinterpret_cast<uint64_t>(workspace)
    };
    kda_mix_entry<KdaBwdDhuKernel><<<KDA_AIC_CORES, nullptr, stream>>>(p, sync_address);
}

void launch_kda_bwd_finalize(const KdaBwdFinHostParams& hp, uint64_t sync_address, void* stream) {
    KdaBwdFinalizeKernel::Params p{
        hp.total_tokens, hp.heads, hp.num_chunks, hp.scale, hp.lower_bound,
        hp.chunk_meta, hp.q_hat, hp.k_hat, hp.v_raw, hp.v_new, hp.a_raw,
        hp.gk, hp.g_last, hp.beta_eff, hp.q_rstd, hp.k_rstd, hp.a_log, hp.dt_bias,
        hp.akk_inv, hp.h, hp.dh, hp.do_in, hp.dv_in, hp.daqk_in, hp.dgk_last_in,
        hp.dq_out, hp.dk_out, hp.dv_out, hp.da_out, hp.dbeta_out,
        hp.da_log_part, hp.ddt_bias_part, hp.workspace
    };
    kda_mix_entry<KdaBwdFinalizeKernel><<<KDA_AIC_CORES, nullptr, stream>>>(p, sync_address);
}

}  // namespace ascend_kda
